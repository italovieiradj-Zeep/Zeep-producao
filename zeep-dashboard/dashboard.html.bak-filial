<script>
/* ============ ADICIONAR MÚSICAS DENTRO DAS PLAYLISTS ============ */

/* ---- Fonte de músicas: prefere a biblioteca do backend, senão db.tracks ---- */
function zeepFonteMusicas() {
  var lista = [];
  try {
    if (window.bibliotecaTracks && Array.isArray(window.bibliotecaTracks) && window.bibliotecaTracks.length) return window.bibliotecaTracks;
    if (window.db && Array.isArray(window.db.tracks)) {
      for (var i = 0; i < window.db.tracks.length; i++) {
        var t = window.db.tracks[i];
        lista.push({
          id: t.id || t.track_id || t.uuid || '',
          title: t.t || t.title || t.name || '',
          artist: t.a || t.artist || '',
          album: t.alb || t.album || '',
          genre: t.g || t.genre || '',
          duration: t.duration || t.dur || '',
          key: t.key || '',
          url: t.url || t.src || t.audioUrl || t.previewUrl || t.streamUrl || ''
        });
      }
    }
  } catch (e) {}
  return lista;
}

</script>
<script>
/* ============================================================
   ZEEP — MÓDULO ÚNICO COMPILADO (todas as funções, sem duplicidades)
   Substitui os 5 blocos zeep anteriores. Mantenha o resto do arquivo.
   ============================================================ */

/* ================= UTILITÁRIOS ================= */
function zeepEsc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function zeepNorm(n){ return String(n==null?'':n).toLowerCase().replace(/\s+/g,' ').trim(); }
function zeepFormatDur(d){ if(!d) return ''; var n=parseInt(d,10); if(isNaN(n)) return String(d); var m=Math.floor(n/60), s=n%60; return m+':'+(s<10?'0':'')+s; }
function zeepAudioUrl(m){
  if(!m) return '';
  if(typeof m === 'string'){
    var titulo = String(m).trim().toLowerCase();
    var fontes = [];
    try {
      if(window.db && window.db.tracks) fontes = fontes.concat(window.db.tracks);
      if(window.db && window.db.bibliotecaZeep) fontes = fontes.concat(window.db.bibliotecaZeep);
      if(typeof zeepFonteMusicas === 'function') fontes = fontes.concat(zeepFonteMusicas() || []);
    } catch(e) {}
    var achado = null;
    for(var i=0;i<fontes.length;i++){
      var t = fontes[i]; if(!t) continue;
      var nome = String(t.title || t.name || t.t || '').trim().toLowerCase();
      if(nome !== titulo) continue;
      achado = t;
      if(t.previewUrl || t.file_url || t.url || t.file) break;
    }
    if(!achado) return '';
    m = achado;
  }
  var u = m.url || m.src || m.audioUrl || m.previewUrl || m.streamUrl || m.file_url || m.file || '';
  if(u && /^http:\/\//i.test(u)) u = 'https://' + u.slice(7);
  if(u) return u;
  if(m.key){ var k=String(m.key); if(/^https?:\/\//i.test(k)) return k; return location.origin+'/'+k.replace(/^\/+/,''); }
  return '';
}

/* ================= FONTE DE MÚSICAS ================= */
function zeepFonteMusicas() {
  var lista = [];
  try {
    if (window.bibliotecaTracks && Array.isArray(window.bibliotecaTracks) && window.bibliotecaTracks.length) return window.bibliotecaTracks;
    if (window.db && Array.isArray(window.db.tracks)) {
      for (var i = 0; i < window.db.tracks.length; i++) {
        var t = window.db.tracks[i];
        lista.push({
          id: t.id || t.track_id || t.uuid || '',
          title: t.t || t.title || t.name || '',
          artist: t.a || t.artist || '',
          album: t.alb || t.album || '',
          genre: t.g || t.genre || '',
          duration: t.duration || t.dur || '',
          key: t.key || '',
          url: t.url || t.src || t.audioUrl || t.previewUrl || t.streamUrl || ''
        });
      }
    }
  } catch (e) {}
  return lista;
}
function zeepAcharPlaylist(tipo, key, nome) {
  var pls = getPlaylists();
  var n = String(nome || '').toLowerCase().trim();
  for (var i = 0; i < pls.length; i++) {
    var p = pls[i];
    if (key && String(p.id || p._key || '') === String(key)) return p;
    if (n && String(p.name || p.titulo || p.title || '').toLowerCase().trim() === n) return p;
  }
  return null;
}

/* ================= PLANOS (Matriz + Filiais) ================= */
function zeepPlanos() {
  return { Standard: {base:279, porFilial:99.90}, Business: {base:599, porFilial:99.90}, Enterprise: {base:799, porFilial:99.90} };
}
function zeepPlanoNome(cliente) {
  var p = (cliente.plano||cliente.plan||'Business').toString().trim().toLowerCase();
  if (p.indexOf('enterprise')>-1) return 'Enterprise';
  if (p.indexOf('standard')>-1) return 'Standard';
  return 'Business';
}
function recalcularValorCliente(cliente) {
  if (!cliente) return 0;
  var plano = zeepPlanoNome(cliente);
  var cfg = zeepPlanos()[plano] || zeepPlanos().Business;
  var nUnidades = (cliente.units && Array.isArray(cliente.units)) ? cliente.units.length : 1;
  var nFiliais = Math.max(0, nUnidades - 1);
  var total = cfg.base + (nFiliais * cfg.porFilial);
  cliente.receitaTotal = Math.round(total*100)/100;
  cliente.valor = cliente.receitaTotal;
  cliente.unidades = nUnidades;
  cliente.nFiliais = nFiliais;
  cliente.planoNome = plano;
  return cliente.receitaTotal;
}

/* ================= CLIENTE ATUAL ================= */
var _clienteAtualId = null;
function getClienteAtual() {
  if (!_clienteAtualId) return null;
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  for (var i=0;i<fontes.length;i++) if (String(fontes[i].id)===String(_clienteAtualId)) return fontes[i];
  return null;
}
function getPlaylistsDoCliente(cliente) {
  if (!cliente) return [];
  if (!Array.isArray(cliente.playlistList)) cliente.playlistList = [];
  return cliente.playlistList;
}

/* ================= SINC. CLIENTE <-> CURADORIA (mesmo objeto) ================= */
function zeepSincronizarCuradoria() {
  try {
    if (!window.db) return;
    if (!Array.isArray(window.db.playlists)) window.db.playlists = [];
    var clientes = [];
    if (Array.isArray(window.db.clients)) clientes = clientes.concat(window.db.clients);
    if (Array.isArray(window.db.clientes)) clientes = clientes.concat(window.db.clientes);
    for (var c=0;c<clientes.length;c++) {
      var cli = clientes[c];
      var pls = getPlaylistsDoCliente(cli);
      for (var p=0;p<pls.length;p++) {
        var pl = pls[p];
        var nome = zeepNorm(pl.titulo||pl.name||pl.title||'');
        if (!nome) continue;
        var achou = false;
        for (var d=0;d<window.db.playlists.length;d++) if (window.db.playlists[d]===pl) { achou=true; break; }
        if (achou) continue;
        var idxSubst = -1;
        for (var d2=0;d2<window.db.playlists.length;d2++) {
          var dp = window.db.playlists[d2];
          if (dp && dp!==pl && zeepNorm(dp.name||dp.titulo||dp.title||'')===nome) { idxSubst=d2; break; }
        }
        if (idxSubst>=0) window.db.playlists[idxSubst]=pl;
        else window.db.playlists.push(pl);
      }
    }
  } catch (e) {}
}
function zeepRefreshLista() {
  if (typeof window.zeepCarregarPlaylists === 'function') return window.zeepCarregarPlaylists();
  if (typeof zeepCarregarPlaylists === 'function') return zeepCarregarPlaylists();
  location.reload();
  return Promise.resolve();
}
/* ================= BUSCA ROBUSTA DE PLAYLIST ================= */
function zeepAcharPlaylist(tipo, key, nome) {
  var n = zeepNorm(nome);
  try {
    if (window.db && Array.isArray(window.db.playlists)) {
      for (var i=0;i<window.db.playlists.length;i++) {
        var p = window.db.playlists[i];
        if (!p) continue;
        var pn = zeepNorm(p.name||p.titulo||p.title||'');
        if ((key!==''&&key!=null&&String(p.id)===String(key)) || (n&&pn===n)) return p;
      }
    }
  } catch (e) {}
  try {
    if (window.db && Array.isArray(window.db.bibliotecaZeep)) {
      for (var j=0;j<window.db.bibliotecaZeep.length;j++) {
        var z = window.db.bibliotecaZeep[j];
        if (!z) continue;
        var zn = zeepNorm(z.titulo||z.name||'');
        if ((key!==''&&key!=null&&String(z._key)===String(key)) || (n&&zn===n)) return z;
      }
    }
  } catch (e2) {}
  try {
    var clientes = [];
    if (window.db) {
      if (Array.isArray(window.db.clients)) clientes = clientes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) clientes = clientes.concat(window.db.clientes);
    }
    for (var c=0;c<clientes.length;c++) {
      var cli = clientes[c];
      var arr = (cli.playlistList&&Array.isArray(cli.playlistList)) ? cli.playlistList : (Array.isArray(cli.playlists)?cli.playlists:null);
      if (!arr) continue;
      for (var q=0;q<arr.length;q++) {
        var pl = arr[q];
        if (!pl) continue;
        var nm = zeepNorm(pl.titulo||pl.name||pl.title||'');
        var ky = pl._key||pl.id||'';
        if ((n&&nm===n) || (key!==''&&key!=null&&String(ky)===String(key))) return pl;
      }
    }
  } catch (e3) {}
  return null;
}

/* ================= PLAYLISTS DO CLIENTE ================= */
function criarPlaylistCliente() {
  var cliente = getClienteAtual();
  if (!cliente) { alert('Selecione um cliente primeiro.'); return; }
  var nome = prompt('Nome da playlist (ex: Zeep @ Almoço):');
  if (!nome || !nome.trim()) return;
  var desc = prompt('Descrição (ex: Lounge e Bossa Nova):','')||'';

  var cid = cliente.id || cliente.company_id || '';
  var body = {
    company_id: cid,
    name: nome.trim(),
    type: 'CURADORIA',          // ← OBRIGATÓRIO
    description: desc
  };

  zeepApi('POST', '/playlists', body).then(function (r) {
    console.log('[ZEEP-API] Playlist criada:', r.playlist ? r.playlist.id : 'ok');
    return zeepRefreshLista();
  }).then(function () {
    renderPlaylistsDoCliente();
    zeepRefresh();
    alert('Playlist "' + nome.trim() + '" criada!');
  }).catch(function (e) {
    alert('Erro ao criar playlist: ' + e.message);
  });
}

function renderPlaylistsDoCliente() {
  var container = document.getElementById('cliente-playlists');
  if (!container) return;
  var cliente = getClienteAtual();
  if (!cliente) { container.innerHTML='<p style="color:var(--text3);font-size:12px;">Nenhum cliente selecionado.</p>'; return; }
  var pls = getPlaylistsDoCliente(cliente);
  var html = '';
  if (!pls.length) {
    html = '<p style="color:var(--text3);font-size:12px;">Nenhuma playlist de curadoria para este cliente.</p>';
  } else {
    for (var j=0;j<pls.length;j++) {
      var p = pls[j];
      var titulo = p.titulo||p.nome||p.name||('Playlist '+(j+1));
      var desc = p.descricao||p.desc||'';
      var inicio = p.inicio||p.timeInicio||'';
      var fim = p.fim||p.timeFim||'';
      var tracks = (p.tracks&&Array.isArray(p.tracks))?p.tracks:[];
      var horario = '';
      if (inicio||fim) horario = 'INICIO '+inicio+' - FIM '+fim;
      html += '<div style="background:var(--navy3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;">';
      html += '<div style="display:flex;justify-content:space-between;align-items:center;">';
      html += '<strong style="color:var(--text);font-size:12px;">'+zeepEsc(titulo)+'</strong>';
      if (horario) html += '<span style="font-size:9px;color:var(--text3);">'+horario+'</span>';
      html += '</div>';
      if (desc) html += '<div style="font-size:10px;color:var(--text2);margin-top:4px;">'+zeepEsc(desc)+'</div>';
      html += '<div style="font-size:10px;color:var(--text3);margin-top:4px;">'+tracks.length+' musica(s)</div>';
      html += '<div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;">';
      html += '<button class="btn btn-ghost btn-sm" data-idx="'+j+'" onclick="editarPlaylistCliente(this)">Editar</button>';
      html += '<button class="btn btn-danger btn-sm" data-idx="'+j+'" onclick="excluirPlaylistCliente(this)">Excluir</button>';
      html += '<button class="btn btn-ghost btn-sm" data-idx="'+j+'" onclick="zeepAbrirModalCliente(this)">+ Adicionar musicas</button>';
      html += '</div></div>';
    }
  }
  container.innerHTML = html;
}

function editarPlaylistCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  var cliente = getClienteAtual();
  if (!cliente) return;
  var pls = getPlaylistsDoCliente(cliente);
  if (!pls[idx]) return;
  var p = pls[idx];
  var nome = prompt('Nome da playlist:', p.titulo || '');
  if (nome === null) return;
  var desc = prompt('Descricao:', p.descricao || '');
  if (desc === null) return;
  var inicio = prompt('Horario inicio:', p.inicio || '');
  if (inicio === null) return;
  var fim = prompt('Horario fim:', p.fim || '');
  if (fim === null) return;

  // ★ FIX v2: usa window.zeepApi (função pode não estar no escopo global)
  var api = (window && window.zeepApi) ? window.zeepApi : null;
  var realId = p._serverId || p.id || p.playlist_id || p.uuid;

  var aplicarLocal = function () {
    p.titulo = nome.trim(); p.descricao = desc; p.inicio = inicio; p.fim = fim;
    try {
      if (window.db && Array.isArray(window.db.playlists)) {
        for (var i = 0; i < window.db.playlists.length; i++) {
          var dp = window.db.playlists[i];
          if (String(dp.clientId) === String(cliente.id) && dp.name === (p.titulo)) {
            dp.name = p.titulo; dp.desc = p.descricao; dp.timeInicio = p.inicio; dp.timeFim = p.fim;
          }
        }
      }
    } catch (e) {}
    renderPlaylistsDoCliente();
    if (typeof renderPlaylistAccordion === 'function') { try { renderPlaylistAccordion(); } catch (e) {} }
  };

  if (realId && api) {
    api('PUT', '/playlists/' + realId, {
      name: nome.trim(),
      description: desc,
      start_time: inicio || null,
      end_time: fim || null
    }).then(function () {
      aplicarLocal();
      alert('Playlist atualizada no Supabase!');
    }).catch(function (err) {
      alert('Erro ao salvar no Supabase: ' + err.message);
    });
    return;
  }

  // fallback: sem id real (playlist local) — só atualiza a tela
  console.warn('[ZEEP] Playlist sem id de servidor — realId:', realId);
  aplicarLocal();
}

function excluirPlaylistCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'),10);
  if (!confirm('Excluir esta playlist?')) return;
  var cliente = getClienteAtual();
  if (!cliente) return;
  var pls = getPlaylistsDoCliente(cliente);
  if (!pls[idx]) return;
  var removida = pls[idx];
  pls.splice(idx,1);
  cliente.playlists = pls.length;
  try {
    if (window.db && Array.isArray(window.db.playlists)) {
      for (var i=window.db.playlists.length-1;i>=0;i--) {
        var dp = window.db.playlists[i];
        if (dp===removida) window.db.playlists.splice(i,1);
        else {
          var nm = zeepNorm(removida.titulo||removida.name||removida.title||'');
          if (nm && zeepNorm(dp.name||dp.titulo||dp.title||'')===nm) window.db.playlists.splice(i,1);
        }
      }
    }
  } catch (e) {}
  renderPlaylistsDoCliente();
  var pc = document.getElementById('vc-playlists');
  if (pc) pc.textContent = String(pls.length);
  zeepRefresh();
}

function abrirNovaUnidade() {
  var cliente = getClienteAtual();
  if (!cliente) { alert('Selecione um cliente primeiro.'); return; }
  var ehMatriz = (cliente.units && cliente.units.length) ? false : true;
  var rotulo = ehMatriz ? 'MATRIZ (unidade principal)' : 'FILIAL (unidade adicional)';
  var nome = prompt('Nome da '+rotulo+' (ex: Jangada Campinas):');
  if (!nome || !nome.trim()) return;
  var endereco = prompt('Endereco da unidade:','')||'';
  var login = prompt('Login (email) para o player:','')||'';
  var senha = prompt('Senha para o player:','')||'';
  if (!cliente.units) cliente.units = [];
  cliente.units.push({ nome: nome.trim(), endereco: endereco, login: login, senha: senha, status: 'Online', tipo: ehMatriz?'matriz':'filial' });
  recalcularValorCliente(cliente);
  renderUnidadesDoCliente();
  zeepRefresh();
  var rc = document.getElementById('vc-receita');
  if (rc) rc.textContent = (typeof formatMoney==='function') ? formatMoney(receitaExibida(cliente)) : ('R$ '+cliente.receitaTotal.toFixed(2).replace('.',','));
  var un = document.getElementById('vc-unidades');
  if (un) un.textContent = String(cliente.units.length);
}

function editarUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'),10);
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units || !cliente.units[idx]) return;
  var u = cliente.units[idx];
  var nome = prompt('Nome da unidade:', u.nome||'');
  if (nome===null) return;
  var endereco = prompt('Endereco:', u.endereco||'');
  if (endereco===null) return;
  var login = prompt('Login (email) para o player:', u.login||'');
  if (login===null) return;
  var senha = prompt('Senha para o player:', u.senha||'');
  if (senha===null) return;
  u.nome=nome.trim(); u.endereco=endereco; u.login=login; u.senha=senha;
  renderUnidadesDoCliente();
}

function excluirUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'),10);
  if (!confirm('Excluir esta unidade?')) return;
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units) return;
  cliente.units.splice(idx,1);
  recalcularValorCliente(cliente);
  renderUnidadesDoCliente();
  zeepRefresh();
  var rc = document.getElementById('vc-receita');
  if (rc) rc.textContent = (typeof formatMoney==='function') ? formatMoney(receitaExibida(cliente)) : ('R$ '+cliente.receitaTotal.toFixed(2).replace('.',','));
  var un = document.getElementById('vc-unidades');
  if (un) un.textContent = String(cliente.units.length);
}

/* ================= MODAL DE MÚSICAS ================= */
var _zeepAlvoPlaylist = null;
var _zeepAudio = null;
var _zeepIdxAtual = -1;
window._zeepPlaylistRefs = window._zeepPlaylistRefs || {};

function zeepGarantirModal() {
  var m = document.getElementById('zeep-modal-musicas');
  if (!m) { m = document.createElement('div'); m.id='zeep-modal-musicas'; m.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,0.85);display:none;align-items:center;justify-content:center;z-index:2000;padding:20px;'; document.body.appendChild(m); }
  m.innerHTML =
    '<div style="background:var(--navy2);border:1px solid var(--border);border-radius:16px;width:100%;max-width:840px;max-height:92vh;display:flex;flex-direction:column;">' +
      '<div style="padding:20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">' +
        '<h3 id="zeep-modal-titulo" style="font-size:16px;color:var(--text);margin:0;">Adicionar músicas</h3>' +
        '<button onclick="zeepFecharModal()" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:22px;line-height:1;">&times;</button>' +
      '</div>' +
      '<div style="padding:16px 20px;border-bottom:1px solid var(--border);">' +
        '<input type="text" id="zeep-busca-musica" placeholder="Buscar por nome da musica..." oninput="zeepRenderListaMusicas()" style="width:100%;background:var(--navy);border:1px solid var(--border2);padding:10px 14px;border-radius:8px;color:var(--text);outline:none;margin-bottom:10px;">' +
        '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">' +
          '<select id="zeep-filtro-genero" onchange="zeepRenderListaMusicas()" style="background:var(--navy);border:1px solid var(--border2);padding:9px;border-radius:8px;color:var(--text);outline:none;"><option value="">Genero: Todos</option></select>' +
          '<select id="zeep-filtro-artista" onchange="zeepRenderListaMusicas()" style="background:var(--navy);border:1px solid var(--border2);padding:9px;border-radius:8px;color:var(--text);outline:none;"><option value="">Artista: Todos</option></select>' +
          '<select id="zeep-filtro-album" onchange="zeepRenderListaMusicas()" style="background:var(--navy);border:1px solid var(--border2);padding:9px;border-radius:8px;color:var(--text);outline:none;"><option value="">Album: Todos</option></select>' +
        '</div>' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;">' +
          '<label style="font-size:12px;color:var(--text2);cursor:pointer;"><input type="checkbox" id="zeep-marcar-todas" onchange="zeepMarcarTodas()"> Marcar todas</label>' +
          '<span id="zeep-contagem" style="font-size:12px;color:var(--text3);">0 selecionada(s)</span>' +
        '</div>' +
      '</div>' +
      '<div id="zeep-lista-musicas" style="flex:1;overflow-y:auto;padding:10px 20px;"></div>' +
      '<div id="zeep-player-bar" style="display:none;align-items:center;gap:14px;padding:12px 20px;border-top:1px solid var(--border);background:var(--navy3);">' +
        '<button id="zeep-play-toggle" onclick="zeepTogglePreEscuta()" style="background:var(--cyan);border:none;border-radius:50%;width:34px;height:34px;color:var(--navy);cursor:pointer;font-size:13px;flex-shrink:0;">&#9654;</button>' +
        '<div style="flex:1;min-width:0;">' +
          '<div id="zeep-player-nome" style="font-size:12px;color:var(--text);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">-</div>' +
          '<div id="zeep-player-artista" style="font-size:10px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">-</div>' +
        '</div>' +
        '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">' +
          '<span id="zeep-player-tempo" style="font-size:11px;color:var(--text3);">0:00</span>' +
          '<span style="font-size:11px;color:var(--text3);">/</span>' +
          '<span id="zeep-player-duracao" style="font-size:11px;color:var(--text3);">0:00</span>' +
        '</div>' +
      '</div>' +
      '<div style="padding:16px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:10px;">' +
        '<button class="btn btn-ghost" onclick="zeepFecharModal()">Cancelar</button>' +
        '<button class="btn btn-primary" onclick="zeepConfirmarAdicionar()">Adicionar selecionadas</button>' +
      '</div>' +
    '</div>';
}

function zeepAbrirModal(tipo, key, nome, ref) {
  zeepGarantirModal();
  _zeepAlvoPlaylist = { tipo: tipo, key: key, nome: nome, ref: ref || null };
  document.getElementById('zeep-modal-titulo').textContent = 'Adicionar músicas' + (nome ? ' - ' + nome : '');
  document.getElementById('zeep-busca-musica').value = '';
  document.getElementById('zeep-marcar-todas').checked = false;
  zeepPreencherFiltros(zeepFonteMusicas());
  zeepRenderListaMusicas();
  document.getElementById('zeep-modal-musicas').style.display = 'flex';
}

function zeepFecharModal() {
  var m = document.getElementById('zeep-modal-musicas');
  if (m) m.style.display = 'none';
  if (_zeepAudio) { try { _zeepAudio.pause(); } catch (e) {} _zeepAudio = null; }
  _zeepIdxAtual = -1;
  _zeepAlvoPlaylist = null;
}

function zeepPreencherFiltros(fonte) {
  var generos = {}, artistas = {}, albuns = {};
  for (var i = 0; i < fonte.length; i++) {
    var t = fonte[i];
    if (t.genre || t.g) generos[t.genre || t.g] = true;
    if (t.artist || t.a) artistas[t.artist || t.a] = true;
    if (t.album || t.alb) albuns[t.album || t.alb] = true;
  }
  var hg = '<option value="">Genero: Todos</option>', ha = '<option value="">Artista: Todos</option>', hb = '<option value="">Album: Todos</option>';
  Object.keys(generos).sort().forEach(function(g) { hg += '<option value="' + zeepEsc(g) + '">' + zeepEsc(g) + '</option>'; });
  Object.keys(artistas).sort().forEach(function(a) { ha += '<option value="' + zeepEsc(a) + '">' + zeepEsc(a) + '</option>'; });
  Object.keys(albuns).sort().forEach(function(al) { hb += '<option value="' + zeepEsc(al) + '">' + zeepEsc(al) + '</option>'; });
  document.getElementById('zeep-filtro-genero').innerHTML = hg;
  document.getElementById('zeep-filtro-artista').innerHTML = ha;
  document.getElementById('zeep-filtro-album').innerHTML = hb;
}

function zeepRenderListaMusicas() {
  var container = document.getElementById('zeep-lista-musicas');
  if (!container) return;
  var q = (document.getElementById('zeep-busca-musica').value || '').toLowerCase();
  var genFiltro = document.getElementById('zeep-filtro-genero').value || '';
  var artFiltro = document.getElementById('zeep-filtro-artista').value || '';
  var albFiltro = document.getElementById('zeep-filtro-album').value || '';
  var fonte = zeepFonteMusicas();
  if (!fonte.length) {
    container.innerHTML = '<p style="color:var(--text3);font-size:13px;text-align:center;padding:30px;">Nenhuma musica na biblioteca. Faca upload na Biblioteca de Musica primeiro.</p>';
    return;
  }
  var html = '';
  for (var i = 0; i < fonte.length; i++) {
    var t = fonte[i];
    var titulo = t.title || t.name || t.t || ('Musica ' + (i + 1));
    var artista = t.artist || t.a || '';
    var album = t.album || t.alb || '';
    var genero = t.genre || t.g || '';
    var dur = zeepFormatDur(t.duration || t.dur);
    var busca = (titulo + ' ' + artista + ' ' + album + ' ' + genero).toLowerCase();
    if (q && busca.indexOf(q) === -1) continue;
    if (genFiltro && genero !== genFiltro) continue;
    if (artFiltro && artista !== artFiltro) continue;
    if (albFiltro && album !== albFiltro) continue;
    html += '<div style="display:flex;align-items:center;gap:10px;padding:10px 8px;border-bottom:1px solid var(--border);">' +
      '<button type="button" class="zeep-pre-escuta" onclick="zeepTocarMusica(' + i + ')" title="Pre-escuta" style="background:none;border:1px solid var(--border2);border-radius:50%;width:30px;height:30px;color:var(--cyan);cursor:pointer;font-size:11px;flex-shrink:0;">&#9654;</button>' +
      '<input type="checkbox" class="zeep-chk" data-idx="' + i + '" onchange="zeepAtualizarContagem()" style="width:16px;height:16px;flex-shrink:0;accent-color:var(--cyan);">' +
      '<div style="flex:1;min-width:0;">' +
        '<div style="font-size:13px;color:var(--text);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + zeepEsc(titulo) + '</div>' +
        '<div style="font-size:11px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + zeepEsc(artista) + (album ? ' - ' + zeepEsc(album) : '') + '</div>' +
      '</div>' +
      (genero ? '<span style="font-size:10px;color:var(--cyan);text-transform:uppercase;flex-shrink:0;background:var(--cyan4);padding:3px 8px;border-radius:4px;">' + zeepEsc(genero) + '</span>' : '') +
      (dur ? '<span style="font-size:11px;color:var(--text3);flex-shrink:0;">' + dur + '</span>' : '') +
    '</div>';
  }
  if (!html) html = '<p style="color:var(--text3);font-size:13px;text-align:center;padding:30px;">Nenhuma musica encontrada.</p>';
  container.innerHTML = html;
  zeepAtualizarContagem();
}

function zeepMarcarTodas() {
  var todas = document.getElementById('zeep-marcar-todas').checked;
  var chks = document.querySelectorAll('#zeep-lista-musicas .zeep-chk');
  for (var i = 0; i < chks.length; i++) chks[i].checked = todas;
  zeepAtualizarContagem();
}

function zeepAtualizarContagem() {
  var n = document.querySelectorAll('#zeep-lista-musicas .zeep-chk:checked').length;
  var el = document.getElementById('zeep-contagem');
  if (el) el.textContent = n + ' selecionada(s)';
}

function zeepTocarMusica(idx) {
  var fonte = zeepFonteMusicas();
  var m = fonte[idx];
  if (!m) return;
  var url = zeepAudioUrl(m);
  if (!url) { alert('Esta musica nao possui URL de audio para pre-escuta.'); return; }
  if (_zeepIdxAtual === idx && _zeepAudio) { zeepTogglePreEscuta(); return; }
  if (_zeepAudio) { try { _zeepAudio.pause(); } catch (e) {} }
  _zeepAudio = new Audio(url);
  _zeepIdxAtual = idx;
  document.getElementById('zeep-player-nome').textContent = m.title || m.name || m.t || '';
  document.getElementById('zeep-player-artista').textContent = m.artist || m.a || '';
  document.getElementById('zeep-player-duracao').textContent = zeepFormatDur(m.duration || m.dur);
  document.getElementById('zeep-player-tempo').textContent = '0:00';
  document.getElementById('zeep-play-toggle').innerHTML = '&#10074;&#10074;';
  document.getElementById('zeep-player-bar').style.display = 'flex';
  _zeepAudio.ontimeupdate = function() {
    var el = document.getElementById('zeep-player-tempo');
    if (el && _zeepAudio) el.textContent = zeepFormatDur(Math.floor(_zeepAudio.currentTime));
  };
  _zeepAudio.onended = function() {
    document.getElementById('zeep-play-toggle').innerHTML = '&#9654;';
  };
  _zeepAudio.play();
}

function zeepTogglePreEscuta() {
  if (!_zeepAudio) return;
  if (_zeepAudio.paused) {
    _zeepAudio.play();
    document.getElementById('zeep-play-toggle').innerHTML = '&#10074;&#10074;';
  } else {
    _zeepAudio.pause();
    document.getElementById('zeep-play-toggle').innerHTML = '&#9654;';
  }
}

function zeepConfirmarAdicionar() {
  if (!_zeepAlvoPlaylist) return;
  var chks = document.querySelectorAll('#zeep-lista-musicas .zeep-chk:checked');
  if (!chks.length) { alert('Selecione ao menos uma musica.'); return; }
  var fonte = zeepFonteMusicas();
  var novas = [];
  for (var i = 0; i < chks.length; i++) {
    var idx = parseInt(chks[i].getAttribute('data-idx'), 10);
    if (fonte[idx]) novas.push(fonte[idx]);
  }
  if (!novas.length) return;
  var alvo = _zeepAlvoPlaylist;
  var playlist = (alvo && alvo.ref) ? alvo.ref : null;
  if (!playlist && alvo) playlist = zeepAcharPlaylist(alvo.tipo, alvo.key, alvo.nome);
  if (!playlist) {
    try {
      if (window.db && Array.isArray(window.db.playlists)) {
        for (var d = 0; d < window.db.playlists.length; d++) {
          if (window.db.playlists[d] && zeepNorm(window.db.playlists[d].name || window.db.playlists[d].titulo || '') === zeepNorm(alvo.nome)) {
            playlist = window.db.playlists[d]; break;
          }
        }
      }
    } catch (e) {}
  }
  if (!playlist && typeof currentPlaylistId !== 'undefined' && currentPlaylistId) {
    try {
      playlist = (window.db && window.db.playlists || []).find(function(x){
        return String(x.id) === String(currentPlaylistId) || String(x._key) === String(currentPlaylistId);
      }) || null;
    } catch (e2) {}
  }
  if (!playlist && alvo) {
    var chavePalvo = alvo.key || alvo.nome || '';
    try {
      playlist = (window.db && window.db.playlists || []).find(function(x){
        return String(x.id || '') === String(chavePalvo)
          || String(x._key || '') === String(chavePalvo)
          || x.name === alvo.nome
          || x.titulo === alvo.nome;
      }) || null;
    } catch (e3) {}
  }
  if (!playlist && typeof getPlaylists === 'function') {
    try {
      var todasPL = getPlaylists();
      if (Array.isArray(todasPL)) {
        var chPL = (alvo && (alvo.key || '')) || (typeof currentPlaylistId !== 'undefined' ? currentPlaylistId : '');
        for (var q2 = 0; q2 < todasPL.length; q2++) {
          var pp2 = todasPL[q2]; if (!pp2) continue;
          if (chPL && (String(pp2.id || '') === String(chPL) || String(pp2._key || '') === String(chPL))) { playlist = pp2; break; }
          if (alvo && alvo.nome && (pp2.name === alvo.nome || pp2.titulo === alvo.nome || pp2.title === alvo.nome)) { playlist = pp2; break; }
        }
      }
    } catch (e5) {}
  }
  if (!playlist && alvo && window._zeepPlaylistRefs) {
    try { playlist = window._zeepPlaylistRefs[alvo.nome] || window._zeepPlaylistRefs[alvo.key] || null; } catch (e6) {}
  }
  if (!playlist) {
    try {
      console.warn('[ZEEP-ADD] ALVO:', alvo);
      if (window.db && window.db.playlists) console.warn('[ZEEP-ADD] db.playlists:', window.db.playlists.map(function(p){ return { id: p.id || p._key, nome: p.name || p.titulo || p.title }; }));
      if (typeof getPlaylists === 'function') console.warn('[ZEEP-ADD] getPlaylists():', getPlaylists().map(function(p){ return { id: p.id || p._key, nome: p.name || p.titulo || p.title }; }));
    } catch (e7) {}
    alert('Playlist nao encontrada (' + ((alvo && (alvo.nome || alvo.key)) || 'sem alvo') + '). Feche e abra novamente o modal pela playlist.');
    return;
  }
  if (!Array.isArray(playlist.tracks)) playlist.tracks = [];
  var jaExiste = {};
  for (var x = 0; x < playlist.tracks.length; x++) {
    var tt = playlist.tracks[x];
    jaExiste[(tt.title || tt.t || tt.name || '')] = true;
  }
  var adicionadas = 0;
  for (var y = 0; y < novas.length; y++) {
    var nv = novas[y];
    var nomeMusica = nv.title || nv.t || nv.name || '';
    if (nomeMusica && jaExiste[nomeMusica]) continue;
    playlist.tracks.push(nv);
    jaExiste[nomeMusica] = true;
    adicionadas++;
  }
  if (!adicionadas) {
    zeepFecharModal();
    alert('As musicas selecionadas ja estao na playlist.');
    return;
  }

  // ── Persistir no Supabase antes de mostrar sucesso ──
  var playlistId = String(playlist.id || playlist._key || (alvo && alvo.key) || currentPlaylistId || '');
  var ids = novas.map(function(n){
    return n && (n.id || n.track_id || n.uuid || (typeof n.key === 'string' && n.key.length === 36 ? n.key : ''));
  }).filter(function(k){ return k && k.length === 36; });

  if (!ids.length) {
    alert('Nenhuma música com UUID válido para salvar. A biblioteca precisa conter o id do Supabase nas faixas.');
    return;
  }

  // ★ Sempre busca do servidor e redesenha (mata o "fantasma local")
  function recarregarPlaylists() {
    if (typeof zeepCarregarPlaylists === 'function') zeepCarregarPlaylists();
    else if (typeof zeepRefresh === 'function') zeepRefresh();
    if (typeof renderPlaylistAccordion === 'function') renderPlaylistAccordion();
  }

  function efetuarPost() {
    zeepApi('POST', '/playlists/' + playlistId + '/tracks', { track_ids: ids })
      .then(function (r) {
        if (!r || r.success === false) throw new Error((r && r.message) || 'Erro no servidor');
        zeepFecharModal();
        recarregarPlaylists();   // ★ recarrega do servidor E desenha de novo
        var pc = document.getElementById('vc-playlists');
        if (pc) {
          var cl = (typeof getClienteAtual === 'function') ? getClienteAtual() : null;
          if (cl) pc.textContent = String((cl.playlistList && cl.playlistList.length) || (Array.isArray(cl.playlists) ? cl.playlists.length : (cl.playlists || 1)));
        }
        alert(adicionadas + ' musica(s) adicionada(s) a playlist! Salvas no Supabase.');
      })
      .catch(function (e) {
        alert('Erro ao salvar no servidor: ' + (e.message || e));
        // ★ ROLLBACK: recarrega do servidor para apagar o "fantasma" local —
        // o push acima deixou a música na lista do navegador; se o banco
        // recusou, a tela precisa voltar ao estado real (senão o próximo
        // "add" acha que a música já existe e não envia nada).
        recarregarPlaylists();
      });
  }

  if (playlistId) { efetuarPost(); return; }

  // id vazio: resolve o UUID pela API usando o nome (fonte da verdade)
  if (alvo && alvo.nome) {
    zeepApi('GET', '/playlists').then(function (d) {
      var lista = d && (d.playlists || d.data || d.lista);
      if (!Array.isArray(lista)) lista = Array.isArray(d) ? d : [];
      console.log('[ZEEP-ADD] GET /playlists ->', d);
      var nomeAlvo = String(alvo.nome).toLowerCase().trim();
      for (var w = 0; w < lista.length; w++) {
        var o = lista[w]; if (!o) continue;
        if (String(o.name || o.titulo || o.title || '').toLowerCase().trim() === nomeAlvo) {
          playlistId = String(o.id || o._key || ''); break;
        }
      }
      if (!playlistId) { alert('Playlist "' + alvo.nome + '" não encontrada na API. Recarregue a página e tente de novo.'); return; }
      efetuarPost();
    }).catch(function (e) {
      alert('Erro ao buscar playlist na API: ' + (e.message || e));
    });
  } else {
    alert('Playlist sem id para salvar. Feche e abra novamente o modal.');
  }
}

/* ================= BOTÕES ================= */
function zeepAbrirModalComBotao(btn) {
  var tipo = btn.getAttribute('data-zeep-tipo') || 'curadoria';
  var key = btn.getAttribute('data-zeep-key') || '';
  var nome = btn.getAttribute('data-zeep-nome') || '';
  // Busca robusta: por id, por nome ou por _key, direto na lista real
  var ref = null;
  var pls = getPlaylists();
  for (var i = 0; i < pls.length; i++) {
    var p = pls[i];
    var pid = String(p.id || p._key || '');
    var pnome = String(p.nome || p.name || p.titulo || p.title || '');
    if ((key && pid === String(key)) || (nome && pnome === String(nome))) {
      ref = p;
      break;
    }
  }
  if (!ref) ref = window._zeepPlaylistRefs[nome] || window._zeepPlaylistRefs[key] || null;
  if (ref) { window._zeepPlaylistRefs[nome] = ref; window._zeepPlaylistRefs[key] = ref; }
  zeepAbrirModal(tipo, key, nome, ref);
}

function zeepAbrirModalCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  var cliente = getClienteAtual();
  if (!cliente) { alert('Nenhum cliente selecionado.'); return; }
  var pls = getPlaylistsDoCliente(cliente);
  var pl = pls[idx];
  if (!pl) { alert('Playlist nao encontrada.'); return; }
  var nome = pl.titulo || pl.name || pl.title || ('Playlist ' + (idx + 1));
  window._zeepPlaylistRefs[nome] = pl;
  window._zeepPlaylistRefs[String(pl._key || pl.id || idx)] = pl;
  zeepAbrirModal('cliente', pl._key || pl.id || idx, nome, pl);
}

function zeepInjetarBotoes() {
  var curadoria = document.querySelectorAll('#playlist-accordion .playlist-box, [id*="playlist"] .playlist-box');
  for (var i = 0; i < curadoria.length; i++) {
    var box = curadoria[i];
    if (box.querySelector('.zeep-add-musica')) continue;
    var nome = '';
    var tituloEl = box.querySelector('.playlist-head h4') || box.querySelector('h4') || box.querySelector('b');
    if (tituloEl) nome = tituloEl.textContent.trim();     
    if (!nome) continue;
    var pl = zeepAcharPlaylist('curadoria', '', nome);
    if (pl) { window._zeepPlaylistRefs[nome] = pl; window._zeepPlaylistRefs[String(pl.id || '')] = pl; }
    var btn = document.createElement('button');
    btn.className = 'btn btn-ghost btn-sm zeep-add-musica';
    btn.textContent = '+ Adicionar musicas';
    btn.style.marginTop = '10px';
    btn.setAttribute('data-zeep-tipo', 'curadoria');
    btn.setAttribute('data-zeep-key', pl ? (pl.id || '') : '');
    btn.setAttribute('data-zeep-nome', nome);
    btn.onclick = function() { zeepAbrirModalComBotao(this); };
    box.appendChild(btn);
  }
  var zeepBoxes = document.querySelectorAll('#zeep-accordion .playlist-box');
  for (var k2 = 0; k2 < zeepBoxes.length; k2++) {
    var zb = zeepBoxes[k2];
    if (zb.querySelector('.zeep-add-musica')) continue;
    var znome = '';
    var h4 = zb.querySelector('h4') || zb.querySelector('strong');
    if (h4) znome = h4.textContent.replace(/SAZONAL/g, '').trim();
    if (!znome) continue;
    var zpl = zeepAcharPlaylist('zeep', '', znome);
    if (zpl) { window._zeepPlaylistRefs[znome] = zpl; window._zeepPlaylistRefs[String(zpl._key || '')] = zpl; }
    var zbtn = document.createElement('button');
    zbtn.className = 'btn btn-ghost btn-sm zeep-add-musica';
    zbtn.textContent = '+ Adicionar musicas';
    zbtn.style.marginTop = '10px';
    zbtn.setAttribute('data-zeep-tipo', 'zeep');
    zbtn.setAttribute('data-zeep-key', zpl ? (zpl._key || '') : '');
    zbtn.setAttribute('data-zeep-nome', znome);
    zbtn.onclick = function() { zeepAbrirModalComBotao(this); };
    zb.appendChild(zbtn);
  }
}

/* ================= REFRESH GENÉRICO ================= */
function zeepRefresh() {
  try { if (typeof renderClients === 'function') renderClients(); } catch (e) {}
  try { if (typeof renderPlaylistAccordion === 'function') renderPlaylistAccordion(); } catch (e) {}
  try { if (typeof zeepRender === 'function') zeepRender(); } catch (e) {}
  try { if (typeof renderPlaylistsDoCliente === 'function') renderPlaylistsDoCliente(); } catch (e) {}
  try { if (typeof renderUnidadesDoCliente === 'function') renderUnidadesDoCliente(); } catch (e) {}
}

/* ================= HOOKS (setam o cliente atual ao abrir o modal Ver) ================= */
(function() {
  var origAbrir = window.abrirDetalheCliente;
  window.abrirDetalheCliente = function(cid) {
    _clienteAtualId = cid;
    if (typeof origAbrir === 'function') { try { origAbrir(cid); } catch (e) {} }
    setTimeout(function() {
      try { renderPlaylistsDoCliente(); renderUnidadesDoCliente(); } catch (e) {}
    }, 50);
  };
})();

(function() {
  var navOrig = window.nav;
  window.nav = function(id, el) {
    if (id === 'clientes' && typeof corrigirBotaoVer === 'function') {
      setTimeout(corrigirBotaoVer, 100);
    }
    if (navOrig) navOrig(id, el);
  };
})();

/* ================= BOOT + VIGIA ÚNICO ================= */
(function() {
  function boot() {
    try { zeepSincronizarCuradoria(); } catch (e) {}
    try { zeepInjetarBotoes(); } catch (e) {}
    var fontes = [];
    try {
      if (window.db) {
        if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
        if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
      }
    } catch (e) {}
    for (var i = 0; i < fontes.length; i++) recalcularValorCliente(fontes[i]);
    try { if (typeof renderClients === 'function') renderClients(); } catch (e) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else setTimeout(boot, 300);
})();

/* Vigia ÚNICO: botões + sincronização (leve, 1.5s) */
setInterval(function() {
  try { zeepInjetarBotoes(); } catch (e) {}
  try { zeepSincronizarCuradoria(); } catch (e) {}
}, 1500);
</script>
<script>
/* ============ EDITA + PRÉ-ESCUTA NAS PLAYLISTS BIBLIOTECA ZEEP ============ */

/* ---- Abre modal para editar a playlist BZ (nome, descrição, plano) ---- */
function zeepEditarPlaylistBZ(btn) {
  var nome = btn.getAttribute('data-bz-nome') || '';
  var pl = zeepAcharPlaylistBZ(nome);
  if (!pl) { alert('Playlist nao encontrada.'); return; }
  var novoNome = prompt('Nome da playlist:', pl.titulo || pl.name || '');
  if (novoNome === null) return;
  var novaDesc = prompt('Descricao:', pl.descricao || pl.desc || '');
  if (novaDesc === null) return;
  var novoPlano = prompt('Plano (Standard / Business / Enterprise):', pl.plano || pl.plan || 'Business');
  if (novoPlano === null) return;
  pl.titulo = novoNome.trim();
  pl.name = novoNome.trim();
  pl.descricao = novaDesc;
  pl.desc = novaDesc;
  pl.plano = novoPlano;
  pl.plan = novoPlano;
  if (typeof zeepRender === 'function') { try { zeepRender(); } catch (e) {} }
  alert('Playlist atualizada!');
}

/* ---- Busca playlist BZ por nome ---- */
function zeepAcharPlaylistBZ(nome) {
  var n = zeepNorm(nome);
  try {
    if (window.db && Array.isArray(window.db.bibliotecaZeep)) {
      for (var i = 0; i < window.db.bibliotecaZeep.length; i++) {
        var z = window.db.bibliotecaZeep[i];
        if (z && zeepNorm(z.titulo || z.name || '') === n) return z;
      }
    }
  } catch (e) {}
  return null;
}

/* ---- Pré-escuta da playlist BZ (toca a 1ª música ou mostra lista) ---- */
function zeepPreEscutaPlaylistBZ(btn) {
  var nome = btn.getAttribute('data-bz-nome') || '';
  var pl = zeepAcharPlaylistBZ(nome);
  if (!pl) { alert('Playlist nao encontrada.'); return; }
  var tracks = (pl.tracks && Array.isArray(pl.tracks)) ? pl.tracks : [];
  if (!tracks.length) { alert('Esta playlist nao possui musicas ainda.'); return; }
  /* Toca a primeira música com pré-escuta */
  var m = tracks[0];
  var url = zeepAudioUrl(m);
  if (!url) { alert('As musicas desta playlist nao possuem URL de audio.'); return; }
  if (_zeepAudio) { try { _zeepAudio.pause(); } catch (e) {} }
  _zeepAudio = new Audio(url);
  _zeepIdxAtual = -1;
  document.getElementById('zeep-player-nome').textContent = m.title || m.name || m.t || '';
  document.getElementById('zeep-player-artista').textContent = m.artist || m.a || '';
  document.getElementById('zeep-player-duracao').textContent = zeepFormatDur(m.duration || m.dur);
  document.getElementById('zeep-player-tempo').textContent = '0:00';
  document.getElementById('zeep-play-toggle').innerHTML = '&#10074;&#10074;';
  document.getElementById('zeep-player-bar').style.display = 'flex';
  _zeepAudio.ontimeupdate = function() {
    var el = document.getElementById('zeep-player-tempo');
    if (el && _zeepAudio) el.textContent = zeepFormatDur(Math.floor(_zeepAudio.currentTime));
  };
  _zeepAudio.onended = function() {
    document.getElementById('zeep-play-toggle').innerHTML = '&#9654;';
  };
  _zeepAudio.play();
}

/* ---- Injeta os botões Editar + Pré-escuta nas playlists BZ ---- */
function zeepInjetarBotoesBZ() {
  var boxes = document.querySelectorAll('#zeep-accordion .playlist-box, [id*="biblioteca-zeep"] .playlist-box');
  for (var i = 0; i < boxes.length; i++) {
    var box = boxes[i];
    if (box.querySelector('.zeep-edit-bz')) continue;
    var nome = '';
    var h4 = box.querySelector('h4') || box.querySelector('strong') || box.querySelector('b');
    if (h4) nome = h4.textContent.replace(/SAZONAL/g, '').trim();
    if (!nome) continue;
    /* Cria container de ações se não existir */
    var acoes = box.querySelector('.zeep-acoes-bz');
    if (!acoes) {
      acoes = document.createElement('div');
      acoes.className = 'zeep-acoes-bz';
      acoes.style.cssText = 'display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;';
      box.appendChild(acoes);
    }
    /* Botão Editar */
    var btnEditar = document.createElement('button');
    btnEditar.className = 'btn btn-ghost btn-sm zeep-edit-bz';
    btnEditar.textContent = 'Editar';
    btnEditar.setAttribute('data-bz-nome', nome);
    btnEditar.onclick = function() { zeepEditarPlaylistBZ(this); };
    acoes.appendChild(btnEditar);
    /* Botão Pré-escuta */
    var btnPre = document.createElement('button');
    btnPre.className = 'btn btn-ghost btn-sm zeep-pre-bz';
    btnPre.textContent = '▶ Pré-escuta';
    btnPre.setAttribute('data-bz-nome', nome);
    btnPre.onclick = function() { zeepPreEscutaPlaylistBZ(this); };
    acoes.appendChild(btnPre);
  }
}

/* Vigia: injeta os botões nas playlists BZ */
setInterval(function() {
  try { zeepInjetarBotoesBZ(); } catch (e) {}
}, 1200);
</script>
<script>
/* ============ BZ IGUAL À CURADORIA: VER MÚSICAS + PRÉ-ESCUTA POR MÚSICA + REMOVER ============ */

/* ---- Barra de player GLOBAL (fixa no rodapé da página, fora do modal) ---- */
function zeepGarantirPlayerGlobal() {
  if (document.getElementById('zeep-player-global')) return;
  var bar = document.createElement('div');
  bar.id = 'zeep-player-global';
  bar.style.cssText = 'position:fixed;bottom:0;left:240px;right:0;background:var(--navy2);border-top:1px solid var(--border);padding:12px 40px;display:none;align-items:center;gap:14px;z-index:1500;';
  bar.innerHTML =
    '<button id="zeep-global-play-toggle" onclick="zeepToggleGlobal()" style="background:var(--cyan);border:none;border-radius:50%;width:36px;height:36px;color:var(--navy);cursor:pointer;font-size:14px;flex-shrink:0;">&#9654;</button>' +
    '<div style="flex:1;min-width:0;">' +
      '<div id="zeep-global-nome" style="font-size:13px;color:var(--text);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">-</div>' +
      '<div id="zeep-global-artista" style="font-size:11px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">-</div>' +
    '</div>' +
    '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">' +
      '<span id="zeep-global-tempo" style="font-size:11px;color:var(--text3);">0:00</span>' +
      '<span style="font-size:11px;color:var(--text3);">/</span>' +
      '<span id="zeep-global-duracao" style="font-size:11px;color:var(--text3);">0:00</span>' +
    '</div>';
  document.body.appendChild(bar);
}

var _zeepAudioGlobal = null;

function zeepToggleGlobal() {
  if (!_zeepAudioGlobal) return;
  if (_zeepAudioGlobal.paused) {
    _zeepAudioGlobal.play();
    document.getElementById('zeep-global-play-toggle').innerHTML = '&#10074;&#10074;';
  } else {
    _zeepAudioGlobal.pause();
    document.getElementById('zeep-global-play-toggle').innerHTML = '&#9654;';
  }
}

/* ---- Toca uma música da BZ na barra global (mesma lógica da Curadoria) ---- */
function zeepTocarNaBarraGlobal(m) {
  var url = zeepAudioUrl(m);
  if (!url) { alert('Esta musica nao possui URL de audio para pre-escuta.'); return; }
  zeepGarantirPlayerGlobal();
  if (_zeepAudioGlobal) { try { _zeepAudioGlobal.pause(); } catch (e) {} }
  _zeepAudioGlobal = new Audio(url);
  document.getElementById('zeep-global-nome').textContent = m.title || m.name || m.t || '';
  document.getElementById('zeep-global-artista').textContent = m.artist || m.a || '';
  document.getElementById('zeep-global-duracao').textContent = zeepFormatDur(m.duration || m.dur);
  document.getElementById('zeep-global-tempo').textContent = '0:00';
  document.getElementById('zeep-global-play-toggle').innerHTML = '&#10074;&#10074;';
  document.getElementById('zeep-player-global').style.display = 'flex';
  _zeepAudioGlobal.ontimeupdate = function() {
    var el = document.getElementById('zeep-global-tempo');
    if (el && _zeepAudioGlobal) el.textContent = zeepFormatDur(Math.floor(_zeepAudioGlobal.currentTime));
  };
  _zeepAudioGlobal.onended = function() {
    document.getElementById('zeep-global-play-toggle').innerHTML = '&#9654;';
  };
  _zeepAudioGlobal.play();
}

/* ---- Pré-escuta individual de uma música da BZ ---- */
function zeepPreEscutaMusicaBZ(nome, idx) {
  var pl = zeepAcharPlaylist('zeep', '', nome) || (typeof zeepAcharPlaylistBZ === 'function' ? zeepAcharPlaylistBZ(nome) : null);
  if (!pl) { alert('Playlist nao encontrada.'); return; }
  var tracks = (pl.tracks && Array.isArray(pl.tracks)) ? pl.tracks : [];
  var m = tracks[idx];
  if (!m) { alert('Musica nao encontrada.'); return; }
  zeepTocarNaBarraGlobal(m);
}

/* ---- SUBSTITUI o "Pré-escuta" antigo do card BZ (que não mostrava nada) ---- */
function zeepPreEscutaPlaylistBZ(btn) {
  var nome = btn.getAttribute('data-bz-nome') || '';
  var pl = zeepAcharPlaylist('zeep', '', nome) || (typeof zeepAcharPlaylistBZ === 'function' ? zeepAcharPlaylistBZ(nome) : null);
  if (!pl) { alert('Playlist nao encontrada.'); return; }
  var tracks = (pl.tracks && Array.isArray(pl.tracks)) ? pl.tracks : [];
  if (!tracks.length) { alert('Esta playlist nao possui musicas ainda.'); return; }
  zeepTocarNaBarraGlobal(tracks[0]);
}

/* ---- Remove uma música da BZ ---- */
function zeepRemoverMusicaBZ(nome, idx) {
  if (!confirm('Remover esta musica da playlist?')) return;
  var pl = zeepAcharPlaylist('zeep', '', nome) || (typeof zeepAcharPlaylistBZ === 'function' ? zeepAcharPlaylistBZ(nome) : null);
  if (!pl) { alert('Playlist nao encontrada.'); return; }
  var tracks = (pl.tracks && Array.isArray(pl.tracks)) ? pl.tracks : [];
  if (!tracks[idx]) return;
  tracks.splice(idx, 1);
  if (typeof zeepRender === 'function') { try { zeepRender(); } catch (e) {} }
  alert('Musica removida.');
}

/* ---- Expande o card BZ mostrando a tabela de músicas (igual Curadoria) ---- */
function zeepExpandirPlaylistBZ(btn) {
  var nome = btn.getAttribute('data-bz-nome') || '';
  var pl = zeepAcharPlaylist('zeep', '', nome) || (typeof zeepAcharPlaylistBZ === 'function' ? zeepAcharPlaylistBZ(nome) : null);
  if (!pl) { alert('Playlist nao encontrada.'); return; }
  var box = btn.closest('.playlist-box') || btn.parentNode;
  var lista = box.querySelector('.zeep-lista-bz');
  if (lista) {
    var visivel = lista.style.display !== 'none';
    lista.style.display = visivel ? 'none' : 'block';
    btn.textContent = visivel ? 'Ver músicas' : 'Ocultar músicas';
    return;
  }
  var div = document.createElement('div');
  div.className = 'zeep-lista-bz';
  div.style.cssText = 'margin-top:12px;border-top:1px solid var(--border);padding-top:12px;';
  div.innerHTML = zeepTabelaMusicasBZ(nome, pl);
  box.appendChild(div);
  btn.textContent = 'Ocultar músicas';
}

/* ---- Tabela de músicas da BZ (mesmas colunas da Curadoria) ---- */
function zeepTabelaMusicasBZ(nome, pl) {
  var tracks = (pl.tracks && Array.isArray(pl.tracks)) ? pl.tracks : [];
  if (!tracks.length) {
    return '<p style="color:var(--text3);font-size:12px;padding:8px 0;">Nenhuma musica nesta playlist.</p>';
  }
  var h = '<table style="width:100%;border-collapse:collapse;font-size:12px;">' +
    '<thead><tr>' +
      '<th style="text-align:left;padding:6px 8px;font-size:10px;text-transform:uppercase;color:var(--text3);">#</th>' +
      '<th style="text-align:left;padding:6px 8px;font-size:10px;text-transform:uppercase;color:var(--text3);">Titulo</th>' +
      '<th style="text-align:left;padding:6px 8px;font-size:10px;text-transform:uppercase;color:var(--text3);">Artista</th>' +
      '<th style="text-align:left;padding:6px 8px;font-size:10px;text-transform:uppercase;color:var(--text3);">Album</th>' +
      '<th style="text-align:left;padding:6px 8px;font-size:10px;text-transform:uppercase;color:var(--text3);">Genero</th>' +
      '<th style="text-align:left;padding:6px 8px;font-size:10px;text-transform:uppercase;color:var(--text3);">Acoes</th>' +
    '</tr></thead><tbody>';
  for (var i = 0; i < tracks.length; i++) {
    var t = tracks[i];
    var titulo = t.title || t.t || t.name || ('Musica ' + (i + 1));
    var artista = t.artist || t.a || '';
    var album = t.album || t.alb || '';
    var genero = t.genre || t.g || '';
    h += '<tr style="border-top:1px solid var(--border);">' +
      '<td style="padding:8px;color:var(--text3);">' + (i + 1) + '</td>' +
      '<td style="padding:8px;color:var(--text);font-weight:600;">' + zeepEsc(titulo) + '</td>' +
      '<td style="padding:8px;color:var(--text2);">' + zeepEsc(artista) + '</td>' +
      '<td style="padding:8px;color:var(--text2);">' + zeepEsc(album) + '</td>' +
      '<td style="padding:8px;">' + (genero ? '<span style="font-size:9px;color:var(--cyan);text-transform:uppercase;background:var(--cyan4);padding:2px 6px;border-radius:4px;">' + zeepEsc(genero) + '</span>' : '<span style="color:var(--text3);">-</span>') + '</td>' +
      '<td style="padding:8px;">' +
        '<button class="btn btn-ghost btn-sm" onclick="zeepPreEscutaMusicaBZ(\'' + zeepEsc(nome).replace(/'/g, "\'") + '\',' + i + ')" title="Pre-escuta" style="margin-right:6px;">&#9654;</button>' +
        '<button class="btn btn-danger btn-sm" onclick="zeepRemoverMusicaBZ(\'' + zeepEsc(nome).replace(/'/g, "\'") + '\',' + i + ')">-</button>' +
      '</td></tr>';
  }
  h += '</tbody></table>';
  return h;
}

/* ---- Injeta o botão "Ver músicas" em cada card BZ ---- */
function zeepInjetarBotaoVerBZ() {
  var boxes = document.querySelectorAll('#zeep-accordion .playlist-box, [id*="biblioteca-zeep"] .playlist-box');
  for (var i = 0; i < boxes.length; i++) {
    var box = boxes[i];
    if (box.querySelector('.zeep-ver-musicas-bz')) continue;
    var nome = '';
    var h4 = box.querySelector('h4') || box.querySelector('strong') || box.querySelector('b');
    if (h4) nome = h4.textContent.replace(/SAZONAL/g, '').trim();
    if (!nome) continue;
    var acoes = box.querySelector('.zeep-acoes-bz');
    if (!acoes) {
      acoes = document.createElement('div');
      acoes.className = 'zeep-acoes-bz';
      acoes.style.cssText = 'display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;';
      box.appendChild(acoes);
    }
    var btn = document.createElement('button');
    btn.className = 'btn btn-ghost btn-sm zeep-ver-musicas-bz';
    btn.textContent = 'Ver músicas';
    btn.setAttribute('data-bz-nome', nome);
    btn.onclick = function() { zeepExpandirPlaylistBZ(this); };
    acoes.appendChild(btn);
  }
}
setInterval(function() { try { zeepInjetarBotaoVerBZ(); } catch (e) {} }, 1200);
</script>
<script>
/* ============ 1) LIMITE DE 15 SEGUNDOS NA PRÉ-ESCUTA (modal + global) ============ */

/* Timer de corte de 15s */
var _zeepCorteTimer = null;

function zeepLimparCorte() {
  if (_zeepCorteTimer) { clearTimeout(_zeepCorteTimer); _zeepCorteTimer = null; }
}

/* Agenda o corte em 15s */
function zeepAgendarCorte(audio, btnId) {
  zeepLimparCorte();
  _zeepCorteTimer = setTimeout(function() {
    try {
      if (audio && !audio.paused) {
        audio.pause();
        var btn = document.getElementById(btnId);
        if (btn) btn.innerHTML = '&#9654;';
      }
    } catch (e) {}
    _zeepCorteTimer = null;
  }, 15000);
}

/* ---- Sobrescreve zeepTocarMusica (player do modal) com corte de 15s ---- */
function zeepTocarMusica(idx) {
  var fonte = zeepFonteMusicas();
  var m = fonte[idx];
  if (!m) return;
  var url = zeepAudioUrl(m);
  if (!url) { alert('Esta musica nao possui URL de audio para pre-escuta.'); return; }
  if (_zeepIdxAtual === idx && _zeepAudio) { zeepTogglePreEscuta(); return; }
  if (_zeepAudio) { try { _zeepAudio.pause(); } catch (e) {} }
  _zeepAudio = new Audio(url);
  _zeepIdxAtual = idx;
  document.getElementById('zeep-player-nome').textContent = m.title || m.name || m.t || '';
  document.getElementById('zeep-player-artista').textContent = m.artist || m.a || '';
  document.getElementById('zeep-player-duracao').textContent = zeepFormatDur(m.duration || m.dur);
  document.getElementById('zeep-player-tempo').textContent = '0:00';
  document.getElementById('zeep-play-toggle').innerHTML = '&#10074;&#10074;';
  document.getElementById('zeep-player-bar').style.display = 'flex';
  _zeepAudio.ontimeupdate = function() {
    var el = document.getElementById('zeep-player-tempo');
    if (el && _zeepAudio) el.textContent = zeepFormatDur(Math.floor(_zeepAudio.currentTime));
  };
  _zeepAudio.onended = function() {
    document.getElementById('zeep-play-toggle').innerHTML = '&#9654;';
    zeepLimparCorte();
  };
  _zeepAudio.play();
  /* CORTE EM 15 SEGUNDOS */
  zeepAgendarCorte(_zeepAudio, 'zeep-play-toggle');
}

/* ---- Sobrescreve zeepTocarNaBarraGlobal (player global BZ) com corte de 15s ---- */
function zeepTocarNaBarraGlobal(m) {
  var url = zeepAudioUrl(m);
  if (!url) { alert('Esta musica nao possui URL de audio para pre-escuta.'); return; }
  zeepGarantirPlayerGlobal();
  if (_zeepAudioGlobal) { try { _zeepAudioGlobal.pause(); } catch (e) {} }
  _zeepAudioGlobal = new Audio(url);
  document.getElementById('zeep-global-nome').textContent = m.title || m.name || m.t || '';
  document.getElementById('zeep-global-artista').textContent = m.artist || m.a || '';
  document.getElementById('zeep-global-duracao').textContent = zeepFormatDur(m.duration || m.dur);
  document.getElementById('zeep-global-tempo').textContent = '0:00';
  document.getElementById('zeep-global-play-toggle').innerHTML = '&#10074;&#10074;';
  document.getElementById('zeep-player-global').style.display = 'flex';
  _zeepAudioGlobal.ontimeupdate = function() {
    var el = document.getElementById('zeep-global-tempo');
    if (el && _zeepAudioGlobal) el.textContent = zeepFormatDur(Math.floor(_zeepAudioGlobal.currentTime));
  };
  _zeepAudioGlobal.onended = function() {
    document.getElementById('zeep-global-play-toggle').innerHTML = '&#9654;';
    zeepLimparCorte();
  };
  _zeepAudioGlobal.play();
  /* CORTE EM 15 SEGUNDOS */
  zeepAgendarCorte(_zeepAudioGlobal, 'zeep-global-play-toggle');
}

/* ---- Limpa o corte ao fechar o modal ---- */
(function() {
  var origFechar = window.zeepFecharModal || null;
  window.zeepFecharModal = function() {
    zeepLimparCorte();
    if (typeof origFechar === 'function') { try { origFechar(); } catch (e) {} }
  };
})();

/* ============ 2) CONECTA O MODAL "+ NOVA PLAYLIST" DA CURADORIA À MESMA LÓGICA ============ */

/* ---- Cria playlist no cliente (mesma lógica do caminho Clientes) ---- */
function zeepCriarPlaylistNoCliente(cliente, nome, desc, inicio, fim) {
  if (!cliente) return null;
  var pls = getPlaylistsDoCliente(cliente);
  var nova = { titulo: nome, descricao: desc, inicio: inicio, fim: fim, tracks: [], _cliente: cliente.nome || cliente.name || '', _clienteId: cliente.id };
  pls.push(nova);
  cliente.playlists = pls.length;
  zeepSincronizarCuradoria();
  return nova;
}

/* ---- Lê os campos do modal da Curadoria e cria a playlist no cliente selecionado ---- */
function zeepCriarPlaylistDoModalCuradoria() {
  /* Lê o dropdown de cliente */
  var selCliente = null;
  var selects = document.querySelectorAll('#modal-nova-playlist select, [id*="nova-playlist"] select, [id*="nova_playlist"] select');
  for (var i = 0; i < selects.length; i++) {
    if (selects[i].value) { selCliente = selects[i]; break; }
  }
  if (!selCliente) { alert('Selecione um cliente.'); return; }
  var clienteId = selCliente.value;
  var cliente = null;
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  for (var c = 0; c < fontes.length; c++) {
    if (String(fontes[c].id) === String(clienteId)) { cliente = fontes[c]; break; }
  }
  if (!cliente) { alert('Cliente nao encontrado.'); return; }

  /* Lê os campos do formulário */
  var modal = selCliente.closest('.modal-content') || selCliente.closest('.modal') || document;
  var inputs = modal.querySelectorAll('input');
  var nome = '', desc = '', inicio = '', fim = '';
  for (var j = 0; j < inputs.length; j++) {
    var inp = inputs[j];
    var ph = (inp.placeholder || '').toLowerCase();
    var lbl = '';
    var label = inp.closest('.form-group');
    if (label) {
      var l = label.querySelector('label');
      if (l) lbl = l.textContent.toLowerCase();
    }
    if (ph.indexOf('nome') > -1 || lbl.indexOf('nome') > -1) nome = inp.value;
    else if (ph.indexOf('descri') > -1 || lbl.indexOf('descri') > -1) desc = inp.value;
    else if (inp.type === 'time' || ph.indexOf('inicio') > -1 || lbl.indexOf('inicio') > -1) inicio = inp.value;
    else if (inp.type === 'time' || ph.indexOf('fim') > -1 || lbl.indexOf('fim') > -1) fim = inp.value;
  }
  if (!nome) { alert('Informe o nome da playlist.'); return; }

  var nova = zeepCriarPlaylistNoCliente(cliente, nome.trim(), desc, inicio, fim);
  if (!nova) { alert('Erro ao criar playlist.'); return; }

  /* Fecha o modal */
  var modalEl = selCliente.closest('.modal');
  if (modalEl) modalEl.style.display = 'none';
  else {
    var fechar = modal.querySelector('button');
    if (fechar) fechar.click();
  }

  zeepRefresh();
  alert('Playlist "' + nova.titulo + '" criada para ' + (cliente.nome || cliente.name) + '!');
}

/* ---- Intercepta o clique no botão "Criar Playlist" do modal da Curadoria ---- */
function zeepConectarModalCuradoria() {
  var botoes = document.querySelectorAll('button');
  for (var i = 0; i < botoes.length; i++) {
    var b = botoes[i];
    if (b.getAttribute('data-zeep-curadoria')) continue;
    var txt = (b.textContent || '').trim().toLowerCase();
    if (txt === 'criar playlist' || txt === 'criar' || txt === 'salvar playlist') {
      b.setAttribute('data-zeep-curadoria', '1');
      b.onclick = function(ev) {
        ev.preventDefault();
        ev.stopPropagation();
        zeepCriarPlaylistDoModalCuradoria();
      };
    }
  }
}

/* Vigia: injeta a conexão do modal da Curadoria */
setInterval(function() {
  try { zeepConectarModalCuradoria(); } catch (e) {}
}, 1000);
</script>
<script>
/* ============ CRIAÇÃO DE CLIENTE COM MÚLTIPLAS UNIDADES (Matriz + Filiais) ============ */

/* ---- Cria N unidades placeholder no cliente (1ª = Matriz, demais = Filial) ---- */
function zeepCriarUnidadesPlaceholder(cliente, nUnidades) {
  if (!cliente) return;
  var n = parseInt(nUnidades, 10);
  if (isNaN(n) || n < 1) n = 1;
  if (!Array.isArray(cliente.units)) cliente.units = [];
  /* Se já tem unidades, não duplica */
  if (cliente.units.length > 0) return;
  for (var i = 0; i < n; i++) {
    cliente.units.push({
      nome: (i === 0) ? (cliente.nome || cliente.name || '') + ' (Matriz)' : 'Unidade ' + (i + 1),
      endereco: '',
      login: (i === 0) ? (cliente.email || cliente.login || '') : '',
      senha: '',
      status: 'Pendente',
      tipo: (i === 0) ? 'matriz' : 'filial'
    });
  }
  cliente.unidades = n;
  if (typeof recalcularValorCliente === 'function') recalcularValorCliente(cliente);
}

/* ---- Intercepta o botão "Criar Cliente" do modal de novo cliente ---- */
function zeepConectarCriarCliente() {
  var botoes = document.querySelectorAll('button');
  for (var i = 0; i < botoes.length; i++) {
    var b = botoes[i];
    if (b.getAttribute('data-zeep-criar-cliente')) continue;
    var txt = (b.textContent || '').trim().toLowerCase();
    if (txt === 'criar cliente' || txt === 'criar' || txt === 'salvar cliente') {
      b.setAttribute('data-zeep-criar-cliente', '1');
      b.addEventListener('click', function() {
        /* Espera a criação terminar e popula as unidades */
        setTimeout(function() {
          try { zeepPopularUnidadesDoClienteCriado(); } catch (e) {}
        }, 300);
      });
    }
  }
}

/* ---- Lê o campo de nº de unidades e popula o cliente recém-criado ---- */
function zeepPopularUnidadesDoClienteCriado() {
  /* Lê o nome do cliente digitado no modal */
  var nomeCliente = '';
  var inputs = document.querySelectorAll('input');
  for (var i = 0; i < inputs.length; i++) {
    var inp = inputs[i];
    var ph = (inp.placeholder || '').toLowerCase();
    var lbl = '';
    var label = inp.closest('.form-group');
    if (label) { var l = label.querySelector('label'); if (l) lbl = l.textContent.toLowerCase(); }
    if (ph.indexOf('empresa') > -1 || lbl.indexOf('empresa') > -1 || ph.indexOf('nome') > -1 || lbl.indexOf('nome') > -1) {
      if (inp.value) { nomeCliente = inp.value.trim(); break; }
    }
  }
  /* Lê o nº de unidades */
  var nUnidades = 1;
  for (var j = 0; j < inputs.length; j++) {
    var inp2 = inputs[j];
    var ph2 = (inp2.placeholder || '').toLowerCase();
    var lbl2 = '';
    var label2 = inp2.closest('.form-group');
    if (label2) { var l2 = label2.querySelector('label'); if (l2) lbl2 = l2.textContent.toLowerCase(); }
    if (ph2.indexOf('unidade') > -1 || lbl2.indexOf('unidade') > -1 || ph2.indexOf('filial') > -1 || lbl2.indexOf('filial') > -1) {
      var v = parseInt(inp2.value, 10);
      if (!isNaN(v) && v > 0) { nUnidades = v; break; }
    }
  }

  /* Encontra o cliente recém-criado (último da lista ou pelo nome) */
  var cliente = null;
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  if (nomeCliente) {
    for (var c = 0; c < fontes.length; c++) {
      if (zeepNorm(fontes[c].nome || fontes[c].name || '') === zeepNorm(nomeCliente)) { cliente = fontes[c]; break; }
    }
  }
  if (!cliente && fontes.length) cliente = fontes[fontes.length - 1];

  if (cliente) {
    zeepCriarUnidadesPlaceholder(cliente, nUnidades);
    zeepRefresh();
  }
}

/* ---- Renderiza unidades (incluindo vazias, com badge Matriz/Filial e Editar) ---- */
function renderUnidadesDoCliente() {
  var container = document.getElementById('vc-unidades-list');
  if (!container) return;
  var cliente = getClienteAtual();
  if (!cliente) {
    container.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhum cliente selecionado.</p>';
    return;
  }
  var us = (cliente.units && Array.isArray(cliente.units)) ? cliente.units : [];
  var html = '';
  if (!us.length) {
    html = '<p style="color:var(--text3);font-size:12px;">Nenhuma unidade cadastrada.</p>';
  } else {
    for (var i = 0; i < us.length; i++) {
      var u = us[i];
      var tipo = u.tipo === 'matriz'
        ? '<span style="font-size:9px;color:var(--cyan);background:var(--cyan4);padding:2px 8px;border-radius:4px;font-weight:700;">MATRIZ</span>'
        : '<span style="font-size:9px;color:var(--text3);background:var(--navy);padding:2px 8px;border-radius:4px;font-weight:700;">FILIAL</span>';
      var nome = u.name || u.nome || ('Unidade ' + (i + 1));
      var endereco = u.address || u.endereco || u.cidade || '';
      var login = u.login || u.email || '';
      html += '<div style="background:var(--navy3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;">';
      html += '<div style="display:flex;justify-content:space-between;align-items:center;">';
      html += '<div style="display:flex;align-items:center;gap:8px;"><strong style="color:var(--text);font-size:12px;">' + zeepEsc(nome) + '</strong>' + tipo + '</div>';
      html += '<div style="display:flex;gap:6px;">';
      html += '<button class="btn btn-ghost btn-sm" data-idx="' + i + '" onclick="editarUnidadeCliente(this)">Editar</button>';
      html += '<button class="btn btn-danger btn-sm" data-idx="' + i + '" onclick="excluirUnidadeCliente(this)">Excluir</button>';
      html += '</div>';
      html += '</div>';
      html += '<div style="font-size:10px;color:var(--text2);margin-top:4px;">' + zeepEsc(endereco || 'Endereço não preenchido') + '</div>';
      html += '<div style="font-size:10px;color:var(--text3);margin-top:2px;">Login: ' + zeepEsc(login || '—') + '</div>';
      html += '</div>';
    }
  }
  container.innerHTML = html;
}

/* ---- Editar unidade (funciona com unidades vazias) ---- */
function editarUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units || !cliente.units[idx]) return;
  var u = cliente.units[idx];
  var unitId = u.id || u.unit_id || u.uuid || '';
  if (!unitId) { alert('Esta unidade ainda não tem ID no Supabase. Crie-a pelo backend primeiro.'); return; }

  var nome = prompt('Nome da unidade:', u.name || u.nome || '');
  if (nome === null) return;
  var endereco = prompt('Endereço:', u.address || u.endereco || '');
  if (endereco === null) return;
  var email = prompt('E-mail de acesso do Player:', u.email || u.login || '');
  if (email === null) return;

  var body = { name: nome.trim(), address: endereco || null, email: email || null };

  zeepApi('PUT', '/units/' + unitId, body)
    .then(function () {
      u.name = body.name; u.address = body.address; u.email = body.email;
      renderUnidadesDoCliente();
      alert('Unidade atualizada no Supabase!');
    })
    .catch(function (e) { alert('Erro ao atualizar unidade: ' + e.message); });
}

/* Vigia: conecta a criação de cliente */
setInterval(function() {
  try { zeepConectarCriarCliente(); } catch (e) {}
}, 1200);
</script>
<script>
/* ==================== SAC — CAIXA DE MENSAGENS (CORRIGIDO) ==================== */

/* ===== CONFIGURAÇÃO SUPABASE ===== */
var ZEEP_SUPABASE_URL = '';   // ex: 'https://xxxx.supabase.co'
var ZEEP_SUPABASE_KEY = '';   // ex: 'eyJhbGciOi...'

/* ===== Estado global ===== */
var _zeepChamadosCache = null;
var _zeepSacFiltro = 'todos';

/* ---- Busca chamados: Supabase primeiro, fallback clientes reais ---- */
function zeepBuscarChamados(callback) {
  if (ZEEP_SUPABASE_URL && ZEEP_SUPABASE_KEY) {
    fetch(ZEEP_SUPABASE_URL + '/rest/v1/chamados?select=*', {
      headers: { 'apikey': ZEEP_SUPABASE_KEY, 'Authorization': 'Bearer ' + ZEEP_SUPABASE_KEY }
    })
    .then(function(r) { return r.json(); })
    .then(function(dados) {
      callback((Array.isArray(dados) && dados.length) ? zeepNormalizarChamados(dados) : zeepChamadosFallback());
    })
    .catch(function() { callback(zeepChamadosFallback()); });
  } else {
    callback(zeepChamadosFallback());
  }
}

/* ---- Normaliza chamados do Supabase ---- */
function zeepNormalizarChamados(lista) {
  return lista.map(function(c, i) {
    return {
      id: String(c.id || 'sac-' + i),
      clienteNome: c.cliente_nome || c.clienteNome || ('Cliente ' + (i + 1)),
      plano: c.plano || 'Business',
      assunto: c.assunto || 'Suporte técnico',
      prioridade: c.prioridade || 'Média',
      status: c.status || 'aberto',
      mensagens: (c.mensagens && Array.isArray(c.mensagens)) ? c.mensagens : [
        { de: 'cliente', texto: 'Olá, preciso de ajuda com o player Zeep.' },
        { de: 'suporte', texto: 'Olá! Como podemos ajudar?' }
      ]
    };
  });
}

/* ---- Fallback: gera chamados a partir dos clientes reais ---- */
function zeepChamadosFallback() {
  if (_zeepChamadosCache && _zeepChamadosCache.length) {
    return _zeepChamadosCache;
  }
  var clientes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) clientes = clientes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) clientes = clientes.concat(window.db.clientes);
    }
  } catch (e) {}
  var assuntos = ['Dúvida de uso do App Zeep', 'Falha de reprodução', 'Atualização do player', 'Ajuste de curadoria', 'Vinheta personalizada', 'Suporte técnico'];
  var prioridades = ['Alta', 'Média', 'Baixa'];
  var chamados = [];
  for (var i = 0; i < clientes.length; i++) {
    var c = clientes[i];
    var nome = c.nome || c.name || ('Cliente ' + (i + 1));
    var plano = c.plano || c.plan || 'Business';
    var nChamados = 1 + (i % 2);
    for (var j = 0; j < nChamados; j++) {
      var aberto = (i + j) % 2 === 0;
      chamados.push({
        id: 'sac-' + i + '-' + j,
        clienteNome: nome,
        plano: plano,
        assunto: assuntos[(i + j) % assuntos.length],
        prioridade: prioridades[(i + j) % 3],
        status: aberto ? 'aberto' : 'resolvido',
        mensagens: [
          { de: 'cliente', texto: 'Olá, preciso de ajuda com o player Zeep.' },
          { de: 'suporte', texto: 'Olá! Como podemos ajudar?' }
        ]
      });
    }
  }
  _zeepChamadosCache = chamados;
  return chamados;
}

/* ===== RENDER ===== */
function zeepRenderSAC() {
  var sacModule = document.getElementById('sac');
  if (!sacModule) return;

  /* Se já montou uma vez, NÃO remonta (preserva a conversa aberta) */
  if (sacModule.getAttribute('data-zeep-sac-pronto')) return;

  var chamados = _zeepChamadosCache || zeepChamadosFallback();
  if (!chamados || !chamados.length) return;

  zeepMontarSAC(sacModule, chamados);
  sacModule.setAttribute('data-zeep-sac-pronto', '1');
}

/* ---- Monta: cards coloridos + lista + chat ---- */
function zeepMontarSAC(sacModule, chamados) {
  var abertos = 0, resolvidos = 0;
  for (var i = 0; i < chamados.length; i++) {
    if (chamados[i].status === 'aberto') abertos++;
    else resolvidos++;
  }
  var total = chamados.length;
  var cardSac = document.getElementById('card-sac');
  if (cardSac) cardSac.textContent = String(abertos);

  var cards = document.createElement('div');
  cards.className = 'zeep-sac-cards';
  cards.style.cssText = 'display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:24px;';
  cards.innerHTML =
    '<div class="card-metric zeep-sac-card" data-filtro="aberto" onclick="zeepFiltrarSAC(\'aberto\')" style="cursor:pointer;background:rgba(231,76,60,0.10);border:1px solid rgba(231,76,60,0.35);border-radius:12px;padding:20px;">' +
      '<p style="font-size:12px;color:var(--red);margin-bottom:8px;">Tickets Abertos</p>' +
      '<h3 id="zeep-card-abertos" style="font-size:24px;font-weight:700;color:var(--red);">' + abertos + '</h3>' +
    '</div>' +
    '<div class="card-metric zeep-sac-card" data-filtro="resolvido" onclick="zeepFiltrarSAC(\'resolvido\')" style="cursor:pointer;background:rgba(46,204,113,0.10);border:1px solid rgba(46,204,113,0.35);border-radius:12px;padding:20px;">' +
      '<p style="font-size:12px;color:var(--green);margin-bottom:8px;">Resolvidos Hoje</p>' +
      '<h3 id="zeep-card-resolvidos" style="font-size:24px;font-weight:700;color:var(--green);">' + resolvidos + '</h3>' +
    '</div>' +
    '<div class="card-metric zeep-sac-card" data-filtro="todos" onclick="zeepFiltrarSAC(\'todos\')" style="cursor:pointer;background:rgba(60,186,216,0.10);border:1px solid rgba(60,186,216,0.35);border-radius:12px;padding:20px;">' +
      '<p style="font-size:12px;color:var(--cyan);margin-bottom:8px;">Todos os Chats</p>' +
      '<h3 id="zeep-card-todos" style="font-size:24px;font-weight:700;color:var(--cyan);">' + total + '</h3>' +
    '</div>';

  var wrapper = document.createElement('div');
  wrapper.className = 'zeep-sac-wrapper';
  wrapper.style.cssText = 'display:flex;gap:0;background:var(--navy2);border:1px solid var(--border);border-radius:12px;overflow:hidden;min-height:60vh;';

  var lista = document.createElement('div');
  lista.className = 'zeep-sac-lista';
  lista.style.cssText = 'width:320px;min-width:320px;border-right:1px solid var(--border);max-height:70vh;overflow-y:auto;';

  var chat = document.createElement('div');
  chat.className = 'zeep-sac-chat';
  chat.style.cssText = 'flex:1;display:flex;flex-direction:column;';
  chat.innerHTML = '<div style="flex:1;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:13px;padding:40px;">Selecione uma conversa ao lado</div>' +
    '<div style="padding:16px;border-top:1px solid var(--border);display:flex;gap:10px;">' +
      '<input type="text" placeholder="Digite sua mensagem..." style="flex:1;background:var(--navy);border:1px solid var(--border2);padding:12px;border-radius:8px;color:var(--text);outline:none;">' +
      '<button class="btn btn-primary" onclick="zeepEnviarMensagemSAC(this)">Enviar</button>' +
    '</div>';

  wrapper.appendChild(lista);
  wrapper.appendChild(chat);
  sacModule.appendChild(cards);
  sacModule.appendChild(wrapper);

  zeepMarcarCardAtivo();
  zeepRenderListaSAC();
}

/* ---- Renderiza a LISTA de conversas (lado esquerdo) + botão Apagar ---- */
function zeepRenderListaSAC() {
  var lista = document.querySelector('.zeep-sac-lista');
  if (!lista) return;
  var chamados = _zeepChamadosCache || zeepChamadosFallback();
  var filtro = _zeepSacFiltro || 'todos';
  var filtrados = chamados;
  if (filtro === 'aberto') filtrados = chamados.filter(function(x) { return x.status === 'aberto'; });
  else if (filtro === 'resolvido') filtrados = chamados.filter(function(x) { return x.status === 'resolvido'; });

  var mostrarApagar = (filtro === 'resolvido' || filtro === 'todos');
  var html = '<div style="padding:16px;border-bottom:1px solid var(--border);font-size:12px;font-weight:700;color:var(--text);">Conversas (' + filtrados.length + ')</div>';
  if (!filtrados.length) {
    html += '<p style="padding:20px;font-size:12px;color:var(--text3);text-align:center;">Nenhuma conversa neste filtro.</p>';
  } else {
    for (var i = 0; i < filtrados.length; i++) {
      var ch = filtrados[i];
      var corP = ch.prioridade === 'Alta' ? 'var(--red)' : (ch.prioridade === 'Média' ? 'var(--amber)' : 'var(--green)');
      var corS = ch.status === 'aberto' ? 'var(--green)' : 'var(--text3)';
      html += '<div class="zeep-sac-item" data-id="' + ch.id + '" onclick="zeepAbrirConversaSAC(\'' + ch.id + '\')" style="padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer;">' +
        '<div style="font-size:13px;font-weight:600;color:var(--text);">' + zeepEsc(ch.clienteNome) + '</div>' +
        '<div style="font-size:11px;color:var(--text2);margin-top:2px;">' + zeepEsc(ch.assunto) + '</div>' +
        '<div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;">' +
          '<span class="zeep-prioridade" style="font-size:9px;color:' + corP + ';border:1px solid ' + corP + ';padding:1px 6px;border-radius:4px;">' + ch.prioridade + '</span>' +
          '<span class="zeep-status" style="font-size:9px;color:' + corS + ';border:1px solid ' + corS + ';padding:1px 6px;border-radius:4px;text-transform:uppercase;">' + ch.status + '</span>' +
          '<span style="font-size:9px;color:var(--text3);border:1px solid var(--border2);padding:1px 6px;border-radius:4px;">' + zeepEsc(ch.plano) + '</span>' +
        '</div>';
      if (mostrarApagar) {
        html += '<button class="btn btn-danger btn-sm" onclick="event.stopPropagation();zeepApagarConversaSAC(\'' + ch.id + '\')" style="margin-top:10px;width:100%;justify-content:center;">Apagar</button>';
      }
      html += '</div>';
    }
  }
  lista.innerHTML = html;
}

/* ---- Filtro por card (ÚNICA versão) ---- */
function zeepFiltrarSAC(filtro) {
  _zeepSacFiltro = filtro;
  zeepRenderListaSAC();
  zeepMarcarCardAtivo();
}

/* ---- Marca o card ativo (ÚNICA versão) ---- */
function zeepMarcarCardAtivo() {
  var cards = document.querySelectorAll('.zeep-sac-card');
  for (var i = 0; i < cards.length; i++) {
    var ativo = cards[i].getAttribute('data-filtro') === (_zeepSacFiltro || 'todos');
    cards[i].style.boxShadow = ativo ? '0 0 15px rgba(60,186,216,0.25)' : 'none';
    cards[i].style.transform = ativo ? 'translateY(-2px)' : 'none';
  }
}

/* ---- Atualiza os números dos cards ---- */
function zeepAtualizarCardsSAC() {
  var chamados = _zeepChamadosCache || [];
  var abertos = 0, resolvidos = 0;
  for (var i = 0; i < chamados.length; i++) {
    if (chamados[i].status === 'aberto') abertos++;
    else resolvidos++;
  }
  var ca = document.getElementById('zeep-card-abertos'); if (ca) ca.textContent = String(abertos);
  var cr = document.getElementById('zeep-card-resolvidos'); if (cr) cr.textContent = String(resolvidos);
  var ct = document.getElementById('zeep-card-todos'); if (ct) ct.textContent = String(chamados.length);
  var cardSac = document.getElementById('card-sac'); if (cardSac) cardSac.textContent = String(abertos);
}

/* ---- APAGA uma conversa ---- */
function zeepApagarConversaSAC(id) {
  if (!confirm('Apagar esta conversa?')) return;
  var chamados = _zeepChamadosCache || zeepChamadosFallback();
  for (var i = 0; i < chamados.length; i++) {
    if (chamados[i].id === id) { chamados.splice(i, 1); break; }
  }
  _zeepChamadosCache = chamados;
  zeepAtualizarCardsSAC();
  zeepRenderListaSAC();
  var chat = document.querySelector('.zeep-sac-chat');
  if (chat && chat.getAttribute('data-sac-id') === id) {
    chat.removeAttribute('data-sac-id');
    chat.innerHTML = '<div style="flex:1;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:13px;padding:40px;">Selecione uma conversa ao lado</div>' +
      '<div style="padding:16px;border-top:1px solid var(--border);display:flex;gap:10px;">' +
        '<input type="text" placeholder="Digite sua mensagem..." style="flex:1;background:var(--navy);border:1px solid var(--border2);padding:12px;border-radius:8px;color:var(--text);outline:none;">' +
        '<button class="btn btn-primary" onclick="zeepEnviarMensagemSAC(this)">Enviar</button>' +
      '</div>';
  }
  alert('Conversa apagada!');
}

/* ===== CHAT ===== */
function zeepAbrirConversaSAC(id) {
  var chamados = _zeepChamadosCache || zeepChamadosFallback();
  var ch = null;
  for (var i = 0; i < chamados.length; i++) if (chamados[i].id === id) { ch = chamados[i]; break; }
  if (!ch) return;
  var itens = document.querySelectorAll('.zeep-sac-item');
  for (var j = 0; j < itens.length; j++) {
    itens[j].style.background = itens[j].getAttribute('data-id') === id ? 'var(--navy3)' : 'transparent';
  }
  var chat = document.querySelector('.zeep-sac-chat');
  if (!chat) return;
  var html = '<div style="padding:20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">' +
    '<div>' +
      '<strong style="color:var(--text);font-size:14px;">' + zeepEsc(ch.clienteNome) + '</strong>' +
      ' <span style="color:var(--text3);">· ' + zeepEsc(ch.plano) + '</span>' +
      '<div style="margin-top:4px;font-size:11px;color:var(--text3);">' + zeepEsc(ch.assunto) + '</div>' +
    '</div>' +
    '<div style="display:flex;gap:8px;flex-wrap:wrap;">' +
      '<button class="btn btn-ghost btn-sm" onclick="zeepMudarPrioridadeSAC(\'' + ch.id + '\')">Prioridade: ' + ch.prioridade + '</button>' +
      '<button class="btn btn-danger btn-sm" onclick="zeepEncerrarChamadaSAC(\'' + ch.id + '\')">Encerrar chamada</button>' +
    '</div>' +
  '</div>';
  html += '<div style="flex:1;overflow-y:auto;padding:20px;">';
  for (var m = 0; m < ch.mensagens.length; m++) {
    var msg = ch.mensagens[m];
    var alinh = msg.de === 'cliente' ? 'flex-start' : 'flex-end';
    var cor = msg.de === 'cliente' ? 'var(--navy3)' : 'var(--cyan4)';
    html += '<div style="display:flex;justify-content:' + alinh + ';padding:6px 0;">' +
      '<div style="background:' + cor + ';border:1px solid var(--border);border-radius:10px;padding:10px 14px;max-width:70%;font-size:12px;color:var(--text);">' + zeepEsc(msg.texto) + '</div></div>';
  }
  html += '</div>';
  html += '<div style="padding:16px;border-top:1px solid var(--border);display:flex;gap:10px;">' +
    '<input type="text" id="zeep-sac-input" placeholder="Digite sua mensagem..." style="flex:1;background:var(--navy);border:1px solid var(--border2);padding:12px;border-radius:8px;color:var(--text);outline:none;">' +
    '<button class="btn btn-primary" onclick="zeepEnviarMensagemSAC(this)">Enviar</button>' +
  '</div>';
  chat.innerHTML = html;
  chat.setAttribute('data-sac-id', ch.id);
}

/* ---- Envia mensagem ---- */
function zeepEnviarMensagemSAC(btn) {
  var input = document.getElementById('zeep-sac-input');
  if (!input || !input.value.trim()) return;
  var chat = document.querySelector('.zeep-sac-chat');
  if (!chat) return;
  var msgs = chat.querySelector('div[style*="overflow-y:auto"]');
  if (msgs) {
    msgs.innerHTML += '<div style="display:flex;justify-content:flex-end;padding:6px 0;">' +
      '<div style="background:var(--cyan4);border:1px solid var(--border);border-radius:10px;padding:10px 14px;max-width:70%;font-size:12px;color:var(--text);">' + zeepEsc(input.value.trim()) + '</div></div>';
  }
  input.value = '';
}

/* ---- Muda a prioridade ---- */
function zeepMudarPrioridadeSAC(id) {
  var chamados = _zeepChamadosCache || zeepChamadosFallback();
  var ch = null;
  for (var i = 0; i < chamados.length; i++) if (chamados[i].id === id) { ch = chamados[i]; break; }
  if (!ch) return;
  var opcoes = ['Alta', 'Média', 'Baixa'];
  var nova = opcoes[(opcoes.indexOf(ch.prioridade) + 1) % 3];
  ch.prioridade = nova;
  var itens = document.querySelectorAll('.zeep-sac-item');
  for (var j = 0; j < itens.length; j++) {
    if (itens[j].getAttribute('data-id') === id) {
      var badge = itens[j].querySelector('.zeep-prioridade');
      if (badge) {
        var corP = nova === 'Alta' ? 'var(--red)' : (nova === 'Média' ? 'var(--amber)' : 'var(--green)');
        badge.textContent = nova; badge.style.color = corP; badge.style.borderColor = corP;
      }
    }
  }
  var chat = document.querySelector('.zeep-sac-chat');
  if (chat) {
    var btn = chat.querySelector('button[onclick*="zeepMudarPrioridadeSAC"]');
    if (btn) btn.textContent = 'Prioridade: ' + nova;
  }
  alert('Prioridade alterada para ' + nova + '!');
}

/* ---- Encerra chamada ---- */
function zeepEncerrarChamadaSAC(id) {
  if (!confirm('Encerrar esta chamada?')) return;
  var chamados = _zeepChamadosCache || zeepChamadosFallback();
  var ch = null;
  for (var i = 0; i < chamados.length; i++) if (chamados[i].id === id) { ch = chamados[i]; break; }
  if (!ch) return;
  ch.status = 'resolvido';
  zeepAtualizarCardsSAC();
  zeepRenderListaSAC();
  var chat = document.querySelector('.zeep-sac-chat');
  if (chat) {
    chat.innerHTML = '<div style="flex:1;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:13px;padding:40px;">Chamada encerrada. Selecione outra conversa.</div>' +
      '<div style="padding:16px;border-top:1px solid var(--border);display:flex;gap:10px;">' +
        '<input type="text" placeholder="Digite sua mensagem..." style="flex:1;background:var(--navy);border:1px solid var(--border2);padding:12px;border-radius:8px;color:var(--text);outline:none;">' +
        '<button class="btn btn-primary" onclick="zeepEnviarMensagemSAC(this)">Enviar</button>' +
      '</div>';
  }
  alert('Chamada encerrada!');
}

/* ===== Vigia ÚNICO ===== */
setInterval(function() {
  try {
    var sacModule = document.getElementById('sac');
    if (sacModule && sacModule.classList.contains('active')) {
      zeepRenderSAC();
    }
  } catch (e) {}
}, 1500);
</script>
<script>

/* ============ CLIQUE NOS CARDS DA VISÃO GERAL (Faturamento → Pagamentos, SAC → SAC) ============ */
function zeepAcharItemSidebar(texto) {
  var items = document.querySelectorAll('.nav-item');
  var alvo = (texto || '').trim().toLowerCase();
  for (var i = 0; i < items.length; i++) {
    if ((items[i].textContent || '').trim().toLowerCase() === alvo) return items[i];
  }
  return null;
}

function zeepNavegar(id, titulo, textoSidebar) {
  var modulos = document.querySelectorAll('.module');
  for (var i = 0; i < modulos.length; i++) modulos[i].classList.remove('active');
  var mod = document.getElementById(id);
  if (mod) mod.classList.add('active');

  var tituloEl = document.getElementById('page-title');
  if (tituloEl) tituloEl.textContent = titulo;

  var item = zeepAcharItemSidebar(textoSidebar);
  var items = document.querySelectorAll('.nav-item');
  for (var j = 0; j < items.length; j++) items[j].classList.remove('active');
  if (item) item.classList.add('active');

  if (id === 'sac') {
    setTimeout(function () {
      try { if (typeof zeepRenderSAC === 'function') zeepRenderSAC(); } catch (e) {}
    }, 150);
  }
}

function zeepConectarCardsVisaoGeral() {
  var map = {
    'faturamento':      { id: 'pagamentos', titulo: 'Pagamentos', sidebar: 'Pagamentos' },
    'sac':              { id: 'sac', titulo: 'SAC', sidebar: 'SAC' },
    'clientes ativos':  { id: 'clientes', titulo: 'Clientes', sidebar: 'Clientes' }
  };
  var cards = document.querySelectorAll('.card-metric');
  for (var i = 0; i < cards.length; i++) {
    var card = cards[i];
    if (card.getAttribute('data-zeep-card')) continue;
    var p = card.querySelector('p');
    if (!p) continue;
    var label = p.textContent.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    var destino = map[label];
    if (destino) {
      card.setAttribute('data-zeep-card', destino.id);
      card.style.cursor = 'pointer';
      card.onclick = (function (d) {
        return function () { zeepNavegar(d.id, d.titulo, d.sidebar); };
      })(destino);
    }
  }
}

/* ---- Vigia: conecta os cards da Visão Geral ---- */
setInterval(function() {
  try { zeepConectarCardsVisaoGeral(); } catch (e) {}
}, 1200);
</script>
<script>
/* ============ HISTÓRICO DE AÇÕES — BLOCO ÚNICO FINAL (busca sem travar) ============ */

/* ===== 1. ESCAPE ===== */
if (typeof zeepEsc !== 'function') {
  function zeepEsc(t) {
    return String(t == null ? '' : t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
}

/* ===== 2. ARMAZENAMENTO ===== */
var ZEEP_HIST_KEY = 'zeep_historico_final';
var _zeepHist = [];
var _zeepHistBusca = '';
var _zeepHistUltimos = {};
var ZEEP_HIST_DEDUPE_MS = 10000;

function zeepHistCarregar() {
  try {
    var raw = localStorage.getItem(ZEEP_HIST_KEY);
    _zeepHist = raw ? JSON.parse(raw) : [];
    if (!Array.isArray(_zeepHist)) _zeepHist = [];
    var vistos = {};
    _zeepHist = _zeepHist.filter(function(r) {
      var chave = (r.acao || '') + '|' + (r.entidade || '') + '|' + (r.detalhe || '');
      if (vistos[chave]) return false;
      vistos[chave] = true;
      return true;
    });
  } catch (e) { _zeepHist = []; }
}
zeepHistCarregar();

function zeepHistSalvar() {
  try { localStorage.setItem(ZEEP_HIST_KEY, JSON.stringify(_zeepHist.slice(0, 300))); } catch (e) {}
}

/* ===== 3. REGISTRO COM ANTI-DUPLICAÇÃO ===== */
function zeepRegistrarHistorico(acao, entidade, detalhe) {
  var chave = (acao || '') + '|' + (entidade || '') + '|' + (detalhe || '');
  var agora = Date.now();
  if (_zeepHistUltimos[chave] && (agora - _zeepHistUltimos[chave]) < ZEEP_HIST_DEDUPE_MS) return null;
  _zeepHistUltimos[chave] = agora;
  var chaves = Object.keys(_zeepHistUltimos);
  if (chaves.length > 200) { _zeepHistUltimos = {}; _zeepHistUltimos[chave] = agora; }
  var d = new Date();
  _zeepHist.unshift({
    acao: acao || 'Ação',
    entidade: entidade || '',
    detalhe: detalhe || '',
    usuario: 'Italo Vieira',
    data: d.toLocaleDateString('pt-BR'),
    hora: d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
  });
  zeepHistSalvar();
  var sec = document.getElementById('historico');
  if (sec && sec.classList.contains('active')) zeepRenderLista();
  return _zeepHist[0];
}

/* ===== 4. GARANTE A SECTION ===== */
function zeepGarantirSectionHistorico() {
  var sec = document.getElementById('historico');
  if (sec) return sec;
  sec = document.createElement('section');
  sec.id = 'historico';
  sec.className = 'module';
  var content = document.querySelector('.content') || document.querySelector('main') || document.body;
  content.appendChild(sec);
  return sec;
}

/* ===== 5. MONTA A SECTION UMA VEZ (título + busca + lista) ===== */
function Historico() {
  var sec = zeepGarantirSectionHistorico();
  sec.innerHTML = '';

  var t = document.createElement('div');
  t.className = 'section-title';
  t.textContent = 'Histórico de Ações';
  sec.appendChild(t);

  var busca = document.createElement('input');
  busca.type = 'text';
  busca.placeholder = 'Buscar por cliente ou funcionário...';
  busca.style.cssText = 'width:100%;max-width:420px;margin:0 0 20px 0;background:var(--navy);border:1px solid var(--border2);padding:12px;border-radius:8px;color:var(--text);outline:none;';
  busca.value = _zeepHistBusca || '';
  busca.addEventListener('input', function() {
    _zeepHistBusca = this.value;
    zeepRenderLista();
  });
  sec.appendChild(busca);

  var lista = document.createElement('div');
  lista.id = 'zeep-hist-list';
  sec.appendChild(lista);

  zeepRenderLista();
}

/* ===== 6. ATUALIZA SÓ A LISTA (NUNCA recria o campo) ===== */
function zeepRenderLista() {
  var lista = document.getElementById('zeep-hist-list');
  if (!lista) return;

  var termo = (_zeepHistBusca || '').trim().toLowerCase();
  var filtrados = _zeepHist;
  if (termo) {
    filtrados = _zeepHist.filter(function(r) {
      var alvo = ((r.entidade || '') + ' ' + (r.usuario || '') + ' ' + (r.acao || '')).toLowerCase();
      return alvo.indexOf(termo) > -1;
    });
  }

  var html = '';
  if (!filtrados.length) {
    html = '<p style="padding:20px;color:var(--text3);font-size:13px;">' +
      (termo ? 'Nenhuma ação encontrada para "' + zeepEsc(termo) + '".' : 'Nenhuma ação registrada ainda. Faça uma ação no dashboard (criar cliente, playlist, SAC...) e ela aparecerá aqui.') +
      '</p>';
  } else {
    for (var i = 0; i < filtrados.length; i++) {
      var r = filtrados[i];
      html += '<div style="display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--border);">' +
        '<div style="width:10px;height:10px;border-radius:50%;background:var(--cyan);margin-top:6px;flex-shrink:0;"></div>' +
        '<div style="flex:1;">' +
          '<div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;">' +
            '<strong style="font-size:13px;color:var(--text);">' + zeepEsc(r.acao) + '</strong>' +
            '<span style="font-size:11px;color:var(--text3);">' + r.data + ' · ' + r.hora + '</span>' +
          '</div>' +
          (r.entidade ? '<div style="font-size:12px;color:var(--text2);margin-top:4px;">' + zeepEsc(r.entidade) + '</div>' : '') +
          (r.detalhe ? '<div style="font-size:12px;color:var(--text3);margin-top:2px;">' + zeepEsc(r.detalhe) + '</div>' : '') +
          '<div style="font-size:11px;color:var(--cyan);margin-top:6px;">Feito por: ' + zeepEsc(r.usuario) + '</div>' +
        '</div>' +
      '</div>';
    }
  }
  lista.innerHTML = html;
}

/* ===== 7. HOOKS DAS FUNÇÕES REAIS ===== */
function zeepNomeClienteAtivo() {
  try {
    var inputs = document.querySelectorAll('input');
    for (var j = 0; j < inputs.length; j++) {
      var inp = inputs[j];
      if (inp.offsetParent === null) continue;
      if (!inp.value || !inp.value.trim()) continue;
      var id = ((inp.id || '') + ' ' + (inp.name || '') + ' ' + (inp.placeholder || '') + ' ' + (inp.getAttribute('data-label') || '')).toLowerCase();
      var ehNome = /nome|cliente|empresa|razao|razão|estabelecimento|negocio|marca/.test(id);
      if (ehNome) return inp.value.trim().slice(0, 40);
    }
    var modais = document.querySelectorAll('.modal');
    for (var i = 0; i < modais.length; i++) {
      var m = modais[i];
      var visivel = (m.classList && m.classList.contains('active')) || (m.style && m.style.display && m.style.display !== 'none');
      if (!visivel) continue;
      var t = zeepAcharTituloCliente(m);
      if (t) return t;
    }
  } catch (e) {}
  return 'Cliente';
}

function zeepAcharTituloCliente(modal) {
  try {
    var heads = modal.querySelectorAll('h1, h2, h3, h4, h5, .modal-header strong, .modal-title, .client-name, .cliente-nome');
    for (var i = 0; i < heads.length; i++) {
      var txt = (heads[i].textContent || '').trim();
      if (!txt || txt.length < 2 || txt.length > 60) continue;
      var baixo = txt.toLowerCase();
      if (baixo.charAt(0) === '+') continue;
      if (/novo cliente|nova unidade|nova playlist|editar|excluir|apagar|adicionar|salvar|cancelar|fechar|voltar|buscar|pesquisar|filtro|pagamentos recentes|unidades do cliente|playlists do cliente/.test(baixo)) continue;
      return txt.slice(0, 40);
    }
  } catch (e) {}
  return '';
}

function zeepNomePlaylist(id) {
  try {
    var el = document.querySelector('[data-playlist-id="' + id + '"] h4, [data-playlist-id="' + id + '"] h5, [data-id="' + id + '"] h4, [data-id="' + id + '"] h5');
    if (el && el.textContent.trim()) return el.textContent.trim().slice(0, 40);
  } catch (e) {}
  return 'Playlist';
}

function zeepHookExato(nome, acao, obterInfo) {
  try {
    var fn = window[nome];
    if (typeof fn !== 'function') return;
    if (fn.__zeepHook) return;
    fn.__zeepHook = true;
    window[nome] = function() {
      var info = null;
      try { info = (typeof obterInfo === 'function') ? (obterInfo.apply(this, arguments) || {}) : {}; } catch (e) { info = null; }
      var resultado = fn.apply(this, arguments);
      try { zeepRegistrarHistorico(acao, (info && info.entidade) || '', (info && info.detalhe) || ''); } catch (e) {}
      return resultado;
    };
  } catch (e) {}
}

function zeepAplicarHooksReais() {
  zeepHookExato('criarClienteManual', 'Novo Cliente Cadastrado', function() {
    return { entidade: zeepNomeClienteAtivo(), detalhe: 'Cadastro manual' };
  });
  zeepHookExato('criarPlaylistCliente', 'Playlist Criada', function() {
    return { entidade: zeepNomeClienteAtivo(), detalhe: 'Nova playlist criada' };
  });
  zeepHookExato('renamePlaylist', 'Playlist Renomeada', function(id, name) {
    return { entidade: zeepNomeClienteAtivo(), detalhe: 'Playlist: ' + (name || zeepNomePlaylist(id)) };
  });
  zeepHookExato('updatePlaylistTimeInicio', 'Horário de Início Alterado', function(id, time) {
    return { entidade: zeepNomeClienteAtivo(), detalhe: 'Playlist: ' + zeepNomePlaylist(id) + ' · Início: ' + time };
  });
  zeepHookExato('updatePlaylistTimeFim', 'Horário de Fim Alterado', function(id, time) {
    return { entidade: zeepNomeClienteAtivo(), detalhe: 'Playlist: ' + zeepNomePlaylist(id) + ' · Fim: ' + time };
  });
  zeepHookExato('openAddMusicas', 'Adicionar Músicas', function(playlistId) {
    return { entidade: zeepNomeClienteAtivo(), detalhe: 'Playlist: ' + zeepNomePlaylist(playlistId) };
  });
  zeepHookExato('removeFromPlaylist', 'Música Removida da Playlist', function(playlistId, trackKey) {
    return { entidade: zeepNomeClienteAtivo(), detalhe: 'Playlist: ' + zeepNomePlaylist(playlistId) + ' · Música: ' + (trackKey || '') };
  });
}

/* ===== 8. CONECTA NA NAV() ===== */
(function() {
  var navOriginal = window.nav || function() {};
  window.nav = function(id, el) {
    navOriginal(id, el);
    if (id === 'historico') setTimeout(Historico, 60);
  };
})();

/* ===== 9. VIGIA — SÓ ATUALIZA A LISTA, NUNCA RECRIA O CAMPO ===== */
zeepGarantirSectionHistorico();
setInterval(function() {
  try {
    zeepAplicarHooksReais();
    var sec = document.getElementById('historico');
    if (sec && sec.classList.contains('active')) zeepRenderLista();
  } catch (e) {}
}, 1200);
</script>
<script>
/* ===== Configurações ===== */
var _zeepFuncionarios = [
  { id: 1, nome: 'Italo Vieira', email: 'italo@zeep.com.br', perfil: 'admin', ativo: true },
  { id: 2, nome: 'Ana Operadora', email: 'ana@zeep.com.br', perfil: 'oper', ativo: true }
];

function zeepConfigAba(nome, el) {
  var tabs = document.querySelectorAll('.config-tab');
  for (var i = 0; i < tabs.length; i++) tabs[i].classList.remove('active');
  el.classList.add('active');
  document.getElementById('config-funcionarios').classList.toggle('active', nome === 'funcionarios');
  document.getElementById('config-chaves').classList.toggle('active', nome === 'chaves');
  if (nome === 'funcionarios') zeepRenderFuncionarios();
}

function zeepRenderFuncionarios() {
  var tbody = document.getElementById('zeep-func-tbody');
  if (!tbody) return;
  var html = '';
  for (var i = 0; i < _zeepFuncionarios.length; i++) {
    var f = _zeepFuncionarios[i];
    var badge = f.perfil === 'admin' ? '<span class="role-badge role-admin">Administrador</span>' : '<span class="role-badge role-oper">Operador</span>';
    var dot = f.ativo ? '<span class="status-dot status-on"></span>Ativo' : '<span class="status-dot status-off"></span>Inativo';
    html += '<tr>' +
      '<td><strong>' + zeepEsc(f.nome) + '</strong></td>' +
      '<td>' + zeepEsc(f.email) + '</td>' +
      '<td>' + badge + '</td>' +
      '<td>' + dot + '</td>' +
      '<td style="text-align:right;">' +
        '<button class="btn btn-ghost btn-sm" onclick="zeepEditarFuncionario(' + f.id + ')">Editar</button> ' +
        '<button class="btn btn-danger btn-sm" onclick="zeepExcluirFuncionario(' + f.id + ')">Excluir</button>' +
      '</td>' +
    '</tr>';
  }
  tbody.innerHTML = html;
}

function zeepNovoFuncionario() {
  var nome = prompt('Nome do funcionário:');
  if (!nome) return;
  var email = prompt('E-mail:');
  if (!email) return;
  var perfil = confirm('Perfil: OK = Administrador | Cancelar = Operador') ? 'admin' : 'oper';
  _zeepFuncionarios.push({ id: Date.now(), nome: nome, email: email, perfil: perfil, ativo: true });
  zeepRenderFuncionarios();
}

function zeepEditarFuncionario(id) {
  var f = null;
  for (var i = 0; i < _zeepFuncionarios.length; i++) if (_zeepFuncionarios[i].id === id) { f = _zeepFuncionarios[i]; break; }
  if (!f) return;
  var novoNome = prompt('Nome:', f.nome);
  if (novoNome) f.nome = novoNome;
  var novoEmail = prompt('E-mail:', f.email);
  if (novoEmail) f.email = novoEmail;
  var novoPerfil = confirm('Perfil atual: ' + (f.perfil === 'admin' ? 'Administrador' : 'Operador') + '. OK = trocar para ' + (f.perfil === 'admin' ? 'Operador' : 'Administrador') + ' | Cancelar = manter') ? (f.perfil === 'admin' ? 'oper' : 'admin') : f.perfil;
  f.perfil = novoPerfil;
  f.ativo = !confirm('Ativar/Desativar: OK = desativar | Cancelar = manter ativo') ? f.ativo : !f.ativo;
  zeepRenderFuncionarios();
}

function zeepExcluirFuncionario(id) {
  if (!confirm('Excluir este funcionário?')) return;
  _zeepFuncionarios = _zeepFuncionarios.filter(function(f) { return f.id !== id; });
  zeepRenderFuncionarios();
}

function zeepMostrarChave(id, btn) {
  var input = document.getElementById(id);
  if (!input) return;
  if (input.type === 'password') { input.type = 'text'; btn.textContent = '🙈'; }
  else { input.type = 'password'; btn.textContent = '👁'; }
}

function zeepSalvarChaves() {
  var chaves = {
    supabaseUrl: document.getElementById('chave-supabase-url').value,
    supabaseAnon: document.getElementById('chave-supabase-anon').value,
    r2Account: document.getElementById('chave-r2-account').value,
    r2Key: document.getElementById('chave-r2-key').value,
    r2Secret: document.getElementById('chave-r2-secret').value,
    r2Bucket: document.getElementById('chave-r2-bucket').value,
    elevenLabs: document.getElementById('chave-elevenlabs').value
  };
  localStorage.setItem('zeep_chaves', JSON.stringify(chaves));
  alert('Chaves salvas com sucesso!');
}
/* ============ VINHETAS - OPÇÃO A (SUPABASE) ============ */
var vinhetasState = { clientes: [], unidades: [] };

function zeepCarregarClientesVinhetas() {
  var sel = document.getElementById('vh-cliente');
  if (!sel) return;
  // Carrega as empresas do Supabase
  window.supabase.from('companies').select('id, name').then(function(r) {
    if (r.error) return console.error('Erro ao carregar clientes:', r.error.message);
    vinhetasState.clientes = r.data || [];
    sel.innerHTML = '<option value="">Selecione o cliente...</option>' +
      vinhetasState.clientes.map(function(c) {
        return '<option value="' + c.id + '">' + c.name + '</option>';
      }).join('');
  });
}

function zeepCarregarUnidadesVinhetas(companyId) {
  var sel = document.getElementById('vh-unidade');
  if (!sel) return;
  sel.innerHTML = '<option value="">Todas as unidades (Matriz)</option>';
  if (!companyId) return;
  window.supabase.from('units').select('id, name').eq('company_id', companyId).then(function(r) {
    if (r.error) return console.error('Erro ao carregar unidades:', r.error.message);
    vinhetasState.unidades = r.data || [];
    sel.innerHTML = '<option value="">Todas as unidades (Matriz)</option>' +
      vinhetasState.unidades.map(function(u) {
        return '<option value="' + u.id + '">' + u.name + '</option>';
      }).join('');
  });
}

function zeepEnviarVinheta() {
  var companyId = document.getElementById('vh-cliente').value;
  var unitId = document.getElementById('vh-unidade').value;
  var intervalo = document.getElementById('vh-intervalo').value || 5;
  var arquivo = document.getElementById('vh-arquivo').files[0];

  if (!companyId) return alert('Selecione o cliente.');
  if (!arquivo) return alert('Selecione o arquivo MP3.');

  var nome = arquivo.name.replace(/\.mp3$/i, '');
  var fd = new FormData();
  fd.append('company_id', companyId);
  fd.append('unit_id', unitId);
  fd.append('title', nome);
  fd.append('type', 'FIXA');
  fd.append('interval_count', intervalo);
  fd.append('file', arquivo);

  fetch(API_BASE + '/api/r2/upload-vinheta', { method: 'POST', body: fd })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success) throw new Error(res.error);
      alert('Vinheta enviada com sucesso!');
      zeepListarVinhetas();
    })
    .catch(function(err) { alert('Erro: ' + err.message); });
}

function zeepListarVinhetas() {
  var lista = document.getElementById('vh-lista');
  if (!lista) return;
  fetch(API_BASE + '/api/r2/vinhetas')
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success) throw new Error(res.error);
      var vh = res.vinhetas || [];
      if (!vh.length) { lista.innerHTML = 'Nenhuma vinheta cadastrada.'; return; }
      lista.innerHTML = vh.map(function(v) {
        var empresa = v.companies ? v.companies.name : '?';
        var unidade = v.units ? v.units.name : 'Matriz (todas)';
        return '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;border-bottom:1px solid var(--border2);">' +
          '<div><strong>' + v.title + '</strong><br><span style="font-size:11px;color:var(--text3);">' + empresa + ' · ' + unidade + ' · a cada ' + v.interval_count + ' músicas</span></div>' +
          '<audio controls preload="none" style="height:32px;" src="' + v.file_url + '"></audio>' +
        '</div>';
      }).join('');
    })
    .catch(function(err) { lista.innerHTML = 'Erro: ' + err.message; });
}

/* ============ VINHETAS DA MARCA ============ */
var vmState = { clientes: [], unidades: [] };   // CRÍTICO: sem isso nada funciona
var vmClientesPopulado = false;

function vmCarregarClientes() {
  var sel = document.getElementById('vm-cliente');
  if (!sel || vmClientesPopulado) return;

  function popularCom(lista, origem) {
    if (!lista || !lista.length) return false;
    vmState.clientes = lista.map(function (c) {
      return { id: c.id, name: c.name || c.nome || 'Cliente' };
    });
    sel.innerHTML = '<option value="">Selecione o cliente...</option>' +
      vmState.clientes.map(function (c) {
        return '<option value="' + c.id + '">' + c.name + '</option>';
      }).join('');
    vmClientesPopulado = true;
    console.log('[VM] Clientes vinheta (' + origem + '):', vmState.clientes.length);
    return true;
  }

  // Fonte canônica: o BACKEND (mesma origem dos UUIDs usados nas unidades)
  if (typeof zeepApi === 'function') {
    zeepApi('GET', '/companies')
      .then(function (r) {
        if (r && (r.companies || []).length) { popularCom(r.companies, 'api'); return; }
        if (popularCom(window.db && (window.db.clients || window.db.clientes), 'db')) return;
        setTimeout(vmCarregarClientes, 1500);
      })
      .catch(function (e) {
        console.warn('[VM] Erro ao buscar companies:', e && e.message);
        if (popularCom(window.db && (window.db.clients || window.db.clientes), 'db')) return;
        setTimeout(vmCarregarClientes, 1500);
      });
    return;
  }

  if (popularCom(window.db && (window.db.clients || window.db.clientes), 'db')) return;
  setTimeout(vmCarregarClientes, 1000);
}

/* Vigia: mantém o dropdown sincronizado (o sync pode rodar depois do load) */
setInterval(function () { try { vmCarregarClientes(); } catch (e) {} }, 2000);

function zeepListarVinhetas() {
  var lista = document.getElementById('vh-lista');
  if (!lista) return;
  fetch(API_BASE + '/api/r2/vinhetas')
    .then(function (r) { return r.json(); })
    .then(function (res) {
      if (!res.success) throw new Error(res.error);
      var vh = res.vinhetas || [];
      if (!vh.length) { lista.innerHTML = 'Nenhuma vinheta cadastrada.'; return; }
      lista.innerHTML = vh.map(function (v) {
        var key = v.file_key || v.key || '';
        var src = (key.indexOf('http') === 0) ? key : (API_BASE + '/api/r2/preview?key=' + encodeURIComponent(key));
        var titulo = v.title || v.name || key || 'Vinheta';
        var empresa = (v.companies && v.companies.name) ? v.companies.name : '—';
        var unidade = (v.units && v.units.name) ? v.units.name : 'Matriz (todas)';
        var intervalo = (v.interval_count != null) ? ' · a cada ' + v.interval_count + ' músicas' : '';
        return '<div style="display:flex;justify-content:space-between;align-items:center;padding:8px;border-bottom:1px solid var(--border2);">' +
          '<div><strong>' + escapeHtml(titulo) + '</strong><br>' +
          '<span style="font-size:11px;color:var(--text3);">' + escapeHtml(empresa) + ' · ' + escapeHtml(unidade) + intervalo + '</span></div>' +
          (src ? '<audio controls preload="none" style="height:32px;" src="' + src + '"></audio>' : '') +
        '</div>';
      }).join('');
    })
    .catch(function (err) { lista.innerHTML = 'Erro: ' + err.message; });
}

/* Vigia: mantém o dropdown sincronizado com db.clients (o sync pode rodar depois do load) */
setInterval(function () { try { vmCarregarClientes(); } catch (e) {} }, 2000);

function vmNomeEmpresa(id) {
  var c = vmState.clientes.find(function(x) { return x.id === id; });
  return c ? c.name : '?';
}

function vmNomeUnidade(id) {
  if (!id) return 'Matriz (todas)';
  var u = vmState.unidades.find(function(x) { return x.id === id; });
  return u ? u.name : 'Matriz (todas)';
}

function vmCarregarUnidades(companyId) {
  var sel = document.getElementById('vm-unidade');
  if (!sel) return;
  if (!companyId) { sel.innerHTML = '<option value="">Selecione o cliente primeiro...</option>'; return; }
  sel.innerHTML = '<option value="">Carregando unidades...</option>';

  if (typeof zeepApi === 'function') {
    zeepApi('GET', '/units')
      .then(function (r) {
        var units = (r.units || []).filter(function (u) {
          return String(u.company_id) === String(companyId);
        });
        // ★ NOVO: opção "Todas as unidades" entra no topo da lista
        sel.innerHTML = '<option value="">Selecione a unidade...</option>' +
          '<option value="__TODAS__">🏢 Todas as unidades (recado geral)</option>' +
          units.map(function (u) {
            return '<option value="' + u.id + '">' + (u.name || u.nome) + '</option>';
          }).join('');
      })
      .catch(function (e) {
        console.warn('[VM] Erro ao buscar unidades:', e && e.message);
        sel.innerHTML = '<option value="">Erro ao carregar unidades</option>';
      });
    return;
  }

  sel.innerHTML = '<option value="">Sem backend disponível</option>';
}

// Player padronizado embutido na linha
var vmAudio = new Audio();
function vmPlay(keyEncoded, btn) {
  var key = decodeURIComponent(keyEncoded);
  if (vmAudio.src && vmAudio.dataset.key === key) {
    if (vmAudio.paused) { vmAudio.play(); btn.textContent = '⏸'; }
    else { vmAudio.pause(); btn.textContent = '▶'; }
    return;
  }
  var src = (key.indexOf('http') === 0) ? key : (API_BASE + '/api/r2/preview?key=' + encodeURIComponent(key));
  vmAudio.src = src;
  vmAudio.dataset.key = key;
  vmAudio.play();
  btn.textContent = '⏸';
  var row = btn.closest('tr');
  var bar = row.querySelector('.player-bar');
  vmAudio.ontimeupdate = function () {
    if (vmAudio.duration) bar.style.width = (vmAudio.currentTime / vmAudio.duration * 100) + '%';
  };
  vmAudio.onended = function () { btn.textContent = '▶'; bar.style.width = '0%'; };
}

// Associa a vinheta a um cliente/unidade
function vmAssociar(keyEncoded, title) {
  var key = decodeURIComponent(keyEncoded);
  var selCliente = document.getElementById('vm-cliente');
  var selUnidade = document.getElementById('vm-unidade');
  var companyId = selCliente ? selCliente.value : '';
  var unitId = selUnidade ? selUnidade.value : '';
  // ★ NOVO: "Todas as unidades" vira null (backend entende como "empresa toda")
  if (unitId === '__TODAS__') unitId = null;
  var intervalo = document.getElementById('vm-intervalo').value || 5;

  if (!companyId) return alert('Selecione o cliente para associar a vinheta.');

  fetch(API_BASE + '/api/r2/associar-vinheta', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ file_key: key, company_id: companyId, unit_id: unitId, interval_count: intervalo })
  })
    .then(function (r) { return r.json(); })
    .then(function (res) {
      if (!res.success) throw new Error(res.error);
      alert('Vinheta "' + title + '" associada ao cliente!');
    })
    .catch(function (err) { alert('Erro: ' + err.message); });
}

function vmEnviar() {
  var companyId = document.getElementById('vm-cliente').value;
  var unitId = document.getElementById('vm-unidade').value;
  // ★ NOVO: "Todas as unidades" vira null (backend entende como "empresa toda")
  if (unitId === '__TODAS__') unitId = null;
  var intervalo = document.getElementById('vm-intervalo').value || 5;
  var arquivo = document.getElementById('vm-arquivo').files[0];
  if (!companyId) return alert('Selecione o cliente.');
  if (!arquivo) return alert('Selecione o arquivo MP3.');

  var nome = arquivo.name.replace(/\.mp3$/i, '');
  var fd = new FormData();
  fd.append('company_id', companyId);
  fd.append('unit_id', unitId);
  fd.append('title', nome);
  fd.append('type', 'FIXA');
  fd.append('interval_count', intervalo);
  fd.append('file', arquivo);

  fetch(API_BASE + '/api/r2/upload-vinheta', { method: 'POST', body: fd })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.success) throw new Error(res.error);
      alert('Vinheta enviada!');
      vmListar();
      document.getElementById('vm-arquivo').value = '';
    })
    .catch(function(err) { alert('Erro: ' + err.message); });
}

function vmListar() {
  var tbody = document.getElementById('vm-tbody');
  if (!tbody) return;
  tbody.innerHTML = '<tr><td colspan="5" style="color:var(--text3);">Carregando vinhetas…</td></tr>';
  fetch(API_BASE + '/api/r2/vinhetas')
    .then(function (r) { return r.json(); })
    .then(function (res) {
      if (!res.success) throw new Error(res.error);
      var vh = res.vinhetas || [];
      if (!vh.length) {
        tbody.innerHTML = '<tr><td colspan="5" style="color:var(--text3);">Nenhuma vinheta na pasta Vinhetas/ do R2.</td></tr>';
        return;
      }
      tbody.innerHTML = vh.map(function (v, i) {
        return '<tr>' +
          '<td>' + (i + 1) + '</td>' +
          '<td><strong>' + escapeHtml(v.title) + '</strong></td>' +
          '<td>--:--</td>' +
          '<td>' +
            '<div class="player-inline">' +
              '<button class="btn btn-danger btn-sm" onclick="vmRemoverVinheta(\'' + encodeURIComponent(v.file_key) + '\',\'' + escapeHtml(v.title) + '\')">🗑️</button>' +
              '<button class="btn-play" onclick="vmPlay(\'' + encodeURIComponent(v.file_key) + '\', this)">▶</button>' +
              '<div class="player-progress"><div class="player-bar" style="width:0%"></div></div>' +
            '</div>' +
          '</td>' +
          '<td>' +
            '<button class="btn btn-ghost btn-sm" onclick="vmAssociar(\'' + encodeURIComponent(v.file_key) + '\',\'' + escapeHtml(v.title) + '\')">➕ Adicionar</button>' +
          '</td>' +
        '</tr>';
      }).join('');
    })
    .catch(function (err) {
      tbody.innerHTML = '<tr><td colspan="5" style="color:var(--red);">Erro: ' + escapeHtml(err.message) + '</td></tr>';
    });
}

function vmToggle(id, ativo) {
  window.supabase.from('jingles').update({ active: !ativo }).eq('id', id).then(function(r) {
    if (r.error) return alert('Erro: ' + r.error.message);
    vmListar();
  });
}

function vmExcluir(id) {
  if (!confirm('Excluir esta vinheta?')) return;
  window.supabase.from('jingles').delete().eq('id', id).then(function(r) {
    if (r.error) return alert('Erro: ' + r.error.message);
    vmListar();
  });
}

function vmRemoverVinheta(keyEncoded, title) {
  if (!confirm('Excluir a vinheta "' + title + '"? Esta ação não pode ser desfeita.')) return;
  var key = decodeURIComponent(keyEncoded);
  fetch(API_BASE + '/api/vinhetas/remover-por-chave', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ file_key: key })
  })
    .then(function (r) { return r.json(); })
    .then(function (res) {
      if (!res.success) throw new Error(res.message || res.error);
      alert('Vinheta "' + title + '" excluída!');
      vmListar();
    })
    .catch(function (err) { alert('Erro: ' + err.message); });
}

/* Boot */
document.addEventListener('DOMContentLoaded', function() {
  try { vmListar(); } catch (e) { console.error(e); }
  var selCliente = document.getElementById('vm-cliente');
  if (selCliente) {
    selCliente.addEventListener('change', function() { vmCarregarUnidades(this.value); });
    try { vmCarregarClientes(); } catch (e) { console.error(e); }
  }
});
</script>
<script>
// ═══════════ LOGIN DO DASHBOARD ═══════════
const dashLoginScreen   = document.getElementById('dash-login-screen');
const dashLoginEmail    = document.getElementById('dash-login-email');
const dashLoginPassword = document.getElementById('dash-login-password');
const dashLoginRemember = document.getElementById('dash-login-remember');
const dashLoginBtn      = document.getElementById('dash-login-btn');
const dashLoginError    = document.getElementById('dash-login-error');
const dashLoginLoading  = document.getElementById('dash-login-loading');

const DASH_API = '';

let dashToken = '';

function dashUrl(p) {
  if (p.indexOf('/api/') !== 0) p = '/api' + p;
  return DASH_API + p;
}

async function dashHandleLogin() {
  dashLoginError.textContent = '';
  const email = dashLoginEmail.value.trim();
  const password = dashLoginPassword.value;
  if (!email || !password) {
    dashLoginError.textContent = 'Informe e-mail e senha.';
    return;
  }
  dashLoginBtn.disabled = true;
  dashLoginLoading.style.display = 'block';
  try {
    const resp = await fetch(dashUrl('/api/auth/login'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, password: password })
    });
    const data = await resp.json();
    if (!data.success) {
      dashLoginError.textContent = data.message || 'Falha no login.';
      return;
    }
    dashToken = data.token;
    // Sessão persistente: dashboard comercial fica sempre logado
    localStorage.setItem('zeep_dash_token', data.token);
    localStorage.setItem('zeep_dash_user', JSON.stringify({
      email: email,
      role: (data.user && data.user.role) || 'MANAGER',
      company: (data.company && data.company.name) || ''
    }));
    dashLoginScreen.style.display = 'none';
    if (typeof initDashboard === 'function') initDashboard();
    if (typeof zeepCarregarDados === 'function') zeepCarregarDados();
    if (typeof zeepCarregarAtividades === 'function') zeepCarregarAtividades();
  } catch (err) {
    console.error('[Dash Login] Erro:', err.message);
    dashLoginError.textContent = 'Não foi possível conectar ao servidor.';
  } finally {
    dashLoginBtn.disabled = false;
    dashLoginLoading.style.display = 'none';
  }
}
async function dashRestaurarSessao() {
  const saved = localStorage.getItem('zeep_dash_token');
  if (!saved) return;

  try {
    const resp = await fetch(dashUrl('/api/me'), {
      headers: { 'Authorization': 'Bearer ' + saved }
    });

    // 401 = sessão realmente expirada/inválida → SÓ aqui apaga o token
    if (resp.status === 401) {
      localStorage.removeItem('zeep_dash_token');
      localStorage.removeItem('zeep_dash_user');
      console.warn('[Dash] Sessão expirada. Faça login novamente.');
      return;
    }

    // 404 = o servidor em produção ainda não tem a rota /api/me.
    // NÃO apaga o token — as demais rotas /api/* podem funcionar com ele.
    if (resp.status === 404) {
      console.warn('[Dash] /api/me não existe no servidor. Mantendo token e carregando o dashboard mesmo assim.');
      dashToken = saved;
      if (typeof dashLoginScreen === 'object' && dashLoginScreen) dashLoginScreen.style.display = 'none';
      if (typeof initDashboard === 'function') initDashboard();
      return;
    }

    // Outro status que não seja 2xx → mantém o token (pode ser erro temporário)
    if (!resp.ok) {
      console.warn('[Dash] /api/me respondeu status ' + resp.status + ' — mantendo token.');
      return;
    }

    // Sucesso (2xx): tenta ler o JSON com segurança
    const data = await resp.json();
    if (data.success) {
      dashToken = saved;
      if (typeof dashLoginScreen === 'object' && dashLoginScreen) dashLoginScreen.style.display = 'none';
      if (typeof initDashboard === 'function') initDashboard();
      console.log('[Dash] Conectado automaticamente.');
    } else {
      localStorage.removeItem('zeep_dash_token');
    }
  } catch (err) {
    // Erro de rede NÃO apaga o token — pode ser instabilidade momentânea
    console.warn('[Dash] Erro ao restaurar sessão (mantendo token):', err.message);
  }
}
function dashLogout() {
  localStorage.removeItem('zeep_dash_token');
  localStorage.removeItem('zeep_dash_user');
  localStorage.removeItem('zeep_dash_cache');
  dashToken = '';
  dashLoginScreen.style.display = 'flex';
}
dashLoginBtn.addEventListener('click', dashHandleLogin);
dashLoginPassword.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') dashHandleLogin();
});
dashRestaurarSessao();
</script>

<script>
/* ═══════════════════════════════════════════════════════════
   ZEEP — INTEGRAÇÃO COM O BACKEND (NÚCLEO)
   Popula o db local com dados reais da API e conecta a criação.
   Versão corrigida: paralelo + cache + sessão persistente.
   ═══════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  /* ── 1) Cliente de API com token ── */
  function zeepToken() {
   var t = localStorage.getItem('zeep_dash_token');
   if (t) return t;
   if (typeof dashToken !== 'undefined' && dashToken) return dashToken;
    return '';
  }
  async function zeepApi(method, path, body) {
    const headers = { 'Content-Type': 'application/json' };
    const token = zeepToken();
    if (token) headers['Authorization'] = 'Bearer ' + token;
    // ★ FIX: usa dashUrl (mesmo do login) com fallback para /api
    const url = (typeof dashUrl === 'function') ? dashUrl(path) : ('/api' + path);
    const resp = await fetch(url, {
      method: method,
      headers: headers,
      body: body ? JSON.stringify(body) : undefined
    });
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || data.success === false) {
      throw new Error(data.message || ('Erro ' + resp.status));
    }
    return data;
  }
  window.zeepApi = zeepApi;

  /* ── 2) Converte formato da API → formato que o dashboard lê ── */
  function paraCliente(c, units) {
    const unis = (units || []).filter(function (u) {
      return u.company_id === c.id || u.cliente === c.name;
    });
    return {
      id: c.id,
      nome: c.name,
      segmento: c.segmento || '',
      plano: c.plan || 'Business',
      status: (c.status || 'ACTIVE') === 'ACTIVE' ? 'Ativo' : 'Inativo',
      email: c.email || '',
      pagamento: c.forma_pagamento || '',
      valor: Number(c.valor_mensal || 0),
      unidades: unis.length || 1,
      filiais: Math.max(0, (unis.length || 1) - 1),
      playlistList: []
    };
  }
  function paraUnidade(u) {
    return {
      id: u.id,
      company_id: u.company_id,
      nome: u.name,
      endereco: u.address || '',
      status: u.status === 'ACTIVE' ? 'Online' : 'Offline',
      tipo: 'filial'
    };
  }

  /* ── 3) Cache local (boot instantâneo) ── */
  function zeepSalvarCache() {
    try {
      localStorage.setItem('zeep_dash_cache', JSON.stringify({
        clients: db.clients || [],
        playlists: db.playlists || [],
        tracks: db.tracks || [],
        pagamentos: db.pagamentos || [],
        chats: db.chats || []
      }));
    } catch (e) { console.warn('[ZEEP-API] Não salvou cache:', e.message); }
  }
  function zeepUsarCache() {
    try {
      const raw = localStorage.getItem('zeep_dash_cache');
      if (!raw) return false;
      const c = JSON.parse(raw);
      if (!c) return false;
      window.db = window.db || {};
      if (c.clients && Array.isArray(c.clients)) { db.clients = c.clients; db.clientes = c.clients; }
      if (c.playlists && Array.isArray(c.playlists) && c.playlists.length && c.playlists[0] && c.playlists[0].id && String(c.playlists[0].id).length === 36) db.playlists = c.playlists;
      if (c.tracks && Array.isArray(c.tracks)) { db.tracks = c.tracks; if (window.bibliotecaTracks) window.bibliotecaTracks = c.tracks; }
      if (c.pagamentos && Array.isArray(c.pagamentos)) db.pagamentos = c.pagamentos;
      if (c.chats && Array.isArray(c.chats)) db.chats = c.chats;
      if (typeof renderClientTable === 'function') renderClientTable();
      if (typeof renderPlaylistAccordion === 'function') renderPlaylistAccordion();
      if (typeof renderPlaylistsDoCliente === 'function') renderPlaylistsDoCliente();
      if (typeof renderPagamentos === 'function') renderPagamentos();
      if (typeof renderChats === 'function') renderChats();
      if (typeof loadBiblioteca === 'function') loadBiblioteca();
      return true;
    } catch (e) { return false; }
  }

  /* ── 4) Carrega dados reais e injeta no db local ── */
  async function zeepCarregarClientes() {
    try {
      const r = await zeepApi('GET', '/companies');
      const units = await zeepApi('GET', '/units');
      const lista = (r.companies || []).map(function (c) {
        return paraCliente(c, units.units);
      });
      window.db = window.db || {};
      db.clients  = lista;
      db.clientes = lista;
      db.units    = (units.units || []).map(paraUnidade);
      db.unidades = (units.units || []).map(paraUnidade);
      if (typeof renderClientTable === 'function') renderClientTable();
      console.log('[ZEEP-API] Clientes carregados:', lista.length);
    } catch (e) {
      console.warn('[ZEEP-API] Falha ao carregar clientes:', e.message);
    }
  }
  async function zeepCarregarBiblioteca() {
    try {
      const r = await zeepApi('GET', '/tracks');
      window.db = window.db || {};
      db.tracks = r.tracks || [];
      if (window.bibliotecaTracks) window.bibliotecaTracks = r.tracks || [];
      if (typeof loadBiblioteca === 'function') loadBiblioteca();
      console.log('[ZEEP-API] Biblioteca carregada:', (r.tracks || []).length);
    } catch (e) {
      console.warn('[ZEEP-API] Falha ao carregar biblioteca:', e.message);
    }
  }
  async function zeepCarregarPlaylists() {
    try {
      // ★ garante que os clientes já estão no db antes de injetar
      await zeepCarregarClientes();

      const r = await zeepApi('GET', '/playlists');

      // ★ só playlists com id UUID entram (evita /playlists/undefined/tracks → 400)
      const pls = (r.playlists || []).filter(function (p) {
        return p && p.id && String(p.id).length === 36;
      });

      // ★ carrega as faixas de cada playlist, guardando id + metadados ALINHADOS por índice
      const completas = await Promise.all(pls.map(async function (p) {
        try {
          const t = await zeepApi('GET', '/playlists/' + p.id + '/tracks');
          const tracksArr = (t.tracks || []);

          p.tracks = tracksArr.map(function (tr) {
            return tr.title || tr.name || '';
          });
          p._trackIds = tracksArr.map(function (tr) {
            return tr.id || '';
          });
          p._trackMeta = tracksArr.map(function (tr) {
            return {
              artist: tr.artist || tr.artista || '',
              album:  tr.album  || '',
              genre:  tr.genre  || tr.genero  || ''
            };
          });
        } catch (e) {
          console.warn('[ZEEP-API] Falha ao carregar faixas de "' + p.name + '":', e.message);
          p.tracks = [];
          p._trackIds = [];
          p._trackMeta = [];
        }
        return p;
      }));

      window.db = window.db || {};
      db.playlists = completas;

      // ★ Agrupa as playlists do servidor por empresa
      const porCliente = {};
      completas.forEach(function (p) {
        const cid = p.company_id ? String(p.company_id) : '';
        if (!cid) return;
        if (!porCliente[cid]) porCliente[cid] = [];
        porCliente[cid].push(p);
      });

      // ★ Espelha as playlists do servidor no playlistList de cada cliente.
      //   Espelhos ficam marcados com _serverId para nunca misturar com playlists locais.
      (db.clients || db.clientes || []).forEach(function (c) {
        const doServidor = porCliente[String(c.id)] || [];

        const idsVivos = {};
        doServidor.forEach(function (p) { idsVivos[String(p.id)] = true; });

        if (!Array.isArray(c.playlistList)) c.playlistList = [];

        // 1) remove espelhos de playlists que não existem mais no servidor
        //    (playlists locais — sem _serverId — são preservadas)
        c.playlistList = c.playlistList.filter(function (pl) {
          if (!pl || !pl._serverId) return true;
          return idsVivos[String(pl._serverId)] === true;
        });

        // 2) adiciona/atualiza os espelhos — nunca duplica
        doServidor.forEach(function (p) {
          let item = c.playlistList.find(function (pl) {
            return pl && String(pl._serverId) === String(p.id);
          });

          // aproveita um item local de mesmo nome e o "adota" como espelho
          if (!item) {
            item = c.playlistList.find(function (pl) {
              return pl && !pl._serverId && (pl.titulo === p.name || pl.name === p.name);
            });
          }

          if (!item) {
            item = {};
            c.playlistList.push(item);
          }

          item._serverId = p.id;
          item.id        = p.id;
          item.titulo    = p.name;
          item.name      = p.name;
          item.descricao = p.description || '';
          item.inicio    = p.start_time || item.inicio || '';
          item.fim       = p.end_time   || item.fim    || '';
          item.tracks    = p.tracks     || [];
          item._trackIds = p._trackIds  || [];
          item._trackMeta = p._trackMeta || [];
        });
      });

      if (typeof renderPlaylistAccordion === 'function') renderPlaylistAccordion();
      if (typeof renderPlaylistsDoCliente === 'function') renderPlaylistsDoCliente();
      console.log('[ZEEP-API] Playlists carregadas:', completas.length);
    } catch (e) {
      console.warn('[ZEEP-API] Falha ao carregar playlists:', e.message);
    }
  }
  async function zeepCarregarPagamentos() {
    try {
      const r = await zeepApi('GET', '/billings');
      const lista = (r.billings || []).map(function (b) {
        // ★ FIX: mostra o nome da empresa, não o id
        const co = (db.clients || db.clientes || []).find(function (c) { return c.id === b.company_id; });
        return {
          id: b.id,
          clientId: b.company_id,
          name: (co && co.nome) || b.company_id,
          venc: b.due_date,
          valor: String(Number(b.amount || 0)),
          status: (b.status || 'PENDENTE') === 'PAGO' ? 'Pago' : 'Pendente',
          forma: ''
        };
      });
      window.db = window.db || {};
      db.pagamentos = lista;
      if (typeof renderPagamentos === 'function') renderPagamentos();
      console.log('[ZEEP-API] Pagamentos carregados:', lista.length);
    } catch (e) {
      console.warn('[ZEEP-API] Falha ao carregar pagamentos:', e.message);
    }
  }
  async function zeepCarregarTickets() {
    try {
      const r = await zeepApi('GET', '/tickets');
      const lista = (r.tickets || []).map(function (t) {
        return {
          id: t.id,
          clienteId: t.company_id,
          name: t.subject,
          last: t.description || '',
          time: '',
          prioridade: t.priority || 'Baixa',
          status: (t.status || 'ABERTO') === 'RESOLVIDO' ? 'finalizado' : 'aberto',
          msgs: []
        };
      });
      window.db = window.db || {};
      db.chats = lista;
      if (typeof renderChats === 'function') renderChats();
      console.log('[ZEEP-API] Chamados carregados:', lista.length);
    } catch (e) {
      console.warn('[ZEEP-API] Falha ao carregar chamados:', e.message);
    }
  }

  /* ── 5) Roda tudo em PARALELO + cache ── */
  window.zeepCarregarDados = async function () {
    zeepUsarCache(); // pinta do cache primeiro (boot instantâneo)
    const inicio = Date.now();
    try {
      await Promise.all([
        zeepCarregarClientes(),
        zeepCarregarBiblioteca(),
        zeepCarregarPlaylists(),
        zeepCarregarPagamentos(),
        zeepCarregarTickets()
      ]);
      zeepSalvarCache();
      console.log('[ZEEP-API] Dados sincronizados em', (Date.now() - inicio) + 'ms');
      zeepNormalizarDados();        // ★ COLE AQUI
      zeepAtualizarInterface();     // ★ E AQUI
      zeepCarregarVisaoGeral();     // ★ E AQUI
    } catch (e) {
      console.warn('[ZEEP-API] Sincronização falhou — mantendo cache:', e.message);
    }
  };
  window.zeepCarregarPlaylists = zeepCarregarPlaylists;

  /* ── 6) Escrita real: criar cliente (sobrescreve o mock) ── */
  function acharInput(modal, placeholderPart) {
    const m = modal || document;
    const el = m.querySelector('input[placeholder*="' + placeholderPart + '"]')
      || m.querySelector('textarea[placeholder*="' + placeholderPart + '"]');
    return el;
  }
  function acharSelect(modal, textoOpcao) {
    const m = modal || document;
    const sel = m.querySelectorAll('select');
    for (let i = 0; i < sel.length; i++) {
      const ops = Array.prototype.slice.call(sel[i].options || []);
      if (ops.some(function (o) { return o.text.indexOf(textoOpcao) !== -1; })) return sel[i];
    }
    return null;
  }
  window.criarClienteManual = async function () {
    try {
      const modal = document.getElementById('modal-novo-cliente') || document;
      const nome = document.getElementById("nc-nome");
      const email = document.getElementById("nc-email");
      const plano = document.getElementById("nc-plano");
      const status = document.getElementById("nc-status");
      const pagamento = document.getElementById("nc-pagamento");
      const valor = document.getElementById("nc-valor");

      // 1) Garante que o cálculo automático preencha o campo antes de ler
      try {
        if (plano) plano.dispatchEvent(new Event('change', { bubbles: true }));
      } catch (e) { /* ignora */ }

      // 2) Lê e normaliza o valor (aceita "599", "599,00", "R$ 599,00", "1.599,00")
      var valorBruto = valor ? String(valor.value || '').trim() : '';
      var numero = parseFloat(
        valorBruto
          .replace(/[^\d,.-]/g, '')   // remove R$, espaços, símbolos
          .replace(/\./g, '')         // remove separador de milhar (1.599 → 1599)
          .replace(',', '.')          // vírgula decimal → ponto (599,00 → 599.00)
      );
      var valorFinal = isNaN(numero) ? null : numero;

      const body = {
        name: nome ? nome.value.trim() : '',
        email: email ? email.value.trim() : '',
        plan: plano && plano.value ? plano.value : 'Business',
        status: status && status.value === 'Inativo' ? 'INACTIVE' : 'ACTIVE',
        forma_pagamento: pagamento ? pagamento.value : 'Dinheiro',
        valor_mensal: valorFinal,
        document: (document.getElementById("nc-document") || {}).value || null,
        phone: (document.getElementById("nc-phone") || {}).value || null,
        address: (document.getElementById("nc-address") || {}).value || null,
        segmento: (document.getElementById("nc-segmento") || {}).value || null
      };
      if (!body.name) { alert('Informe o nome da empresa.'); return; }
      const r = await zeepApi('POST', '/companies', body);
      console.log('[ZEEP-API] Cliente criado:', r.company.id);
      await zeepCarregarClientes();
      if (typeof closeModal === 'function') closeModal('modal-novo-cliente');
      if (typeof renderClientTable === 'function') renderClientTable();
      alert('Cliente criado com sucesso!');
    } catch (e) {
      alert('Erro ao criar cliente: ' + e.message);
    }
  };
  window.renderChats = window.renderChats || function () {};

  /* ── 7) Auto-inicia após o app.js montar o dashboard ── */
  setTimeout(function () {
  if (localStorage.getItem('zeep_dash_token')) {
    zeepCarregarDados();
    console.log('[ZEEP] Sessão OK — dados carregados no boot.');
  } else {
    console.log('[ZEEP] Sem sessão — tela de login, aguardando login.');
  }
}, 300);
})();
function renderClients() {
  try { renderClientTable(); } catch (e) { console.warn('[ZEEP] renderClients:', e.message); }
}
/* Resolve a playlist de origem pelo id OU pelo nome e chama o copiador */
function zeepCopiarDesta(btn) {
  var key = (btn && btn.getAttribute('data-key')) || '';
  var nome = (btn && btn.getAttribute('data-nome')) || '';
  var seguir = function () {
    var pls = db.playlists || [];
    var origem = pls.find(function (p) {
      return (key && (String(p.id) === String(key) || String(p._key) === String(key))) ||
             (nome && String(p.name || p.titulo || p.title || '') === String(nome));
    });
    zeepCopiarPlaylist(origem ? (origem.id || origem._key || key) : (key || nome));
  };
  var semUuid = !(db.playlists || []).some(function (p) { return p && p.id && String(p.id).length === 36; });
  if (semUuid && typeof zeepCarregarPlaylists === 'function') {
    zeepCarregarPlaylists().then(seguir).catch(seguir);
  } else { seguir(); }
}

/* Devolve o UUID real da playlist (pelo objeto ou pelo nome) */
function zeepUuidPlaylist(p) {
  var pls = db.playlists || [];
  var nome = '';
  if (typeof p === 'string') { nome = p; }
  else if (p) { nome = p.name || p.titulo || p.title || ''; }
  // 1) se o próprio objeto já tem UUID, usa ele
  if (p && typeof p === 'object' && p.id && String(p.id).length === 36) return String(p.id);
  // 2) procura na lista global um item com o MESMO NOME e id UUID
  for (var i = 0; i < pls.length; i++) {
    var x = pls[i];
    if (!x || !x.id || String(x.id).length !== 36) continue;
    var xn = x.name || x.titulo || x.title || '';
    if (xn === nome) return String(x.id);
  }
  return '';
}

/* ============ COPIAR PLAYLIST ENTRE CLIENTES (A → B) ============ */
function zeepCopiarPlaylist(origemId) {
  var pls = db.playlists || [];
  var origem = pls.find(function (p) {
    return String(p.id) === String(origemId) || String(p._key) === String(origemId) ||
           String(p.name || p.titulo || p.title || '') === String(origemId);
  });
  var origemRealId = zeepUuidPlaylist(origem || origemId);
  var nomeOrigem = (origem && (origem.name || origem.titulo || origem.title)) || 'Playlist de origem';
  if (!origemRealId) { alert('Playlist de origem sem id do servidor. Recarregue a página (Cmd+Shift+R) e tente de novo.'); return; }
  var destinos = pls.filter(function (p) {
    return String(zeepUuidPlaylist(p)) !== String(origemRealId);
  });
  if (!destinos.length) { alert('Não há outra playlist para copiar.'); return; }
  var overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;display:flex;align-items:center;justify-content:center;';
  var box = document.createElement('div');
  box.style.cssText = 'background:var(--navy2,#0d1b2a);border:1px solid var(--border,#1f3a5f);border-radius:12px;padding:24px;max-width:440px;width:92%;color:var(--text,#e0e0e0);';
  var opts = destinos.map(function (p) {
    var nome = p.name || p.titulo || p.title || 'Playlist';
    var pid = zeepUuidPlaylist(p);
    var value = pid || nome;   // se não tem UUID, usa o nome (a confirmação resolve)
    var cli = (db.clients || db.clientes || []).find(function (c) { return String(c.id) === String(p.clientId || p.company_id); });
    return '<option value="' + esc(value) + '">' + esc(nome) + (cli ? ' — ' + esc(cli.name || cli.nome) : '') + '</option>';
  }).join('');
  box.innerHTML =
    '<h3 style="margin:0 0 12px;color:var(--cyan,#00e5ff);">Copiar Playlist</h3>' +
    '<p style="font-size:13px;margin:0 0 12px;">Copiar <strong>' + esc(nomeOrigem) + '</strong> para:</p>' +
    '<select id="zeep-copiar-destino" style="width:100%;padding:8px;border-radius:6px;border:1px solid var(--border2,#2a4a75);background:var(--bg,#0b1526);color:var(--text,#e0e0e0);margin-bottom:16px;">' + opts + '</select>' +
    '<div style="display:flex;gap:8px;justify-content:flex-end;">' +
    '<button class="btn btn-ghost" type="button" id="zeep-copiar-cancelar">Cancelar</button>' +
    '<button class="btn btn-primary" type="button" id="zeep-copiar-confirmar">Copiar</button>' +
    '</div>';
  overlay.appendChild(box);
  document.body.appendChild(overlay);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) overlay.remove(); });
  document.getElementById('zeep-copiar-cancelar').addEventListener('click', function () { overlay.remove(); });
    document.getElementById('zeep-copiar-confirmar').addEventListener('click', function () {
    var destinoVal = document.getElementById('zeep-copiar-destino').value;
    if (!destinoVal) { alert('Selecione a playlist de destino.'); return; }
    var destinoId = (String(destinoVal).length === 36) ? destinoVal : zeepUuidPlaylist(destinoVal);
    if (!destinoId) { alert('Playlist de destino sem id do servidor. Recarregue a página e tente de novo.'); return; }
    overlay.remove();
    zeepApi('POST', '/playlists/copiar', { playlist_origem_id: origemRealId, playlist_destino_id: destinoId })
      .then(function (r) {
        if (r && r.success) {
          alert(r.message || (r.copiadas + ' música(s) copiada(s).'));
          // ★ RECARREGA as playlists do servidor para a tela atualizar sem F5
          if (typeof zeepCarregarPlaylists === 'function') zeepCarregarPlaylists();
          else if (typeof zeepRefresh === 'function') zeepRefresh();
          if (typeof renderPlaylistAccordion === 'function') renderPlaylistAccordion();
        } else {
          alert('Erro: ' + ((r && r.message) || 'não foi possível copiar.'));
        }
      })
      .catch(function (e) { alert('Erro ao copiar: ' + (e && e.message)); });
  });
}

function zeepAcharIdPlaylistNoBox(box) {
  var el = box.querySelector('[data-playlist-id]');
  if (el && el.getAttribute('data-playlist-id')) return el.getAttribute('data-playlist-id');
  var alvos = box.querySelectorAll('button[onclick], input[onchange]');
  for (var i = 0; i < alvos.length; i++) {
    var attr = alvos[i].getAttribute('onclick') || alvos[i].getAttribute('onchange') || '';
    var mUuid = attr.match(/['"]([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})['"]/i);
    if (mUuid) return mUuid[1];
    var mNum = attr.match(/(?:renamePlaylist|deletePlaylist|openAddMusicas|updatePlaylist)\(\s*(\d+)/);
    if (mNum) return mNum[1];
  }
  var tituloEl = box.querySelector('.playlist-head input') || box.querySelector('h4, b, strong');
  if (tituloEl) {
    var nome = tituloEl.value || tituloEl.textContent || '';
    var p = (db.playlists || []).find(function (x) { return zeepNorm(x.name || x.titulo || x.title || '') === zeepNorm(nome); });
    if (p) return p.id || p._key;
  }
  return null;
}

function zeepInjetarBotaoCopiar() {
  var boxes = document.querySelectorAll('#playlist-accordion .playlist-box, [id*="playlist"] .playlist-box');
  for (var i = 0; i < boxes.length; i++) {
    var box = boxes[i];
    if (box.getAttribute('data-zeep-copiar-btn')) continue;
    // ★ GUARDA: se o box já tem um botão "Copiar" (renderizado inline), não injeta outro
    var temCopiar = false;
    var botoesBox = box.querySelectorAll('button');
    for (var b = 0; b < botoesBox.length; b++) {
      if ((botoesBox[b].textContent || '').indexOf('Copiar') !== -1) { temCopiar = true; break; }
    }
    if (temCopiar) continue;
    var playlistId = zeepAcharIdPlaylistNoBox(box);
    if (!playlistId) continue;
    box.setAttribute('data-zeep-copiar-btn', '1');
    var btn = document.createElement('button');
    btn.className = 'btn btn-ghost btn-sm';
    btn.type = 'button';
    btn.textContent = 'Copiar';
    btn.style.marginLeft = '8px';
    (function (id) { btn.onclick = function () { zeepCopiarPlaylist(id); }; })(playlistId);
    var alvo = box.querySelector('.btn-danger');
    if (alvo && alvo.parentNode) alvo.parentNode.insertBefore(btn, alvo);
    else box.appendChild(btn);
  }
}
setInterval(function () { try { zeepInjetarBotaoCopiar(); } catch (e) {} }, 1500);
</script>
<script>
/* ===== UNIDADES CONECTADAS AO SUPABASE (v2) ===== */
function carregarUnidadesDoCliente() {
  var cliente = getClienteAtual();
  if (!cliente) { if (typeof renderUnidadesDoCliente === 'function') renderUnidadesDoCliente(); return; }
  var companyId = cliente.company_id || cliente.companyId || cliente.id;
  if (!companyId || typeof zeepApi !== 'function') {
    if (typeof renderUnidadesDoCliente === 'function') renderUnidadesDoCliente();
    return;
  }
  zeepApi('GET', '/units')
    .then(function (r) {
      var units = (r.units || []).filter(function (u) {
        return String(u.company_id) === String(companyId);
      });
      cliente.units = units;
      if (typeof renderUnidadesDoCliente === 'function') renderUnidadesDoCliente();
    })
    .catch(function (e) {
      console.warn('[UNIDADES] Erro ao carregar:', e && e.message);
      if (typeof renderUnidadesDoCliente === 'function') renderUnidadesDoCliente();
    });
}

function abrirNovaUnidade() {
  unidadeEditando = null;
  var c = getClienteAtual();
  document.getElementById('unidade-modal-titulo').innerText = '+ Nova Unidade';
  document.getElementById('unidade-cliente-nome').innerText = c ? (c.name || c.nome || '') : '';
  document.getElementById('unidade-nome').value = '';
  document.getElementById('unidade-cidade').value = '';
  document.getElementById('unidade-endereco').value = '';
  document.getElementById('unidade-responsavel').value = '';
  document.getElementById('unidade-email').value = '';
  openModal('modal-nova-unidade');
}

function salvarUnidade() {
  var nome = document.getElementById('unidade-nome').value.trim();
  if (!nome) { alert('Digite o nome da unidade'); return; }
  var cliente = getClienteAtual();
  var companyId = cliente ? (cliente.company_id || cliente.companyId || cliente.id) : null;
  if (!companyId) { alert('Cliente não identificado. Abra o cliente pela lista de Clientes primeiro.'); return; }
  var body = {
    name: nome,
    address: document.getElementById('unidade-endereco').value.trim() || null,
    email: document.getElementById('unidade-email').value.trim() || null
  };
  if (typeof zeepApi !== 'function') { alert('API não disponível.'); return; }
  zeepApi('POST', '/units', body)
    .then(function () {
      closeModal('modal-nova-unidade');
      return carregarUnidadesDoCliente();
    })
    .then(function () { alert('Unidade "' + nome + '" criada!'); })
    .catch(function (e) { alert('Erro ao criar unidade: ' + e.message); });
}

function editarUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units || !cliente.units[idx]) return;
  var u = cliente.units[idx];
  var unitId = u.id || u.unit_id || u.uuid || '';
  if (!unitId) { alert('Esta unidade ainda não tem ID no Supabase.'); return; }
  var nome = prompt('Nome da unidade:', u.name || u.nome || '');
  if (nome === null) return;
  var endereco = prompt('Endereço:', u.address || u.endereco || '');
  if (endereco === null) return;
  var email = prompt('E-mail de acesso do Player:', u.email || u.login || '');
  if (email === null) return;
  var body = { name: nome.trim(), address: endereco || null, email: email || null };
  zeepApi('PUT', '/units/' + unitId, body)
    .then(function () {
      u.name = body.name; u.address = body.address; u.email = body.email;
      renderUnidadesDoCliente();
      alert('Unidade atualizada no Supabase!');
    })
    .catch(function (e) { alert('Erro ao atualizar unidade: ' + e.message); });
}

function excluirUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units || !cliente.units[idx]) return;
  var u = cliente.units[idx];
  var unitId = u.id || u.unit_id || u.uuid || '';
  if (!unitId) { alert('Unidade sem ID no Supabase.'); return; }
  if (!confirm('Excluir a unidade "' + (u.name || u.nome || '') + '"?')) return;
  zeepApi('DELETE', '/units/' + unitId)
    .then(function () { carregarUnidadesDoCliente(); alert('Unidade excluída!'); })
    .catch(function (e) { alert('Erro ao excluir unidade: ' + e.message); });
}

/* Carrega as unidades do backend sempre que o detalhe do cliente abrir */
(function() {
  var origAbrir = window.abrirDetalheCliente;
  window.abrirDetalheCliente = function(cid) {
    _clienteAtualId = cid;
    if (typeof origAbrir === 'function') {
      try { origAbrir(cid); } catch (e) { console.error('abrirDetalheCliente falhou:', e); }
    }
    setTimeout(function() {
      try { renderPlaylistsDoCliente(); renderVinhetasDoCliente(); } catch (e) {}
      try { carregarUnidadesDoCliente(); } catch (e) {}
    }, 50);
  };
})();
</script>
</body>
</html>