<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZEEP | Dashboard Administrativo</title>
<style>
:root {
--navy: #0A0E1A;
--navy2: #0D1526;
--petrol: #0E2233;
--petrol2: #122840;
--cyan: #3CBAD8;
--cyan2: #2DA8C4;
--cyan3: rgba(60,186,216,.18);
--cyan4: rgba(60,186,216,.07);
--text: #E8EDF5;
--text2: #8FA3C0;
--text3: #3E5470;
--green: #2ECC71;
--amber: #F39C12;
--red: #E74C3C;
--purple: #9B59B6;
--orange: #E67E22;
--border: rgba(60,186,216,.18);
--border2: rgba(255,255,255,.06);
--glass: rgba(255,255,255,.04);
--glass2: rgba(255,255,255,.08);
--glow: 0 0 28px rgba(60,186,216,.28);
--font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; font-family: var(--font); }
body {
background: var(--navy);
background-image: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(60,186,216,0.08) 0%, transparent 70%), radial-gradient(ellipse 60% 50% at 30% 60%, rgba(60,186,216,0.04) 0%, transparent 60%);
color: var(--text);
display: flex;
height: 100vh;
overflow: hidden;
}
aside { width: 240px; background: var(--navy2); border-right: 1px solid var(--border2); display: flex; flex-direction: column; z-index: 10; }
.logo-area {
  width: calc(100% - 40px);
  margin: 28px 20px 22px;
  padding: 18px 16px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--navy3);
  border: 1px solid var(--border2);
  border-radius: 12px;
}

.logo-area img {
  width: 130px;
  max-width: 100%;
  height: auto;
  display: block;
  mix-blend-mode: screen;   /* faz o branco "sumir" no fundo escuro */
}
.nav-label { font-size: 9px; letter-spacing: 2px; color: var(--text3); text-transform: uppercase; padding: 24px 24px 8px; }
nav { flex: 1; overflow-y: auto; }
.nav-item { padding: 10px 24px; font-size: 12px; color: var(--text2); cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 12px; border-left: 2px solid transparent; }
.nav-item:hover { color: var(--text); background: var(--glass); }
.nav-item.active { color: var(--cyan); background: var(--cyan4); border-left-color: var(--cyan); font-weight: 600; }
.sidebar-footer { padding: 20px; border-top: 1px solid var(--border2); display: flex; align-items: center; gap: 12px; }
.avatar { width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, var(--cyan), var(--cyan2)); display: flex; align-items: center; justify-content: center; color: var(--navy); font-weight: 700; font-size: 12px; }
main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
header { height: 70px; padding: 0 40px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border2); background: rgba(10,14,26,0.5); backdrop-filter: blur(10px); }
.header-left h2 { font-size: 18px; font-weight: 700; color: var(--text); }
.header-right { display: flex; gap: 12px; }
.btn-edit-genre { background: transparent; border: 1px solid var(--border2); border-radius: 4px; color: var(--text2); cursor: pointer; font-size: 10px; padding: 2px 5px; margin-left: 4px; transition: 0.2s; }
.btn-edit-genre:hover { color: var(--cyan); border-color: var(--cyan); }
.genre-cell select { width: auto; min-width: 110px; padding: 4px 8px; font-size: 12px; }
.badge { padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
.badge-prod { background: var(--cyan4); color: var(--cyan); border: 1px solid var(--cyan3); }
.badge-plan { background: rgba(46,204,113,0.1); color: var(--green); border: 1px solid rgba(46,204,113,0.2); }
.badge-red { background: rgba(231,76,60,0.1); color: var(--red); border: 1px solid rgba(231,76,60,0.2); }
.badge-amber { background: rgba(243,156,18,0.1); color: var(--amber); border: 1px solid rgba(243,156,18,0.2); }
.content { flex: 1; padding: 40px; overflow-y: auto; }
.module { display: none; animation: fadeIn 0.3s ease; }
.module.active { display: block; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
.grid-metrics { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 32px; }
.card-metric { padding: 20px; border-radius: 12px; background: var(--glass); border: 1px solid var(--border2); position: relative; overflow: hidden; transition: 0.3s; cursor: pointer; }
.card-metric::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 2px; }
.card-metric.c1::before { background: var(--cyan); }
.card-metric.c2::before { background: var(--green); }
.card-metric.c3::before { background: var(--purple); }
.card-metric.c4::before { background: var(--orange); }
.card-metric.c5::before { background: var(--red); }
.card-metric p { font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
.card-metric h3 { font-size: 24px; font-weight: 700; }
.card-metric.c1 h3 { color: var(--cyan); }
.card-metric.c2 h3 { color: var(--green); }
.card-metric.c3 h3 { color: var(--purple); }
.card-metric.c4 h3 { color: var(--orange); }
.card-metric.c5 h3 { color: var(--red); }
.card-metric.c1:hover { background: rgba(60,186,216,0.05); }
.card-metric.c2:hover { background: rgba(46,204,113,0.05); }
.card-metric.c3:hover { background: rgba(155,89,182,0.05); }
.card-metric.c4:hover { background: rgba(230,126,34,0.05); }
.card-metric.c5:hover { background: rgba(231,76,60,0.05); }
.card-metric.filtro-ativo { border-color: var(--cyan); box-shadow: var(--glow); }
.card-icon { position: absolute; top: 15px; right: 15px; font-size: 20px; opacity: 0.2; }
.section-title { font-size: 14px; font-weight: 700; color: var(--text2); margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
.table-container { background: var(--glass); border-radius: 12px; border: 1px solid var(--border2); overflow: hidden; margin-bottom: 30px; }
table { width: 100%; border-collapse: collapse; }
th { padding: 16px 20px; text-align: left; font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; background: rgba(255,255,255,0.02); }
td { padding: 14px 20px; font-size: 13px; color: var(--text2); border-bottom: 1px solid var(--border2); }
tr:last-child td { border-bottom: none; }
tr:hover td { background: var(--glass); color: var(--text); }
.btn { padding: 8px 18px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; border: none; transition: 0.2s; display: inline-flex; align-items: center; gap: 8px; }
.btn-primary { background: linear-gradient(135deg, var(--cyan), var(--cyan2)); color: var(--navy); box-shadow: var(--glow); }
.btn-ghost { background: var(--glass2); color: var(--text2); border: 1px solid var(--border2); }
.btn-ghost:hover { background: var(--glass); color: var(--text); }
.btn-danger { background: rgba(231,76,60,0.1); color: var(--red); border: 1px solid rgba(231,76,60,0.2); }
.btn-danger:hover { background: var(--red); color: #fff; }
.btn-success { background: rgba(46,204,113,0.1); color: var(--green); border: 1px solid rgba(46,204,113,0.2); }
.btn-success:hover { background: var(--green); color: #fff; }
.btn-sm { padding: 4px 10px; font-size: 10px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; }
.sub-card { background: var(--glass); border: 1px solid var(--border2); border-radius: 12px; padding: 20px; }
.sub-card h4 { font-size: 12px; color: var(--cyan); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }
.upload-area { border: 2px dashed var(--border2); border-radius: 12px; padding: 40px; text-align: center; margin-bottom: 30px; background: var(--cyan4); cursor: pointer; transition: 0.2s; }
.upload-area:hover { border-color: var(--cyan); }
.search-bar { display: flex; gap: 10px; margin-bottom: 20px; align-items: center; }
.client-row { background: var(--glass); border: 1px solid var(--border2); border-radius: 12px; margin-bottom: 12px; overflow: hidden; }
.client-header { padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: 0.2s; }
.client-header:hover { background: var(--glass2); }
.client-content { display: none; padding: 24px; border-top: 1px solid var(--border2); background: rgba(0,0,0,0.1); }
.playlist-box { background: var(--navy2); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 20px; }
.playlist-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px; gap: 15px; }
input, select, textarea { width: 100%; background: var(--navy); border: 1px solid var(--border2); border-radius: 8px; padding: 10px 14px; color: var(--text); outline: none; font-size: 13px; }
input:focus, select:focus, textarea:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px var(--cyan4); }
label { display: block; font-size: 10px; color: var(--text3); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
.modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 100; align-items: center; justify-content: center; }
.modal-content { background: var(--navy2); border: 1px solid var(--border); border-radius: 16px; width: 900px; max-height: 90vh; overflow-y: auto; padding: 32px; box-shadow: var(--glow); }
.modal-content h3 { margin-bottom: 20px; color: var(--cyan); }
.modal-sm { width: 520px; }
.timeline { position: relative; padding-left: 24px; margin-left: 10px; }
.timeline-item { position: relative; margin-bottom: 20px; font-size: 12px; padding-left: 10px; color: var(--text2); }
.timeline-item::before { content: ""; position: absolute; left: -17px; top: 4px; width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); }
.progress-sim { width: 100%; height: 4px; background: var(--border2); border-radius: 2px; margin-top: 8px; position: relative; overflow: hidden; display: none; }
.progress-bar { width: 0%; height: 100%; background: linear-gradient(90deg, var(--cyan), var(--cyan2)); position: absolute; }
.play-btn { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--border); background: var(--cyan4); color: var(--cyan); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; transition: 0.2s; }
.play-btn:hover { background: var(--cyan); color: var(--navy); box-shadow: var(--glow); }
.add-btn { width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgba(46,204,113,0.3); background: rgba(46,204,113,0.1); color: var(--green); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; transition: 0.2s; }
.add-btn:hover { background: var(--green); color: var(--navy); }
.actions-cell { display: flex; gap: 6px; align-items: center; }
.check-cell { width: 40px; }
input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--cyan); }
.chat-container { display: grid; grid-template-columns: 280px 1fr; height: 520px; background: var(--glass); border-radius: 12px; border: 1px solid var(--border2); overflow: hidden; }
.chat-sidebar { border-right: 1px solid var(--border2); overflow-y: auto; }
.chat-item { padding: 14px 16px; border-bottom: 1px solid var(--border2); cursor: pointer; transition: 0.2s; }
.chat-item:hover { background: var(--glass2); }
.chat-item.active { background: var(--cyan4); border-left: 3px solid var(--cyan); }
.chat-item h6 { font-size: 13px; margin-bottom: 4px; }
.chat-item p { font-size: 11px; color: var(--text3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chat-main { display: flex; flex-direction: column; background: rgba(0,0,0,0.2); }
.chat-header { padding: 14px 20px; border-bottom: 1px solid var(--border2); display: flex; justify-content: space-between; align-items: center; background: rgba(10,14,26,0.6); }
.chat-header h5 { font-size: 14px; color: var(--text); }
.chat-messages { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
.msg { max-width: 70%; padding: 12px 16px; border-radius: 12px; font-size: 13px; line-height: 1.4; }
.msg-client { align-self: flex-start; background: rgba(255,255,255,0.05); border: 1px solid var(--border2); }
.msg-me { align-self: flex-end; background: var(--cyan4); border: 1px solid var(--cyan3); color: var(--text); }
.msg-time { display: block; font-size: 9px; color: var(--text3); margin-top: 6px; }
.chat-input { padding: 16px 20px; border-top: 1px solid var(--border2); display: flex; gap: 12px; }
.hist-item { display: flex; justify-content: space-between; align-items: center; padding: 14px; background: rgba(255,255,255,0.02); border-radius: 8px; margin-bottom: 8px; border: 1px solid transparent; cursor: pointer; transition: 0.2s; }
.hist-item:hover { border-color: var(--border); background: var(--glass2); }
.hist-info h5 { font-size: 12px; color: var(--text); }
.hist-info p { font-size: 10px; color: var(--text3); }
.status-tag { font-size: 9px; padding: 2px 8px; border-radius: 4px; font-weight: 700; text-transform: uppercase; white-space: nowrap; }
.unit-row { display: flex; justify-content: space-between; align-items: center; padding: 12px; background: rgba(255,255,255,0.02); border-radius: 8px; margin-bottom: 8px; border: 1px solid transparent; transition: 0.2s; }
.unit-row:hover { border-color: var(--border); background: var(--glass2); }
.unit-row h5 { font-size: 13px; color: var(--text); }
.unit-row p { font-size: 10px; color: var(--text3); }
::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--cyan3); border-radius: 2px; }
/* ===== Configurações ===== */
.config-tabs { display: flex; gap: 8px; margin-bottom: 24px; border-bottom: 1px solid var(--border); padding-bottom: 0; }
.config-tab { padding: 10px 18px; border-radius: 8px 8px 0 0; cursor: pointer; font-size: 13px; color: var(--text3); transition: 0.2s; border: 1px solid transparent; border-bottom: none; }
.config-tab:hover { color: var(--text); }
.config-tab.active { background: var(--navy2); color: var(--cyan); border-color: var(--border); font-weight: 600; }
.config-panel { display: none; }
.config-panel.active { display: block; animation: fadeIn 0.3s ease; }
.config-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 12px; }
.config-toolbar h3 { font-size: 15px; color: var(--text); }
.role-badge { padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
.role-admin { background: rgba(60,186,216,0.12); color: var(--cyan); }
.role-oper { background: rgba(241,196,15,0.12); color: var(--amber); }
.status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
.status-on { background: var(--green); }
.status-off { background: var(--text3); }
.key-row { display: flex; align-items: center; gap: 10px; }
.key-row input { flex: 1; }
.key-eye { background: transparent; border: none; color: var(--text3); cursor: pointer; font-size: 16px; padding: 4px; }
.key-eye:hover { color: var(--text); }
.api-card { background: var(--navy2); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 16px; }
.api-card h4 { font-size: 13px; color: var(--text); margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
.api-card p { font-size: 11px; color: var(--text3); margin-bottom: 14px; }
.player-inline { display: flex; align-items: center; gap: 8px; }
.btn-play {
  width: 32px; height: 32px; border-radius: 50%;
  border: 1px solid var(--border2); background: var(--bg2);
  color: var(--text1); cursor: pointer; font-size: 12px;
  display: flex; align-items: center; justify-content: center;
}
.btn-play:hover { background: var(--accent); color: #fff; }
.player-progress {
  width: 120px; height: 6px; border-radius: 3px;
  background: var(--border2); overflow: hidden;
}
.player-bar { height: 100%; background: var(--accent); transition: width 0.2s; }
/* ═══ LOGIN DASHBOARD ═══ */
.dash-login-screen {
  position: fixed; inset: 0; z-index: 9999;
  background: linear-gradient(160deg, #0d0d12 0%, #14141b 55%, #1a1a24 100%);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Inter', system-ui, sans-serif;
}
.dash-login-card {
  width: 360px; max-width: 92vw;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 18px;
  padding: 40px 34px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}
.dash-login-logo { height: 42px; margin-bottom: 18px; }
.dash-login-title { color: #fff; font-size: 22px; font-weight: 700; margin: 0 0 4px; letter-spacing: -0.02em; }
.dash-login-sub { color: #8b8b9c; font-size: 13px; margin: 0 0 26px; }
.dash-login-card input[type=email],
.dash-login-card input[type=password] {
  width: 100%; box-sizing: border-box;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  color: #fff;
  border-radius: 10px;
  padding: 12px 14px;
  margin-bottom: 12px;
  font-size: 14px;
  outline: none;
}
.dash-login-card input:focus { border-color: #6c5ce7; background: rgba(108,92,231,0.08); }
.dash-login-remember {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; color: #9a9aab;
  margin: 2px 0 16px; cursor: pointer; user-select: none;
}
.dash-login-remember input { width: 15px; height: 15px; accent-color: #6c5ce7; cursor: pointer; }
.dash-login-card button {
  width: 100%;
  background: linear-gradient(135deg, #6c5ce7, #5a4bd1);
  color: #fff; border: none; border-radius: 10px;
  padding: 12px; font-size: 15px; font-weight: 600;
  cursor: pointer; transition: opacity .2s;
}
.dash-login-card button:hover { opacity: .9; }
.dash-login-card button:disabled { opacity: .5; cursor: default; }
.dash-login-error { color: #ff6b6b; font-size: 13px; margin: 12px 0 0; min-height: 16px; }
.dash-login-loading { color: #9a9aab; font-size: 13px; margin: 10px 0 0; }
</style>
</head>
<body>
<!-- ═══ TELA DE LOGIN DO DASHBOARD ═══ -->
<div id="dash-login-screen" class="dash-login-screen">
  <div class="dash-login-card">
    <img src="logo-zeep.png" alt="ZEEP" class="dash-login-logo" />
    <h2 class="dash-login-title">ZEEP Dashboard</h2>
    <p class="dash-login-sub">Painel Administrativo de Produção</p>
    <input type="email" id="dash-login-email" placeholder="E-mail" autocomplete="username" />
    <input type="password" id="dash-login-password" placeholder="Senha" autocomplete="current-password" />
    <label class="dash-login-remember">
      <input type="checkbox" id="dash-login-remember" />
      <span>Manter conectado</span>
    </label>
    <button id="dash-login-btn">Entrar</button>
    <p id="dash-login-error" class="dash-login-error"></p>
    <p id="dash-login-loading" class="dash-login-loading" style="display:none">Entrando...</p>
  </div>
</div>  
<aside>
<div class="logo-area">
  <img src="logo-zeep.png" alt="ZEEP">
</div>
<nav>
<p class="nav-label">Principal</p>
<div class="nav-item active" onclick="nav('visao-geral', this)">Visão Geral</div>
<div class="nav-item" onclick="nav('clientes', this)">Clientes</div>
<div class="nav-item" onclick="nav('playlists', this)">Playlists Curadoria</div>
<div class="nav-item" onclick="nav('biblioteca', this)">Biblioteca de Música</div>
<div class="nav-item" onclick="nav('biblioteca-zeep', this); setTimeout(function(){ try{ zeepRender(); }catch(e){} }, 60)">Playlists Biblioteca Zeep</div>
<div class="nav-item" onclick="nav('vinhetas-marca', this)">Vinhetas da Marca</div>
<div class="nav-item" onclick="nav('upload-r2', this); setTimeout(function(){ try{ zeepMoveUpload(); }catch(e){} }, 60)">Upload R2</div>
<p class="nav-label">Sistema</p>
<div class="nav-item" onclick="nav('pagamentos', this)">Pagamentos</div>
<div class="nav-item" onclick="nav('sac', this)">SAC</div>
<div class="nav-item" onclick="nav('historico', this)">Histórico</div>
<div class="nav-item" onclick="nav('config', this)">Configurações</div>
</nav>
<div class="sidebar-footer">
<div class="avatar">IV</div>
<div><p style="font-size:12px;font-weight:600;">Italo Vieira</p><p style="font-size:10px;color:var(--text3);">Administrator</p></div>
<div style="margin-top:8px;width:100%;"><button onclick="dashLogout()" style="width:100%;padding:6px 12px;font-size:11px;font-weight:600;background:transparent;color:var(--text3);border:1px solid var(--border,#444);border-radius:6px;cursor:pointer;">Sair</button></div>
</div>
</aside>
<main>
<header>
<div class="header-left"><h2 id="page-title">Visão Geral</h2></div>
<div class="header-right"><span class="badge badge-prod">Produção</span><span class="badge badge-plan">Supabase Conectado</span></div>
</header>
<div class="content">
<section id="visao-geral" class="module active">
<div class="grid-metrics">
<div class="card-metric c1" onclick="nav('clientes', document.querySelectorAll('.nav-item')[1])"><div class="card-icon">👥</div><p>Clientes Ativos</p><h3>12</h3></div>
<div class="card-metric c2" onclick="nav('playlists', document.querySelectorAll('.nav-item')[2])"><div class="card-icon">🎵</div><p>Playlists</p><h3>09</h3></div>
<div class="card-metric c3" onclick="nav('biblioteca', document.querySelectorAll('.nav-item')[3])"><div class="card-icon">☁️</div><p>Músicas no R2</p><h3>143</h3></div>
<div class="card-metric c4" onclick="nav('pagamentos', document.querySelectorAll('.nav-item')[5])"><div class="card-icon">💰</div><p>Faturamento</p><h3>R$ 8.742</h3></div>
<div class="card-metric c5" onclick="nav('sac', document.querySelectorAll('.nav-item')[6])"><div class="card-icon">🎫</div><p>SAC</p><h3 id="card-sac">03</h3></div>
</div>
<div class="section-title">Atividades Recentes</div>
<div class="table-container">
<table>
<thead><tr><th>Data</th><th>Evento</th><th>Usuário</th><th>Status</th></tr></thead>
<tbody>
<tr><td>31/07/2026 - 10:15</td><td>Upload de 12 faixas - Jangada Almoço</td><td>Italo Vieira</td><td><span class="badge badge-prod">Sucesso</span></td></tr>
<tr><td>30/07/2026 - 18:30</td><td>Novo cliente cadastrado: Renner</td><td>Italo Vieira</td><td><span class="badge badge-prod">Sucesso</span></td></tr>
<tr><td>30/07/2026 - 14:20</td><td>Upload de 43 faixas - Jangada Almoço</td><td>Italo Vieira</td><td><span class="badge badge-prod">Sucesso</span></td></tr>
</tbody>
</table>
</div>
</section>
<section id="clientes" class="module">
<div class="section-title">Gestão de Clientes <button class="btn btn-primary" onclick="openModal('modal-novo-cliente')">+ Novo Cliente</button></div>
<div class="table-container">
<table>
<thead><tr><th>Cliente</th><th>Plano</th><th>Status</th><th>Playlists</th><th>Unidades</th><th>Valor</th><th>Ações</th></tr></thead>
<tbody id="client-table-body"></tbody>
</table>
</div>
</section>
<section id="playlists" class="module">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
<div class="section-title" style="margin:0;">Gestão de Playlists & Upload R2</div>
<div style="display:flex;gap:10px;">
<button class="btn btn-primary" onclick="openModal('modal-relatorios')">Gerar Relatórios</button>
</div>
</div>
<div class="upload-area">
<div style="display:flex;justify-content:space-around;margin-bottom:20px;">
<div><p style="font-size:10px;color:var(--text3);">ARQUIVOS R2</p><h3 style="color:var(--cyan);">143</h3></div>
<div><p style="font-size:10px;color:var(--text3);">USO DE BANDA</p><h3 style="color:var(--cyan);">1.2 TB</h3></div>
<div><p style="font-size:10px;color:var(--text3);">ÚLTIMO UPLOAD</p><h3 style="color:var(--cyan);">31/07</h3></div>
</div>
<p style="font-size:13px;color:var(--text2);">Arraste arquivos MP3 para o Bucket Zeep</p>
<button class="btn btn-ghost btn-sm" style="margin-top:10px;">Selecionar Arquivos</button>
</div>
<div class="search-bar">
<input type="text" id="search-playlist-client" placeholder="Buscar por cliente..." oninput="filterClients()" style="flex:1;">
<button class="btn btn-primary" onclick="openModal('modal-nova-playlist')">+ Nova Playlist</button>
</div>
<div id="playlist-accordion"></div>
</section>
<!-- ============ VINHETAS DA MARCA ============ -->
<section id="vinhetas-marca" class="module">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <span style="font-size:14px;font-weight:700;color:var(--text2);">Vinhetas da Marca</span>
  </div>

  <!-- Formulário de adição -->
  <div style="background:var(--navy);border:1px solid var(--border2);border-radius:10px;padding:16px;margin-bottom:16px;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:12px;">
      <select id="vm-cliente" style="padding:8px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--text);">
        <option value="">Selecione o cliente...</option>
      </select>
      <select id="vm-unidade" style="padding:8px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--text);">
        <option value="">Todas as unidades (Matriz)</option>
      </select>
      <input type="number" id="vm-intervalo" value="5" min="1" placeholder="A cada X músicas"
        style="padding:8px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--text);">
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
      <input type="file" id="vm-arquivo" accept="audio/mpeg,.mp3" style="flex:1;color:var(--text);">
      <button class="btn btn-primary" onclick="vmEnviar()">Enviar Vinheta</button>
    </div>
  </div>

  <!-- Lista -->
  <table class="data-table">
  <thead>
    <tr><th>#</th><th>VINHETA</th><th>DURAÇÃO</th><th>PREVIEW</th><th>AÇÃO</th></tr>
  </thead>
  <tbody id="vm-tbody">
    <tr><td colspan="4" style="color:var(--text3);">Carregando vinhetas…</td></tr>
  </tbody>
</table>
</section>
<section id="biblioteca" class="module">
  <div class="section-title">
    <span>Biblioteca de Música</span>
    <span id="biblioteca-count" style="font-size:11px;color:var(--text3);">Carregando…</span>
  </div>
  <div class="search-bar">
    <input type="text" id="biblioteca-search" placeholder="Buscar por título, artista ou álbum…" oninput="searchBiblioteca()" style="flex:1;">
    <button class="btn btn-ghost" onclick="loadBiblioteca()">↻ Atualizar</button>
  </div>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Música</th>
          <th>Artista</th>
          <th>Álbum</th>
          <th>Gênero</th>
          <th>Duração</th>
          <th>Preview</th>
        </tr>
      </thead>
      <tbody id="biblioteca-tbody">
        <tr><td colspan="7" style="color:var(--text3);">Carregando biblioteca…</td></tr>
      </tbody>
    </table>
  </div>
</section>
<!-- Playlists Biblioteca Zeep -->
<section id="biblioteca-zeep" class="module">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <span style="font-size:14px;font-weight:700;color:var(--text2);">Playlists Biblioteca Zeep</span>
        <button class="btn btn-primary btn-sm" onclick="zeepNova()">+ Nova Playlist</button>
    </div>
    <div id="zeep-accordion"></div>
</section>
<!-- Upload R2 -->
<section id="upload-r2" class="module">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <span style="font-size:14px;font-weight:700;color:var(--text2);">Upload R2</span>
    </div>
    <div id="zeep-upload-content"></div>
</section>
<!-- ============ VINHETAS (Opção A - Supabase) ============ -->
<section id="vinhetas" class="module">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <span style="font-size:14px;font-weight:700;color:var(--text2);">Vinhetas</span>
  </div>
  <div style="background:var(--navy);border:1px solid var(--border2);border-radius:10px;padding:16px;margin-bottom:16px;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:12px;">
      <select id="vh-cliente" style="padding:8px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--text);">
        <option value="">Selecione o cliente...</option>
      </select>
      <select id="vh-unidade" style="padding:8px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--text);">
        <option value="">Todas as unidades (Matriz)</option>
      </select>
      <input type="number" id="vh-intervalo" value="5" min="1" placeholder="A cada X músicas" style="padding:8px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--text);">
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
      <input type="file" id="vh-arquivo" accept="audio/mpeg,.mp3" style="flex:1;color:var(--text);">
      <button class="btn btn-primary" onclick="zeepEnviarVinheta()">Enviar Vinheta</button>
    </div>
  </div>
  <div id="vh-lista" style="font-size:12px;color:var(--text3);">Carregando vinhetas...</div>
</section>
<section id="pagamentos" class="module">
<div class="section-title">Financeiro</div>
<div class="grid-metrics">
<div class="card-metric c4"><p>Receita Mensal</p><h3>R$ 8.742</h3></div>
<div class="card-metric c2"><p>Adimplência</p><h3>98.8%</h3></div>
<div class="card-metric c5"><p>Inadimplentes</p><h3>01</h3></div>
</div>
<div class="table-container">
<table>
<thead><tr><th>Cliente</th><th>Vencimento</th><th>Valor</th><th>Status</th><th>Ações</th></tr></thead>
<tbody id="pagamentos-body"></tbody>
</table>
</div>
</section>
<section id="sac" class="module"></section>
<!-- Configurações -->
<section id="config" class="module">
  <div class="config-tabs">
    <div class="config-tab active" onclick="zeepConfigAba('funcionarios', this)">Funcionários</div>
    <div class="config-tab" onclick="zeepConfigAba('chaves', this)">Chaves API</div>
  </div>

  <!-- Aba Funcionários -->
  <div id="config-funcionarios" class="config-panel active">
    <div class="config-toolbar">
      <h3>Funcionários da Zeep</h3>
      <button class="btn btn-primary" onclick="zeepNovoFuncionario()">+ Novo Funcionário</button>
    </div>
    <div class="table-container">
      <table>
        <thead>
          <tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Status</th><th style="text-align:right;">Ações</th></tr>
        </thead>
        <tbody id="zeep-func-tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- Aba Chaves API -->
  <div id="config-chaves" class="config-panel">
    <div class="config-toolbar"><h3>Chaves de Integração</h3></div>

    <div class="api-card">
      <h4>🔑 Supabase</h4>
      <p>URL do projeto e chave anon — usadas pelo App e pelo Dashboard.</p>
      <div class="form-group"><label>Supabase URL</label><input type="text" id="chave-supabase-url" placeholder="https://xxxx.supabase.co"></div>
      <div class="form-group"><label>Supabase Anon Key</label>
        <div class="key-row"><input type="password" id="chave-supabase-anon" placeholder="eyJhbGciOi..."><button class="key-eye" onclick="zeepMostrarChave('chave-supabase-anon', this)">👁</button></div>
      </div>
    </div>

    <div class="api-card">
      <h4>☁️ R2 Cloudflare</h4>
      <p>Bucket de armazenamento das músicas e vinhetas.</p>
      <div class="form-group"><label>Account ID</label><input type="text" id="chave-r2-account" placeholder="Account ID"></div>
      <div class="form-group"><label>Access Key ID</label>
        <div class="key-row"><input type="password" id="chave-r2-key" placeholder="Access Key ID"><button class="key-eye" onclick="zeepMostrarChave('chave-r2-key', this)">👁</button></div>
      </div>
      <div class="form-group"><label>Secret Access Key</label>
        <div class="key-row"><input type="password" id="chave-r2-secret" placeholder="Secret Access Key"><button class="key-eye" onclick="zeepMostrarChave('chave-r2-secret', this)">👁</button></div>
      </div>
      <div class="form-group"><label>Bucket</label><input type="text" id="chave-r2-bucket" placeholder="zeep-audio"></div>
    </div>

    <div class="api-card">
      <h4>🎙️ ElevenLabs</h4>
      <p>Geração de vinhetas de recados dinâmicos (Plano Enterprise).</p>
      <div class="form-group"><label>API Key</label>
        <div class="key-row"><input type="password" id="chave-elevenlabs" placeholder="API Key"><button class="key-eye" onclick="zeepMostrarChave('chave-elevenlabs', this)">👁</button></div>
      </div>
    </div>

    <button class="btn btn-primary" onclick="zeepSalvarChaves()">Salvar Chaves</button>
  </div>
</section>
</div>
</main>
<div id="modal-novo-cliente" class="modal" onclick="if(event.target===this)closeModal('modal-novo-cliente')">
  <div class="modal-content modal-sm">
    <h3>+ Novo Cliente (Manual)</h3>
    <p style="font-size:11px;color:var(--text3);margin-bottom:20px;">Criação manual sem Stripe. Os dados ficam prontos para inserção no Supabase (tabela users) com pagamento por baixa manual.</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <div><label>Nome da Empresa</label><input id="nc-nome" placeholder="Ex.: Jangada"></div>
      <div><label>E-mail de Acesso</label><input id="nc-email" type="email" placeholder="empresa@email.com"></div>
      <div><label>Plano</label><select id="nc-plano" onchange="calcularValorCliente()">
        <option value="Standard">Standard — R$ 279</option>
        <option value="Business" selected>Business — R$ 599</option>
        <option value="Enterprise">Enterprise — R$ 799</option>
      </select></div>
      <div><label>Status</label><select id="nc-status">
        <option selected>Ativo</option><option>Inativo</option>
      </select></div>
      <div><label>Nº de Unidades (Filiais)</label><input id="nc-unidades" type="number" min="1" value="1" oninput="calcularValorCliente()"></div>
      <div><label>Forma de Pagamento</label><select id="nc-pagamento">
        <option>Dinheiro</option><option>Cartão</option><option>Pix</option><option>Boleto</option>
      </select></div>
      <div><label>CNPJ / Documento</label><input id="nc-document" placeholder="00.000.000/0000-00"></div>
      <div><label>Telefone</label><input id="nc-phone" placeholder="(11) 99999-9999"></div>
      <div style="grid-column:1/3;"><label>Endereço</label><input id="nc-address" placeholder="Rua, número, bairro, cidade"></div>
      <div style="grid-column:1/3;"><label>Segmento</label><input id="nc-segmento" placeholder="Ex.: Restaurante, Academia, Clínica"></div>
      <div style="grid-column:1/3;"><label>Valor Mensal (R$) — calculado automaticamente</label><input id="nc-valor" readonly style="color:var(--cyan);font-weight:700;"></div>
    </div>
    <p id="nc-valor-detalhe" style="font-size:11px;color:var(--text2);margin:10px 0 4px;"></p>
    <p style="font-size:10px;color:var(--text3);">Valores de referência: Standard R$ 279 · Business R$ 599 · Enterprise R$ 799 · a 1ª unidade é a Matriz (inclusa) · cada filial adicional R$ 99,90</p>
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">
      <button class="btn btn-ghost" onclick="closeModal('modal-novo-cliente')">Cancelar</button>
      <button class="btn btn-primary" onclick="criarClienteManual()">Criar Cliente</button>
    </div>
  </div>
</div>
<div id="modal-ver-cliente" class="modal">
<div class="modal-content">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
<h3 style="margin:0;color:var(--cyan);" id="vc-nome">Cliente</h3>
<button class="btn btn-ghost btn-sm" onclick="closeModal('modal-ver-cliente')">Fechar</button>
</div>
<div style="display:flex;gap:10px;margin-bottom:20px;">
<span class="badge badge-prod" id="vc-plano"></span>
<span class="badge badge-plan" id="vc-status"></span>
</div>
<div class="grid-3" style="margin-bottom:20px;">
<div class="card-metric c1"><p>Playlists</p><h3 id="vc-playlists">0</h3></div>
<div class="card-metric c2"><p>Unidades</p><h3 id="vc-unidades">0</h3></div>
<div class="card-metric c4"><p>Receita Total</p><h3 id="vc-receita">R$ 0</h3></div>
</div>
<div class="section-title">Unidades do Cliente <button class="btn btn-primary btn-sm" onclick="abrirNovaUnidade()">+ Nova Unidade</button></div>
<div id="vc-unidades-list"></div>
<div class="section-title">Playlists do Cliente</div>
<div id="vc-playlists-list" style="display:none;"></div>
<button class="btn btn-ghost btn-sm" style="width:100%;margin-top:10px;" onclick="criarPlaylistCliente()">+ Nova Playlist</button>
<div id="cliente-playlists" style="margin-top:10px;"></div>
<div class="section-title">Vinhetas da Marca</div>
<div id="vc-vinhetas-list" style="margin-bottom:10px;"></div>
<div class="section-title">Pagamentos Recentes</div>
<div id="vc-pagamentos-list"></div>
</div>
</div>
<div id="modal-nova-unidade" class="modal">
<div class="modal-content modal-sm">
<h3 id="unidade-modal-titulo">+ Nova Unidade</h3>
<p style="font-size:11px;color:var(--text3);margin-bottom:15px;">Cliente: <strong id="unidade-cliente-nome"></strong></p>
<label>Nome da Unidade</label>
<input type="text" id="unidade-nome" placeholder="Ex: Jangada Cambuí - Unidade 01">
<label>Cidade</label>
<input type="text" id="unidade-cidade" placeholder="Ex: Campinas - SP">
<label>Endereço</label>
<input type="text" id="unidade-endereco" placeholder="Ex: Av. Norte Sul, 123">
<label>Responsável Local</label>
<input type="text" id="unidade-responsavel" placeholder="Ex: João Silva">
<label>E-mail de Contato</label>
<input type="email" id="unidade-email" placeholder="Ex: joao@jangada.com.br">
<div style="display:flex;gap:10px;margin-top:20px;">
<button class="btn btn-primary" onclick="salvarUnidade()">Salvar Unidade</button>
<button class="btn btn-ghost" onclick="closeModal('modal-nova-unidade')">Cancelar</button>
</div>
</div>
</div>
<div id="modal-remover-unidade" class="modal">
<div class="modal-content modal-sm">
<h3 style="color:var(--red);">Remover Unidade</h3>
<p style="font-size:12px;color:var(--text2);margin-bottom:15px;">Tem certeza que deseja remover a unidade <strong id="remover-unidade-nome"></strong>?</p>
<p style="font-size:11px;color:var(--text3);margin-bottom:15px;">O contrato e o faturamento do cliente serão ajustados. Se o pagamento for via Stripe, a cobrança será atualizada automaticamente.</p>
<div style="display:flex;gap:10px;margin-top:20px;">
<button class="btn btn-danger" onclick="confirmarRemoverUnidade()">Sim, Remover</button>
<button class="btn btn-ghost" onclick="closeModal('modal-remover-unidade')">Cancelar</button>
</div>
</div>
</div>
<div id="modal-nova-playlist" class="modal">
<div class="modal-content modal-sm">
<h3>+ Nova Playlist</h3>
<label>Cliente</label>
<select id="np-cliente"></select>
<label>Nome da Playlist</label>
<input type="text" id="np-nome" placeholder="Ex: Jangada @ Almoço">
<label>Descrição</label>
<input type="text" id="np-desc" placeholder="Ex: Lounge e Bossa Nova para o meio-dia">
<div class="grid-2">
<div><label>Horário Início</label><input type="time" id="np-horario-inicio" value="11:00"></div>
<div><label>Horário Fim</label><input type="time" id="np-horario-fim" value="14:00"></div>
</div>
<p style="font-size:11px;color:var(--text3);margin-bottom:15px;">O Player trocará para esta playlist no horário de início e encerrará no horário de fim.</p>
<div style="display:flex;gap:10px;margin-top:20px;">
<button class="btn btn-primary" onclick="criarPlaylist()">Criar Playlist</button>
<button class="btn btn-ghost" onclick="closeModal('modal-nova-playlist')">Cancelar</button>
</div>
</div>
</div>
<div id="modal-add-musicas" class="modal">
<div class="modal-content">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
<h3 style="margin:0;color:var(--cyan);">Adicionar Músicas</h3>
<button class="btn btn-ghost btn-sm" onclick="closeModal('modal-add-musicas')">Fechar</button>
</div>
<p style="font-size:12px;color:var(--text2);margin-bottom:15px;">Playlist: <strong id="am-playlist-nome"></strong></p>
<div class="search-bar">
<select id="am-filtro-campo" style="flex:0 0 130px;">
<option value="titulo">Título</option>
<option value="artista">Artista</option>
<option value="album">Álbum</option>
<option value="genero">Gênero</option>
</select>
<input type="text" id="am-search" placeholder="Buscar na biblioteca..." oninput="renderAddMusicas()" style="flex:2;">
<button class="btn btn-primary" onclick="addSelecionadas()">+ Adicionar Selecionadas</button>
</div>
<div class="table-container">
<table>
<thead><tr><th class="check-cell"><input type="checkbox" onclick="toggleAllAm(this)"></th><th>#</th><th>Título</th><th>Artista</th><th>Álbum</th><th>Gênero</th><th>Preview</th></tr></thead>
<tbody id="add-musicas-body"></tbody>
</table>
</div>
</div>
</div>
<div id="modal-add-musica-lib" class="modal">
<div class="modal-content modal-sm">
<h3 style="color:var(--cyan);">Adicionar à Playlist</h3>
<p style="font-size:12px;color:var(--text2);margin-bottom:15px;">Selecione a playlist para adicionar a música:</p>
<div id="playlist-select-list"></div>
<div style="margin-top:20px;">
<button class="btn btn-ghost" onclick="closeModal('modal-add-musica-lib')">Cancelar</button>
</div>
</div>
</div>
<div id="modal-baixa-pagamento" class="modal">
<div class="modal-content modal-sm">
<h3 style="color:var(--cyan);">Dar Baixa no Pagamento</h3>
<p style="font-size:12px;color:var(--text2);margin-bottom:15px;">Cliente: <strong id="bp-cliente"></strong></p>
<p style="font-size:12px;color:var(--text2);margin-bottom:15px;">Valor: <strong id="bp-valor"></strong></p>
<label>Forma de Pagamento</label>
<select id="bp-forma" onchange="toggleFormaOutro()">
<option>Dinheiro</option>
<option>PIX</option>
<option>Transferência Bancária</option>
<option>Cartão (Offline)</option>
<option>Boleto (Manual)</option>
<option>Outro</option>
</select>
<div id="bp-outro-wrap" style="display:none;">
<label>Descrição da Baixa</label>
<input type="text" id="bp-outro" placeholder="Ex: Permuta, cortesia, acordo comercial...">
</div>
<label>Data do Pagamento</label>
<input type="date" id="bp-data">
<div style="display:flex;gap:10px;margin-top:20px;">
<button class="btn btn-success" onclick="confirmarBaixa()">Confirmar Baixa</button>
<button class="btn btn-ghost" onclick="closeModal('modal-baixa-pagamento')">Cancelar</button>
</div>
</div>
</div>
<div id="modal-hist-sac" class="modal">
<div class="modal-content">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
<h3 style="margin:0;color:var(--cyan);" id="hs-titulo">Histórico do SAC</h3>
<button class="btn btn-ghost btn-sm" onclick="closeModal('modal-hist-sac')">Fechar</button>
</div>
<div style="display:flex;gap:10px;margin-bottom:20px;">
<span class="badge" id="hs-status"></span>
<span class="badge" id="hs-prioridade"></span>
<span class="badge badge-prod" id="hs-data"></span>
</div>
</div>
<div id="modal-relatorios" class="modal">
<div class="modal-content">
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
<h3 style="margin:0;color:var(--cyan);">Relatórios Gerenciais</h3>
<button class="btn btn-ghost btn-sm" onclick="closeModal('modal-relatorios')">Fechar</button>
</div>
<div class="search-bar">
<select id="rel-cliente" style="flex:1;"></select>
<input type="date" id="rel-inicio" style="flex:1;">
<input type="date" id="rel-fim" style="flex:1;">
<button class="btn btn-primary" onclick="gerarRelatorio()">Gerar</button>
</div>
<div id="rel-resultado"></div>
</div>
</div>
<audio id="preview-audio"></audio>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* ═══ HELPERS GLOBAIS (colar aqui, bem no topo) ═══ */

/* Traduz o status do banco para exibição PT-BR */
function exibirStatus(st) {
  if (st === 'ACTIVE' || st === 'Ativo' || st === 'active') return 'Ativo';
  if (st === 'INACTIVE' || st === 'Inativo') return 'Inativo';
  if (st === 'PENDING' || st === 'Pendente') return 'Pendente';
  return st || 'Ativo';
}

/* Receita para exibição: usa billing se vier; senão valor do plano × unidades */
function receitaExibida(c) {
  var v = c.receita_total || c.receitaTotal || 0;
  if (v) return v;
  var base = Number(c.valor_mensal || c.valor || 0);
  var qtd = Number(c.unidades || (c.units ? c.units.length : 1)) || 1;
  return base * qtd;
}

var db = {
  clients: [], clientes: [], unidades: [], units: [], tracks: [],
  bibliotecaZeep: [], playlists: [], pagamentos: [], chats: [], histSAC: []
};

var activeChat = 0;
var currentPlaylistId = null;
var currentPagamentoId = null;
var previewTimer = null;
var sacFilter = 'todos';
var currentClientId = null;
var currentUnidadeId = null;
var unidadeEditando = null;
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'<','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function nav(id, el) {
document.querySelectorAll('.module').forEach(function(m) { m.classList.remove('active'); });
document.querySelectorAll('.nav-item').forEach(function(i) { i.classList.remove('active'); });
document.getElementById(id).classList.add('active');
el.classList.add('active');
document.getElementById('page-title').innerText = el.innerText;
if (id === 'playlists') renderPlaylistAccordion();
if (id === 'biblioteca') renderBiblioteca();
if (id === 'sac') { renderChats(); openChat(0); renderHistSAC(); updateSACCounters(); }
if (id === 'clientes') renderClients();
if (id === 'pagamentos') renderPagamentos();
}
function openModal(id) { document.getElementById(id).style.display = 'flex'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
function formatMoney(v) {
  const n = Number(v) || 0;
  return n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
}
function daysUntilNextUpdate(updatedDate) {
var today = new Date();
var parts = updatedDate.split('-');
var updated = new Date(parts[0], parts[1]-1, parts[2]);
var next = new Date(updated);
next.setDate(next.getDate() + 30);
var diff = Math.ceil((next - today) / (1000*60*60*24));
if (diff < 0) return '<span style="color:var(--red);">Atualização atrasada</span>';
if (diff === 0) return '<span style="color:var(--amber);">Atualização hoje</span>';
if (diff === 1) return '<span style="color:var(--amber);">Falta 1 dia para atualização</span>';
return '<span style="color:var(--amber);">Faltam ' + diff + ' dias para atualização</span>';
}
function simulatePreview(btn) {
var row = btn.closest('tr');
var bar = row.querySelector('.progress-sim');
var fill = row.querySelector('.progress-bar');
if (!bar) return;
bar.style.display = 'block';
fill.style.width = '0%';
var p = 0;
previewTimer = setInterval(function() {
p += 3;
fill.style.width = p + '%';
if (p >= 100) { clearInterval(previewTimer); bar.style.display = 'none'; }
}, 100);
}
function playPreview(btn, url) {
var audio = document.getElementById('preview-audio');
if (previewTimer) { clearInterval(previewTimer); audio.pause(); }
if (!url) { simulatePreview(btn); return; }
var row = btn.closest('tr');
var bar = row.querySelector('.progress-sim');
var fill = row.querySelector('.progress-bar');
audio.src = url;
audio.load();
var fallbackTimer = setTimeout(function() { simulatePreview(btn); }, 3000);
audio.onloadedmetadata = function() {
clearTimeout(fallbackTimer);
audio.currentTime = audio.duration / 2;
audio.play();
if (bar) { bar.style.display = 'block'; fill.style.width = '0%'; }
var p = 0;
previewTimer = setInterval(function() {
p += (100 / 15) * 0.1;
if (fill) fill.style.width = Math.min(p, 100) + '%';
}, 100);
setTimeout(function() {
audio.pause();
clearInterval(previewTimer);
if (bar) bar.style.display = 'none';
}, 15000);
};
audio.onerror = function() {
clearTimeout(fallbackTimer);
simulatePreview(btn);
};
}
function filterClients() {
var q = document.getElementById('search-playlist-client').value.toLowerCase();
var rows = document.querySelectorAll('.client-row');
rows.forEach(function(r) {
var name = r.getAttribute('data-name');
if (name) {
r.style.display = name.toLowerCase().indexOf(q) > -1 ? 'block' : 'none';
}
});
}
function renderPlaylistAccordion() {
var acc = document.getElementById('playlist-accordion');
acc.innerHTML = '';
var sorted = db.clients.slice().sort(function(a,b){ return a.name.localeCompare(b.name); });
sorted.forEach(function(c) {
var cPlaylists = db.playlists.filter(function(p){ return p.clientId === c.id; });
var html = '<div class="client-row" data-name="' + c.name + '">';
html += '<div class="client-header" onclick="toggleClient(' + c.id + ')">';
html += '<span><strong style="color:var(--text);">' + (c.nome || c.name) + '</strong> <span style="color:var(--text3);font-size:11px;">(' + zeepContarPlaylists(c) + ' playlists)</span></span>';
html += '<span style="color:var(--cyan);font-size:11px;">▼ Clique para expandir</span>';
html += '</div>';
html += '<div class="client-content" id="client-content-' + c.id + '">';
if (cPlaylists.length === 0) {
html += '<p style="color:var(--text3);text-align:center;padding:20px;">Nenhuma playlist cadastrada.</p>';
} else {
cPlaylists.forEach(function(p) {
html += '<div class="playlist-box">';
html += '<div class="playlist-head">';
html += '<div style="flex:1;"><input type="text" value="' + p.name + '" onchange="renamePlaylist(' + p.id + ', this.value)" style="font-weight:700;font-size:16px;border:none;background:transparent;padding:0;width:100%;">';
html += '<p style="font-size:10px;color:var(--text3);margin-top:4px;">' + p.desc + '</p></div>';
html += '<div style="text-align:right;flex-shrink:0;">' + daysUntilNextUpdate(p.updated) + '</div>';
html += '</div>';
html += '<div style="display:flex;gap:15px;margin-bottom:20px;">';
html += '<div style="width:120px;"><label>Início</label><input type="time" value="' + p.timeInicio + '" onchange="updatePlaylistTimeInicio(' + p.id + ', this.value)"></div>';
html += '<div style="width:120px;"><label>Fim</label><input type="time" value="' + p.timeFim + '" onchange="updatePlaylistTimeFim(' + p.id + ', this.value)"></div>';
html += '<div style="flex:1;"><label>Descrição</label><input type="text" value="' + p.desc + '" onchange="updatePlaylistDesc(' + p.id + ', this.value)"></div>';
html += '</div>';
html += '<div class="table-container" style="margin-bottom:10px;">';
html += '<table><thead><tr><th>#</th><th>Título</th><th>Artista</th><th>Álbum</th><th>Gênero</th><th>Ações</th></tr></thead><tbody>';
if (!p.tracks || p.tracks.length === 0) {
html += '<tr><td colspan="7" style="color:var(--text3);">Nenhuma música nesta playlist. Use "+ Adicionar Músicas".</td></tr>';
} else {
var pos = 0;
p.tracks.forEach(function(tid) {
var t = (typeof bibliotecaTracks !== 'undefined') ? bibliotecaTracks.find(function(b){ return b.key === tid; }) : null;
if (t) {
pos++;
html += '<tr><td>' + pos + '</td><td><strong>' + esc(t.title || t.name) + '</strong></td><td>' + esc(t.artist || '—') + '</td><td>' + esc(t.album || '—') + '</td><td>' + esc(t.genre || '—') + '</td>';
html += '<td class="genre-cell" id="genre-' + esc(t.key) + '">' + esc(t.genre || '—') + ' <button class="btn-edit-genre" data-key="' + esc(t.key) + '" onclick="event.stopPropagation(); editGenre(this)">✏️</button></td>';
html += '<td><div class="actions-cell"><button class="play-btn" onclick="playTrackByKey(\'' + esc(tid).replace(/'/g, "\'") + '\')">▶</button><button class="add-btn" onclick="removeFromPlaylist(' + p.id + ', \'' + esc(tid).replace(/'/g, "\'") + '\')">−</button></div></td></tr>';
}
});
}
html += '</tbody></table></div>';
html += '<div style="display:flex;gap:10px;margin-top:10px;">';
html += '<button class="btn btn-ghost btn-sm" onclick="openAddMusicas(' + p.id + ')">+ Adicionar Músicas</button>';
html += '<button class="btn btn-ghost btn-sm" onclick="zeepCopiarPlaylist(' + p.id + ')">Copiar</button>';
html += '<button class="btn btn-danger btn-sm" onclick="removerTodasPlaylist(' + p.id + ')">Remover Todas</button>';
html += '<button class="btn btn-danger btn-sm" onclick="deletePlaylist(' + p.id + ')">Excluir Playlist</button>';
html += '</div>';
html += '</div>';
});
}
html += '</div></div>';
acc.innerHTML += html;
});
}
function toggleClient(id) {
var content = document.getElementById('client-content-' + id);
var isVisible = content.style.display === 'block';
document.querySelectorAll('.client-content').forEach(function(c){ c.style.display = 'none'; });
content.style.display = isVisible ? 'none' : 'block';
}
function criarPlaylist() {
var clientId = parseInt(document.getElementById('np-cliente').value);
var nome = document.getElementById('np-nome').value.trim();
var desc = document.getElementById('np-desc').value.trim();
var timeInicio = document.getElementById('np-horario-inicio').value;
var timeFim = document.getElementById('np-horario-fim').value;
if (!nome) { alert("Digite o nome da playlist"); return; }
var newId = Date.now();
db.playlists.push({ id: newId, clientId: clientId, name: nome, desc: desc, timeInicio: timeInicio, timeFim: timeFim, updated: "2026-07-31", tracks: [] });
var c = db.clients.find(function(x){ return x.id === clientId; });
c.playlists = c.playlists + 1;
closeModal('modal-nova-playlist');
document.getElementById('np-nome').value = '';
document.getElementById('np-desc').value = '';
renderPlaylistAccordion();
alert("Playlist '" + nome + "' criada com sucesso!");
}
function renamePlaylist(id, name) {
var p = db.playlists.find(function(x){ return x.id === id; });
if (p) p.name = name;
}
function updatePlaylistTimeInicio(id, time) {
var p = db.playlists.find(function(x){ return x.id === id; });
if (p) p.timeInicio = time;
}
function updatePlaylistTimeFim(id, time) {
var p = db.playlists.find(function(x){ return x.id === id; });
if (p) p.timeFim = time;
}
function updatePlaylistDesc(id, desc) {
var p = db.playlists.find(function(x){ return x.id === id; });
if (p) p.desc = desc;
}
function deletePlaylist(id) {
if (!confirm("Excluir esta playlist?")) return;
db.playlists = db.playlists.filter(function(p){ return p.id !== id; });
renderPlaylistAccordion();
}
function openAddMusicas(playlistId) {
currentPlaylistId = playlistId;
var p = db.playlists.find(function(x){ return x.id === playlistId; });
document.getElementById('am-playlist-nome').innerText = p.name;
document.getElementById('am-search').value = '';
renderAddMusicas();
openModal('modal-add-musicas');
}
function renderAddMusicas() {
var q = document.getElementById('am-search').value.toLowerCase();
var campo = document.getElementById('am-filtro-campo').value;
var p = db.playlists.find(function(x){ return x.id === currentPlaylistId; });
var body = document.getElementById('add-musicas-body');
body.innerHTML = '';
var list = (typeof bibliotecaTracks !== 'undefined' && bibliotecaTracks.length) ? bibliotecaTracks : db.tracks.map(function(m){ return { key: String(m.id), title: m.t, artist: m.a, album: m.alb, genre: m.g }; });
if (list.length === 0) { body.innerHTML = '<tr><td colspan="7" style="color:var(--text3);">Nenhuma música na biblioteca. Recarregue a Biblioteca de Música.</td></tr>'; return; }
var idx = 0;
list.forEach(function(t) {
var match = true;
if (q) {
if (campo === 'titulo') match = (t.title || '').toLowerCase().indexOf(q) > -1;
if (campo === 'artista') match = (t.artist || '').toLowerCase().indexOf(q) > -1;
if (campo === 'album') match = (t.album || '').toLowerCase().indexOf(q) > -1;
if (campo === 'genero') match = (t.genre || '').toLowerCase().indexOf(q) > -1;
}
if (!match) return;
idx++;
var key = t.key;
var already = p.tracks.indexOf(key) > -1;
body.innerHTML += '<tr><td class="check-cell"><input type="checkbox" class="am-check" value="' + esc(key) + '"' + (already ? ' checked disabled' : '') + '></td><td>' + idx + '</td><td><strong>' + esc(t.title || t.name) + '</strong></td><td>' + esc(t.artist || '—') + '</td><td>' + esc(t.album || '—') + '</td><td>' + esc(t.genre || '—') + '</td><td><button class="play-btn" onclick="playTrackByKey(\'' + esc(key).replace(/'/g, "\'") + '\')">▶</button></td></tr>';
});
}
function toggleAllAm(el) {
var checks = document.querySelectorAll('.am-check:not(:disabled)');
checks.forEach(function(c){ c.checked = el.checked; });
}
function addSelecionadas() {
  var checks = document.querySelectorAll('.am-check:checked');
  if (checks.length === 0) { alert("Selecione ao menos uma música"); return; }
  var p = db.playlists.find(function(x){ return x.id === currentPlaylistId; });
  if (!p) { alert('Playlist não encontrada. Recarregue a lista.'); return; }
  var added = 0;
  checks.forEach(function(c) {
    var key = c.value;
    if (p.tracks.indexOf(key) === -1) { p.tracks.push(key); added++; }
  });
  // ── Novo: persiste no backend (substitui as faixas da playlist) ──
  var ids = p.tracks.filter(function(k){ return k && k.length === 36; });
  if (ids.length === 0) {
    alert('Nenhuma música com UUID válido selecionada. As músicas da biblioteca precisam ter o id do Supabase.');
    return;
  }
  zeepApi('PUT', '/playlists/' + currentPlaylistId + '/tracks', { track_ids: ids })
    .then(function(r) {
      if (!r || r.success === false) throw new Error(r.message || 'Erro no servidor');
      renderPlaylistAccordion();
      closeModal('modal-add-musicas');
      alert(added + " música(s) adicionada(s)! Total na playlist: " + r.faixas_vinculadas);
      zeepRefresh();
    })
    .catch(function(e) {
      alert('Erro ao salvar no servidor: ' + (e.message || e));
    });
}

function removeFromPlaylist(playlistId, trackKey) {
  var p = db.playlists.find(function(x){ return String(x.id) === String(playlistId); }) ||
          db.playlists.find(function(x){ return String(x._key) === String(playlistId); });
  if (!p) return;
  var realId = zeepUuidPlaylist(p);
  if (!realId) { alert('Playlist sem id do servidor. Recarregue a página (Cmd+Shift+R).'); return; }

  var tracks = Array.isArray(p.tracks) ? p.tracks.slice() : [];
  var ids    = Array.isArray(p._trackIds) ? p._trackIds.slice() : [];

  // Acha o índice do alvo (por título OU por id/chave)
  var idx = -1;
  for (var i = 0; i < tracks.length; i++) {
    var t = tracks[i];
    var titulo = (t && typeof t === 'object') ? (t.title || t.nome || t.name || '') : String(t);
    var chave  = (t && typeof t === 'object') ? (t.id || t.key || t._key || '') : '';
    if (String(titulo) === String(trackKey) || String(chave) === String(trackKey)) { idx = i; break; }
  }
  if (idx < 0) return;

  var removerId = (ids && ids[idx]) || '';

  // Atualiza o estado local ANTES da chamada (otimista) — a faixa some na hora
  tracks.splice(idx, 1);
  if (ids.length === tracks.length + 1) ids.splice(idx, 1);
  p.tracks = tracks;
  p._trackIds = ids;

  // ★ Recarrega SOMENTE no erro (para restaurar a verdade se algo falhar)
  function recarregar() {
    if (typeof zeepCarregarPlaylists === 'function') zeepCarregarPlaylists();
    else if (typeof zeepRefresh === 'function') zeepRefresh();
    if (typeof renderPlaylistAccordion === 'function') renderPlaylistAccordion();
  }

  // ★ Se temos o UUID, usa DELETE (atômico, sem risco de 500)
  if (removerId && String(removerId).length === 36) {
    zeepApi('DELETE', '/playlists/' + realId + '/tracks', { track_ids: [removerId] })
      .then(function(){ /* otimista já removeu — não recarrega para evitar o flicker */ })
      .catch(function(e){ recarregar(); alert('Erro ao remover: ' + (e.message || e)); });
  } else {
    // Sem UUID — fallback para o PUT com a lista restante
    zeepApi('PUT', '/playlists/' + realId + '/tracks', { track_ids: ids })
      .then(function(){ /* otimista já removeu — não recarrega para evitar o flicker */ })
      .catch(function(e){ recarregar(); alert('Erro ao remover: ' + (e.message || e)); });
  }
}

function removerTodasPlaylist(playlistId) {
  var p = db.playlists.find(function(x){ return String(x.id) === String(playlistId); }) ||
          db.playlists.find(function(x){ return String(x._key) === String(playlistId); });
  if (!p) return;
  var realId = zeepUuidPlaylist(p);
  if (!realId) { alert('Playlist sem id do servidor. Recarregue a página (Cmd+Shift+R).'); return; }

  // Junta TODOS os UUIDs da playlist
  var ids = Array.isArray(p._trackIds) ? p._trackIds.slice() : [];
  if (!ids.length && Array.isArray(p.tracks)) {
    ids = p.tracks.map(function(t){
      return (t && typeof t === 'object') ? (t.id || t.track_id || t.uuid || '') : '';
    }).filter(function(k){ return k && String(k).length === 36; });
  }
  if (!ids.length) { alert('Nenhuma música com UUID para remover.'); return; }

  if (!confirm('Remover TODAS as ' + ids.length + ' música(s) desta playlist?')) return;

  // ★ UM único DELETE com todas as faixas — e UMA recarga no final
  zeepApi('DELETE', '/playlists/' + realId + '/tracks', { track_ids: ids })
    .then(function(){
      p.tracks = [];
      p._trackIds = [];
      if (typeof zeepCarregarPlaylists === 'function') zeepCarregarPlaylists();
      else if (typeof zeepRefresh === 'function') zeepRefresh();
      if (typeof renderPlaylistAccordion === 'function') renderPlaylistAccordion();
    })
    .catch(function(e){ alert('Erro ao remover: ' + (e.message || e)); });
}

/* Converte um valor em string JS segura para usar DENTRO de onclick="..." */
function jsStr(s) {
  var BS = String.fromCharCode(92);
  var SQ = String.fromCharCode(39);
  var LF = String.fromCharCode(10);
  var CR = String.fromCharCode(13);
  var str = String(s == null ? '' : s);
  var out = '';
  for (var i = 0; i < str.length; i++) {
    var c = str.charAt(i);
    if (c === BS) { out = out + BS + BS; }
    else if (c === SQ) { out = out + BS + SQ; }
    else if (c === LF || c === CR) { out = out + ' '; }
    else { out = out + c; }
  }
  return SQ + out + SQ;
}
function renderBiblioteca() {
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'<','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function fmt(sec) { if (!sec || sec <= 0) return '--:--'; var m = Math.floor(sec / 60); var s = Math.round(sec % 60); return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0'); }
var qInput = document.getElementById('biblioteca-search');
var q = qInput ? qInput.value.toLowerCase() : '';
var body = document.getElementById('biblioteca-tbody');
if (!body) return;
body.innerHTML = '';
var list = (typeof bibliotecaTracks !== 'undefined') ? bibliotecaTracks : [];
var filtered = list.filter(function(t) {
if (!q) return true;
return ((t.title || '').toLowerCase().indexOf(q) > -1) || ((t.artist || '').toLowerCase().indexOf(q) > -1) || ((t.album || '').toLowerCase().indexOf(q) > -1);
});
if (filtered.length === 0) {
body.innerHTML = '<tr><td colspan="7" style="color:var(--text3);">Nenhuma música encontrada.</td></tr>';
return;
}
filtered.forEach(function(t) {
var idx = list.indexOf(t);
var playing = (typeof currentTrackKey !== 'undefined') && currentTrackKey === t.key && typeof audioPreview !== 'undefined' && !audioPreview.paused;
var rowStyle = playing ? 'background:var(--cyan4);' : '';
body.innerHTML += '<tr style="cursor:pointer;' + rowStyle + '" onclick="playTrack(' + idx + ')">' +
'<td>' + (idx + 1) + '</td>' +
'<td><strong>' + esc(t.title || t.name) + '</strong></td>' +
'<td>' + esc(t.artist || '—') + '</td>' +
'<td>' + esc(t.album || '—') + '</td>' +
'<td class="genre-cell" id="genre-' + esc(t.key) + '">' + esc(t.genre || '—') + ' <button class="btn-edit-genre" onclick="editGenre(\'' + esc(t.key).replace(/'/g, "\'") + '\')" title="Editar gênero">✏️</button></td>' +
'<td>' + fmt(t.duration) + '</td>' +
'<td><div class="actions-cell"><button class="play-btn" onclick="event.stopPropagation(); playTrack(' + idx + ')">▶</button></div></td>' +
'</tr>';
});
}
var generosSugeridos = ['Pop','Rock','Jazz','Lounge','Bossa Nova','Eletrônica','Acústico','R&B','Soul','Clássica','Ambiente','Outro'];

function editGenre(btn) {
  var key = btn.getAttribute('data-key');
  var track = bibliotecaTracks.find(function(b){ return b.key === key; });
  if (!track) return;
  var cell = document.getElementById('genre-' + key);
  if (!cell) return;
  var atual = track.genre || '';
  var opts = generosSugeridos.map(function(g){
    return '<option value="' + esc(g) + '"' + (g === atual ? ' selected' : '') + '>' + esc(g) + '</option>';
  }).join('');
  if (atual && generosSugeridos.indexOf(atual) === -1) {
    opts = '<option value="' + esc(atual) + '" selected>' + esc(atual) + '</option>' + opts;
  }
  opts += '<option value="__outro__">Outro (digitar)...</option>';
  cell.innerHTML = '<select id="genre-select-' + key + '" onclick="event.stopPropagation();">' + opts + '</select> ' +
    '<button class="btn-edit-genre" data-key="' + key + '" onclick="event.stopPropagation(); saveGenre(this)">Salvar</button> ' +
    '<button class="btn-edit-genre" onclick="event.stopPropagation(); renderBiblioteca()">Cancelar</button>';
}

function saveGenre(btn) {
  var key = btn.getAttribute('data-key');
  var sel = document.getElementById('genre-select-' + key);
  if (!sel) return;
  var genre = sel.value;
  var track = bibliotecaTracks.find(function(b){ return b.key === key; });
  if (!track) return;
  if (genre === '__outro__') {
    var novo = prompt('Digite o novo gênero:');
    if (!novo || !novo.trim()) { renderBiblioteca(); return; }
    genre = novo.trim();
  }
  var cell = document.getElementById('genre-' + key);
  if (cell) cell.innerHTML = 'Salvando...';
  fetch(API_BASE + '/api/r2/music/genero', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ key: key, genre: genre })
  })
  .then(function(res){ return res.json(); })
  .then(function(data){
    if (data && data.success) {
      track.genre = genre;
      renderBiblioteca();
      alert('Gênero atualizado com sucesso!');
    } else {
      throw new Error((data && data.error) || 'Falha ao salvar');
    }
  })
  .catch(function(err){
    console.error('Erro ao salvar gênero:', err);
    renderBiblioteca();
    alert('Erro ao salvar gênero: ' + err.message);
  });
}
function toggleAllLib(el) {
var checks = document.querySelectorAll('.lib-check');
checks.forEach(function(c){ c.checked = el.checked; });
}
function openAddMusicaLib(trackKey) {
var list = document.getElementById('playlist-select-list');
list.innerHTML = '';
var t = (typeof bibliotecaTracks !== 'undefined') ? bibliotecaTracks.find(function(b){ return b.key === trackKey; }) : null;
if (!t) { list.innerHTML = '<p style="color:var(--text3);font-size:12px;">Música não encontrada na biblioteca.</p>'; openModal('modal-add-musica-lib'); return; }
list.innerHTML += '<p style="font-size:12px;color:var(--text2);margin-bottom:15px;">Música: <strong style="color:var(--cyan);">' + esc(t.title || t.name) + '</strong></p>';
db.playlists.forEach(function(p) {
var already = p.tracks.indexOf(trackKey) > -1;
var c = db.clients.find(function(x){ return x.id === p.clientId; });
list.innerHTML += '<div style="display:flex;justify-content:space-between;align-items:center;padding:10px;background:rgba(255,255,255,0.02);border-radius:8px;margin-bottom:8px;"><span>' + esc(p.name) + ' <span style="color:var(--text3);font-size:10px;">(' + (c ? esc(c.name) : '') + ')</span></span><button class="btn btn-sm ' + (already ? 'btn-ghost' : 'btn-primary') + '" onclick="addToPlaylist(' + p.id + ', \'' + trackKey.replace(/'/g, "\'") + '\')" ' + (already ? 'disabled' : '') + '>' + (already ? '✓ Adicionada' : '+ Adicionar') + '</button></div>';
});
openModal('modal-add-musica-lib');
}
function addToPlaylist(playlistId, trackKey) {
var p = db.playlists.find(function(x){ return x.id === playlistId; });
if (p && p.tracks.indexOf(trackKey) === -1) {
p.tracks.push(trackKey);
closeModal('modal-add-musica-lib');
renderPlaylistAccordion();
alert("Música adicionada à playlist '" + p.name + "'!");
}
}
function renderPagamentos() {
var body = document.getElementById('pagamentos-body');
body.innerHTML = '';
db.pagamentos.forEach(function(p) {
var statusClass = 'badge-plan';
if (p.status === 'Inadimplente') statusClass = 'badge-red';
if (p.status === 'Pendente') statusClass = 'badge-amber';
var formaInfo = p.forma ? ' <span style="font-size:9px;color:var(--text3);">(' + p.forma + ')</span>' : '';
body.innerHTML += '<tr><td><strong>' + p.name + '</strong></td><td>' + p.venc + '</td><td>' + p.valor + '</td><td><span class="badge ' + statusClass + '">' + p.status + '</span>' + formaInfo + '</td><td>' + (p.status !== 'Pago' ? '<button class="btn btn-success btn-sm" onclick="abrirBaixa(' + p.id + ')">Dar Baixa</button>' : '<span style="color:var(--green);font-size:11px;">✓ Quitado</span>') + '</td></tr>';
});
}
function toggleFormaOutro() {
var forma = document.getElementById('bp-forma').value;
document.getElementById('bp-outro-wrap').style.display = forma === 'Outro' ? 'block' : 'none';
}
function abrirBaixa(id) {
var p = db.pagamentos.find(function(x){ return x.id === id; });
if (!p) return;
currentPagamentoId = id;
document.getElementById('bp-cliente').innerText = p.name;
document.getElementById('bp-valor').innerText = p.valor;
document.getElementById('bp-forma').value = 'PIX';
document.getElementById('bp-outro-wrap').style.display = 'none';
document.getElementById('bp-outro').value = '';
document.getElementById('bp-data').value = new Date().toISOString().split('T')[0];
openModal('modal-baixa-pagamento');
}
function confirmarBaixa() {
var p = db.pagamentos.find(function(x){ return x.id === currentPagamentoId; });
if (p) {
var forma = document.getElementById('bp-forma').value;
if (forma === 'Outro') {
var desc = document.getElementById('bp-outro').value.trim();
if (!desc) { alert("Descreva a forma de baixa (ex: Permuta)"); return; }
p.forma = 'Outro: ' + desc;
} else {
p.forma = forma;
}
p.status = 'Pago';
closeModal('modal-baixa-pagamento');
renderPagamentos();
alert("Baixa confirmada para " + p.name + "!");
}
}
function setSacFilter(filtro) {
sacFilter = filtro;
document.getElementById('filtro-abertos').classList.remove('filtro-ativo');
document.getElementById('filtro-resolvidos').classList.remove('filtro-ativo');
document.getElementById('filtro-todos').classList.remove('filtro-ativo');
document.getElementById('filtro-' + filtro).classList.add('filtro-ativo');
renderChats();
if (db.chats.length > 0) openChat(0);
}
function getPriorityOrder(p) {
if (p === 'Alta') return 0;
if (p === 'Média') return 1;
return 2;
}
function renderChats() {
  var list = document.getElementById('chat-list');
  if (!list) return;   // ← se o elemento não existe, sai sem quebrar
  list.innerHTML = '';
  var chats = db.chats.slice();
  chats.sort(function(a, b) {
    var pa = getPriorityOrder(a.prioridade);
    var pb = getPriorityOrder(b.prioridade);
    if (pa !== pb) return pa - pb;
    return a.time.localeCompare(b.time);
  });
if (sacFilter === 'abertos') chats = chats.filter(function(c){ return c.status === 'aberto'; });
if (sacFilter === 'resolvidos') chats = chats.filter(function(c){ return c.status === 'finalizado'; });
if (chats.length === 0) {
list.innerHTML = '<p style="color:var(--text3);text-align:center;padding:20px;font-size:12px;">Nenhum chat neste filtro.</p>';
return;
}
var idxMap = {};
db.chats.forEach(function(c, i) { idxMap[c.id] = i; });
chats.forEach(function(c) {
var i = idxMap[c.id];
var prioridadeColor = 'var(--green)';
if (c.prioridade === 'Alta') prioridadeColor = 'var(--red)';
if (c.prioridade === 'Média') prioridadeColor = 'var(--amber)';
var statusBadge = c.status === 'finalizado' ? '<span class="status-tag" style="background:rgba(46,204,113,0.1);color:var(--green);margin-left:6px;">Finalizado</span>' : '';
list.innerHTML += '<div class="chat-item' + (activeChat === i ? ' active' : '') + '" onclick="openChat(' + i + ')"><div style="display:flex;justify-content:space-between;align-items:center;"><h6>' + c.name + statusBadge + '</h6><span style="font-size:8px;color:' + prioridadeColor + ';font-weight:700;">' + c.prioridade + '</span></div><p>' + c.last + '</p><span>' + c.time + '</span></div>';
});
}
function openChat(i) {
  activeChat = i;
  renderChats();
  if (!db.chats || !db.chats[i]) return;
  var c = db.chats[i];
  if (!c) return;

  var elTitulo = document.getElementById('chat-title');
  if (elTitulo) elTitulo.innerText = (c.name || 'Cliente') + ' - ' + c.prioridade;

  var btn = document.getElementById('btn-encerrar-chat');
  if (btn) btn.style.display = c.status === 'aberto' ? 'inline-flex' : 'none';

  var win = document.getElementById('chat-window');
  if (!win) return;
  win.innerHTML = '';
  (c.msgs || []).forEach(function (m) {
    var label = m.from === 'c' ? ((c.name || 'Cliente').split(' - ')[0]) : 'Você (Suporte)';
    win.innerHTML += '<div class="msg ' + (m.from === 'c' ? 'msg-client' : 'msg-me') + '">' + m.text + '<span class="msg-time">' + label + ' • ' + (m.hora || '') + '</span></div>';
  });
  win.scrollTop = win.scrollHeight;

  var inp = document.getElementById('chat-in');
  if (inp) {
    inp.disabled = c.status === 'finalizado';
    inp.placeholder = c.status === 'finalizado' ? 'Ocorrência encerrada' : 'Digite sua mensagem...';
  }
}
function sendMsg() {
var inp = document.getElementById('chat-in');
var c = db.chats[activeChat];
if (!c || c.status === 'finalizado') return;
if (inp.value.trim()) {
var now = new Date();
var hora = now.getHours() + ':' + String(now.getMinutes()).padStart(2, '0');
c.msgs.push({ from: 'm', text: inp.value.trim(), hora: hora });
inp.value = '';
openChat(activeChat);
}
}
function encerrarChat() {
var c = db.chats[activeChat];
if (!c || c.status === 'finalizado') return;
if (!confirm("Encerrar esta ocorrência? O chat será arquivado no Histórico do SAC com o histórico completo.")) return;
c.status = 'finalizado';
var now = new Date();
var data = now.toLocaleDateString('pt-BR');
var histId = Date.now();
var cliente = db.clients.find(function(x){ return x.id === c.clienteId; });
db.histSAC.push({
id: histId,
clientId: c.clienteId,
titulo: c.name + ' - ' + c.last,
data: data,
status: 'Finalizado',
prioridade: c.prioridade,
historico: c.msgs.slice()
});
renderChats();
openChat(activeChat);
renderHistSAC();
updateSACCounters();
alert("Chat encerrado e arquivado no Histórico do SAC!");
}
function renderHistSAC() {
var list = document.getElementById('hist-sac-list');
if (!list) return;   // ★ guard: se o elemento não existe, sai sem quebrar o init
list.innerHTML = '';
var sorted = db.histSAC.slice().sort(function(a,b){ return b.id - a.id; });
if (sorted.length === 0) {
list.innerHTML = '<p style="color:var(--text3);text-align:center;padding:20px;">Nenhum histórico ainda. Encerre um chat no SAC para arquivar aqui.</p>';
return;
}
sorted.forEach(function(o) {
var prioridadeColor = 'var(--green)';
if (o.prioridade === 'Alta') prioridadeColor = 'var(--red)';
if (o.prioridade === 'Média') prioridadeColor = 'var(--amber)';
var c = db.clients.find(function(x){ return x.id === o.clientId; });
list.innerHTML += '<div class="hist-item" onclick="abrirHistSAC(' + o.id + ')"><div class="hist-info"><h5>' + o.titulo + '</h5><p>' + o.data + ' • ' + (c ? c.name : '') + ' • <span style="color:' + prioridadeColor + ';">' + o.prioridade + '</span> • <span style="color:var(--cyan);">' + o.historico.length + ' mensagens</span></p></div><div style="display:flex;gap:6px;align-items:center;"><span class="status-tag" style="background:rgba(46,204,113,0.1);color:var(--green);">Finalizado</span><span style="color:var(--text3);font-size:16px;">›</span></div></div>';
});
}
function abrirHistSAC(id) {
var o = db.histSAC.find(function(x){ return x.id === id; });
if (!o) return;
var c = db.clients.find(function(x){ return x.id === o.clientId; });
document.getElementById('hs-titulo').innerText = o.titulo;
document.getElementById('hs-status').innerText = exibirStatus(o.status);
document.getElementById('hs-status').className = 'badge badge-plan';
document.getElementById('hs-prioridade').innerText = 'Prioridade: ' + o.prioridade;
document.getElementById('hs-prioridade').className = 'badge ' + (o.prioridade === 'Alta' ? 'badge-red' : (o.prioridade === 'Média' ? 'badge-amber' : 'badge-plan'));
document.getElementById('hs-data').innerText = o.data + ' • ' + (c ? c.name : '');
var hist = document.getElementById('hs-historico');
hist.innerHTML = '';
o.historico.forEach(function(m) {
var label = m.from === 'c' ? (o.titulo.split(' - ')[0]) : 'Suporte Zeep';
hist.innerHTML += '<div style="display:flex;margin-bottom:12px;' + (m.from === 'c' ? '' : 'justify-content:flex-end;') + '"><div style="max-width:75%;padding:10px 14px;border-radius:10px;' + (m.from === 'c' ? 'background:rgba(255,255,255,0.05);border:1px solid var(--border2);' : 'background:var(--cyan4);border:1px solid var(--cyan3);') + '"><div style="font-size:13px;">' + m.text + '</div><div style="font-size:9px;color:var(--text3);margin-top:5px;">' + label + ' • ' + m.hora + '</div></div></div>';
});
openModal('modal-hist-sac');
}
function updateSACCounters() {
  var chats = db.chats || [];
  var abertos = chats.filter(function (c) { return c.status === 'aberto'; }).length;
  var total = chats.length;
  var finalizadosHoje = chats.filter(function (c) { return c.status === 'finalizado'; }).length;

  var elAbertos = document.getElementById('sac-abertos');
  var elResolvidos = document.getElementById('sac-resolvidos');
  var elTotal = document.getElementById('sac-total');
  var elCard = document.getElementById('card-sac');

  if (elAbertos) elAbertos.innerText = abertos;
  if (elResolvidos) elResolvidos.innerText = finalizadosHoje;
  if (elTotal) elTotal.innerText = total;
  if (elCard) elCard.innerText = abertos;
}

function atualizarSelects() {
  var npCliente = document.getElementById('np-cliente');
  var relCliente = document.getElementById('rel-cliente');

  // ★ GUARD: dados ainda não chegaram → sai sem quebrar o init
  if (!Array.isArray(db.clients)) {
    if (npCliente) npCliente.innerHTML = '<option value="">Carregando...</option>';
    if (relCliente) relCliente.innerHTML = '<option value="todos">Todos os Clientes</option>';
    return;
  }

  var ordenados = db.clients.slice().sort(function (a, b) {
    var na = (a && (a.nome || a.name)) ? String(a.nome || a.name) : '';
    var nb = (b && (b.nome || b.name)) ? String(b.nome || b.name) : '';
    return na.localeCompare(nb);
  });

  if (npCliente) {
    npCliente.innerHTML = '';
    ordenados.forEach(function (c) {
      npCliente.innerHTML += '<option value="' + c.id + '">' + esc(c.nome || c.name) + '</option>';
    });
  }

  if (relCliente) {
    relCliente.innerHTML = '<option value="todos">Todos os Clientes</option>';
    ordenados.forEach(function (c) {
      relCliente.innerHTML += '<option value="' + c.id + '">' + esc(c.nome || c.name) + '</option>';
    });
  }
}
function zeepAtualizarInterface() {
  try { zeepBackfillPlaylists(); } catch (e) { console.warn('[ZEEP] backfill:', e.message); }
  try { atualizarSelects(); } catch (e) { console.warn('[ZEEP] atualizarSelects:', e.message); }
  try { renderClients(); } catch (e) { console.warn('[ZEEP] renderClients:', e.message); }
  try { renderPlaylistAccordion(); } catch (e) { console.warn('[ZEEP] renderPlaylistAccordion:', e.message); }
  try { renderBiblioteca(); } catch (e) { console.warn('[ZEEP] renderBiblioteca:', e.message); }
  try { renderPagamentos(); } catch (e) { console.warn('[ZEEP] renderPagamentos:', e.message); }
  try { renderChats(); } catch (e) { console.warn('[ZEEP] renderChats:', e.message); }
  try { renderHistSAC(); } catch (e) { console.warn('[ZEEP] renderHistSAC:', e.message); }
  try { updateSACCounters(); } catch (e) { console.warn('[ZEEP] updateSACCounters:', e.message); }
  try { renderPlaylistsDoCliente(); } catch (e) { console.warn('[ZEEP] renderPlaylistsDoCliente:', e.message); }
}
function zeepContarPlaylists(c) {
  if (!c) return 0;
  if (Array.isArray(c.playlistList) && c.playlistList.length) return c.playlistList.length;
  if (c.playlists_count != null) return c.playlists_count;
  if (typeof c.playlists === 'number') return c.playlists;
  // FALLBACK: conta por prefixo do título (padrão "Cliente @ Contexto")
  try {
    var nome = (c.nome || c.name || '').trim();
    if (!nome) return 0;
    var prefixo = nome + ' @';
    var n = 0;
    (window.db.playlists || []).forEach(function (p) {
      var t = (p.titulo || p.name || '').trim();
      if (t.indexOf(prefixo) === 0) n++;
    });
    return n;
  } catch (e) { return 0; }
}
function zeepGetClients() {
  if (window.db && Array.isArray(window.db.clientes)) return window.db.clientes;
  if (window.db && Array.isArray(window.db.clients)) return window.db.clients;
  return [];
}
function zeepGetPlaylists() {
  if (window.db && Array.isArray(window.db.playlists)) return window.db.playlists;
  return [];
}
function zeepNormalizarDados() {
  var clis = zeepGetClients();
  if (!clis.length) return;
  clis.forEach(function (c) {
    if (!c) return;
    if (c.nome && c.name === undefined) c.name = c.nome;
    if (c.plano && c.plan === undefined) c.plan = c.plano;
    if (Array.isArray(c.playlists)) {
      if (!Array.isArray(c.playlistList) || !c.playlistList.length) c.playlistList = c.playlists;
      if (c.playlists_count == null) c.playlists_count = c.playlists.length;
      c.playlists = c.playlists.length;
    }
  });
  zeepGetPlaylists().forEach(function (p) {
    if (!p) return;
    if (p.titulo && p.name === undefined) p.name = p.titulo;
  });
}
function zeepBackfillPlaylists() {
  var clis = zeepGetClients();
  var pls = zeepGetPlaylists();
  if (!clis.length || !pls.length) return;
  clis.forEach(function (c) {
    if (!c) return;
    var cid = c.id || c.client_id || c.company_id || c.companyId;
    if (!cid) return;
    var n = 0;
    pls.forEach(function (p) {
      if (p && (p.company_id === cid || p.client_id === cid || p.companyId === cid)) n++;
    });
    if (n) {
      if (c.playlists_count == null || c.playlists_count === 0) c.playlists_count = n;
      if (c.playlists === undefined || c.playlists === 0 || c.playlists === null) c.playlists = n;
      if (!Array.isArray(c.playlistList)) c.playlistList = [];
    }
  });
}

// ===== FUNÇÕES DE UNIDADES (ADMINISTRADOR) =====
function verCliente(id) {
  try { zeepBackfillPlaylists(); } catch (e) {}
  var c = db.clients.find(function(x){ return x.id === id; });
  if (!c) return false;
  currentClientId = id;

  /* ★ Preenche rápido com os dados locais (cache) */
  document.getElementById('vc-nome').innerText = c.name;
  document.getElementById('vc-plano').innerText = 'Plano ' + c.plan;
  document.getElementById('vc-status').innerText = exibirStatus(c.status);
  document.getElementById('vc-playlists').innerText = zeepContarPlaylists(c);
  document.getElementById('vc-unidades').innerText = c.unidades;
  document.getElementById('vc-receita').innerText = formatMoney(receitaExibida(c));

  /* ★ Busca dados frescos do BACKEND (a fonte real dos clientes) */
  if (typeof zeepApi === 'function') {
    zeepApi('GET', '/companies')
      .then(function (r) {
        var lista = (r && r.companies) || [];
        var d = null;
        for (var i = 0; i < lista.length; i++) {
          if (String(lista[i].id) === String(id)) { d = lista[i]; break; }
        }
        if (!d) return;
        document.getElementById('vc-nome').innerText = d.name || d.nome || c.name;
        document.getElementById('vc-plano').innerText = 'Plano ' + (d.plan || d.plano || c.plan);
        document.getElementById('vc-status').innerText = exibirStatus(d.status || c.status);
        document.getElementById('vc-receita').innerText = formatMoney(receitaExibida(d) || receitaExibida(c));
      })
      .catch(function () {});
  }

  /* ═══ SEU CÓDIGO ORIGINAL (playlists + pagamentos) — NÃO MEXER ═══ */
  renderUnidadesCliente();
  var pl = document.getElementById('vc-playlists-list');
  if (!pl) return;
  pl.innerHTML = '';
  var cPlaylists = db.playlists.filter(function(p){
  var pc = String(p.clientId || p.company_id || p.cliente_id || '');
  var cc = String(c.id || '');
  return pc === cc;
});
  if (cPlaylists.length === 0) {
    pl.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhuma playlist.</p>';
  } else {
    cPlaylists.forEach(function(p) {
      var nome = p.name || p.titulo || 'Playlist';
      var desc = p.desc || p.description || '';
      var ini = p.timeInicio || p.inicio || '—';
      var fim = p.timeFim || p.fim || '—';
      var faixas = (p.tracks && p.tracks.length) ? p.tracks.length : 0;
      pl.innerHTML += '<div style="display:flex;justify-content:space-between;align-items:center;padding:12px;background:rgba(255,255,255,0.02);border-radius:8px;margin-bottom:8px;"><div><strong style="font-size:13px;">' + nome + '</strong><p style="font-size:10px;color:var(--text3);">' + desc + ' • ' + ini + ' às ' + fim + ' • ' + faixas + ' faixas</p></div><span class="badge badge-prod">' + faixas + ' faixas</span></div>';
    });
  }
  var pg = document.getElementById('vc-pagamentos-list');
  pg.innerHTML = '';
  var cPag = db.pagamentos.filter(function(p){ return p.clientId === c.id; });
  if (cPag.length === 0) {
    pg.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhum pagamento registrado.</p>';
  } else {
    cPag.forEach(function(p) {
      var statusClass = p.status === 'Pago' ? 'badge-plan' : 'badge-amber';
      pg.innerHTML += '<div style="display:flex;justify-content:space-between;align-items:center;padding:12px;background:rgba(255,255,255,0.02);border-radius:8px;margin-bottom:8px;"><div><strong style="font-size:13px;">' + p.valor + '</strong><p style="font-size:10px;color:var(--text3);">Vencimento: ' + p.venc + (p.forma ? ' • ' + p.forma : '') + '</p></div><span class="badge ' + statusClass + '">' + p.status + '</span></div>';
    });
  }
  openModal('modal-ver-cliente');
  /* ★ AVISA que o modal abriu (a abrirDetalheCliente confere isso) */
  return true;
}

function renderUnidadesCliente() {
  var list = document.getElementById('vc-unidades-list');
  list.innerHTML = '';
  var cUnidades = db.unidades.filter(function(u){ return u.clientId === currentClientId; });
  if (cUnidades.length === 0) {
    list.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhuma unidade cadastrada.</p>';
    return;
  }
  cUnidades.forEach(function(u) {
    var statusColor = u.status === 'Online' ? 'var(--green)' : 'var(--red)';
    list.innerHTML += '<div class="unit-row"><div><h5>' + u.name + '</h5><p>' + u.cidade + ' • ID: ' + u.playerId + ' • <span style="color:' + statusColor + ';">' + u.status + '</span></p></div><div class="actions-cell"><button class="btn btn-ghost btn-sm" onclick="editarUnidade(' + u.id + ')">Editar</button><button class="btn btn-danger btn-sm" onclick="abrirRemoverUnidade(' + u.id + ')">Remover</button></div></div>';
  });
}

function abrirNovaUnidade() {
  unidadeEditando = null;
  var c = db.clients.find(function(x){ return x.id === currentClientId; });
  document.getElementById('unidade-modal-titulo').innerText = '+ Nova Unidade';
  document.getElementById('unidade-cliente-nome').innerText = c ? c.name : '';
  document.getElementById('unidade-nome').value = '';
  document.getElementById('unidade-cidade').value = '';
  document.getElementById('unidade-endereco').value = '';
  document.getElementById('unidade-responsavel').value = '';
  document.getElementById('unidade-email').value = '';
  openModal('modal-nova-unidade');
}

function editarUnidade(id) {
  var u = db.unidades.find(function(x){ return x.id === id; });
  if (!u) return;
  unidadeEditando = id;
  var c = db.clients.find(function(x){ return x.id === u.clientId; });
  document.getElementById('unidade-modal-titulo').innerText = 'Editar Unidade';
  document.getElementById('unidade-cliente-nome').innerText = c ? c.name : '';
  document.getElementById('unidade-nome').value = u.name;
  document.getElementById('unidade-cidade').value = u.cidade || '';
  document.getElementById('unidade-endereco').value = u.endereco || '';
  document.getElementById('unidade-responsavel').value = u.responsavel || '';
  document.getElementById('unidade-email').value = u.email || '';
  openModal('modal-nova-unidade');
}

function salvarUnidade() {
  var nome = document.getElementById('unidade-nome').value.trim();
  var cidade = document.getElementById('unidade-cidade').value.trim();
  if (!nome) { alert("Digite o nome da unidade"); return; }
  if (unidadeEditando) {
    var u = db.unidades.find(function(x){ return x.id === unidadeEditando; });
    if (u) {
      u.name = nome;
      u.cidade = cidade;
      u.endereco = document.getElementById('unidade-endereco').value.trim();
      u.responsavel = document.getElementById('unidade-responsavel').value.trim();
      u.email = document.getElementById('unidade-email').value.trim();
    }
    closeModal('modal-nova-unidade');
    renderUnidadesCliente();
    alert("Unidade editada com sucesso!");
  } else {
    var novoId = Date.now();
    var playerId = 'ZEEP-' + String(db.unidades.length + 1).padStart(3, '0');
    db.unidades.push({
      id: novoId,
      clientId: currentClientId,
      name: nome,
      cidade: cidade,
      endereco: document.getElementById('unidade-endereco').value.trim(),
      responsavel: document.getElementById('unidade-responsavel').value.trim(),
      email: document.getElementById('unidade-email').value.trim(),
      status: "Offline",
      playerId: playerId
    });
    var c = db.clients.find(function(x){ return x.id === currentClientId; });
    c.unidades = c.unidades + 1;
    document.getElementById('vc-unidades').innerText = c.unidades;
    closeModal('modal-nova-unidade');
    renderUnidadesCliente();
    alert("Unidade '" + nome + "' adicionada! O contrato e faturamento do cliente serão ajustados.");
  }
}

function abrirRemoverUnidade(id) {
  currentUnidadeId = id;
  var u = db.unidades.find(function(x){ return x.id === id; });
  document.getElementById('remover-unidade-nome').innerText = u ? u.name : '';
  openModal('modal-remover-unidade');
}

function confirmarRemoverUnidade() {
  var u = db.unidades.find(function(x){ return x.id === currentUnidadeId; });
  if (u) {
    db.unidades = db.unidades.filter(function(x){ return x.id !== currentUnidadeId; });
    var c = db.clients.find(function(x){ return x.id === u.clientId; });
    c.unidades = Math.max(0, c.unidades - 1);
    document.getElementById('vc-unidades').innerText = c.unidades;
    closeModal('modal-remover-unidade');
    renderUnidadesCliente();
    alert("Unidade '" + u.name + "' removida! O contrato e faturamento do cliente serão ajustados.");
  }
}

function gerarRelatorio() {
  var clientId = document.getElementById('rel-cliente').value;
  var res = document.getElementById('rel-resultado');
  var html = '';
  if (clientId !== 'todos') {
    var c = db.clients.find(function(x){ return x.id === parseInt(clientId); });
    if (c) {
      var cPlaylists = db.playlists.filter(function(p){ return p.clientId === c.id; });
      var cHist = db.histSAC.filter(function(o){ return o.clientId === c.id; });
      var added = 0;
      cPlaylists.forEach(function(p){ added += p.tracks.length; });
      html += '<div class="grid-3" style="margin-bottom:20px;">';
      html += '<div class="card-metric c2"><p>Músicas</p><h3>' + added + '</h3></div>';
      html += '<div class="card-metric c4"><p>Histórico SAC</p><h3>' + cHist.length + '</h3></div>';
      html += '<div class="card-metric c1"><p>Receita Total</p><h3>' + formatMoney(receitaExibida(c)) + '</h3></div>';
      html += '</div>';
      html += '<div class="table-container"><table><thead><tr><th>Playlist</th><th>Faixas</th><th>Última Atualização</th></tr></thead><tbody>';
      cPlaylists.forEach(function(p) {
        html += '<tr><td><strong>' + p.name + '</strong></td><td>' + p.tracks.length + '</td><td>' + p.updated + '</td></tr>';
      });
      html += '</tbody></table></div>';
    }
  } else {
    var totalTracks = 0;
    db.playlists.forEach(function(p){ totalTracks += p.tracks.length; });
    var totalHist = db.histSAC.length;
    html += '<div class="grid-3" style="margin-bottom:20px;">';
    html += '<div class="card-metric c2"><p>Músicas</p><h3>' + totalTracks + '</h3></div>';
    html += '<div class="card-metric c5"><p>Histórico SAC</p><h3>' + totalHist + '</h3></div>';
    html += '<div class="card-metric c4"><p>Chats Ativos</p><h3>' + db.chats.filter(function(c){ return c.status === 'aberto'; }).length + '</h3></div>';
    html += '</div>';
    html += '<div class="table-container"><table><thead><tr><th>Cliente</th><th>Receita Total</th><th>Histórico SAC</th></tr></thead><tbody>';
    db.clients.forEach(function(c) {
      var hist = db.histSAC.filter(function(o){ return o.clientId === c.id; }).length;
      html += '<tr><td><strong>' + (c.nome || c.name) + '</strong></td><td>' + formatMoney(receitaExibida(c)) + '</td><td>' + hist + '</td></tr>';
    });
    html += '</tbody></table></div>';
    html += '<div class="section-title" style="margin-top:20px;">Últimas Músicas Adicionadas</div>';
    html += '<div class="table-container"><table><thead><tr><th>Playlist</th><th>Cliente</th><th>Última Atualização</th></tr></thead><tbody>';
    db.playlists.slice().sort(function(a,b){ return b.updated.localeCompare(a.updated); }).slice(0,5).forEach(function(p) {
      var c = db.clients.find(function(x){ return x.id === p.clientId; });
      html += '<tr><td><strong>' + p.name + '</strong></td><td>' + (c ? c.name : '-') + '</td><td>' + p.updated + '</td></tr>';
    });
    html += '</tbody></table></div>';
  }
  res.innerHTML = html;
}
  
/* ═══════════ VISÃO GERAL — CARDS REAIS (DEFINITIVO) ═══════════ */
function normLabel(s) {
  return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
}

function setCardMetric(label, valor) {
  var alvo = normLabel(label);
  var cards = document.querySelectorAll('.card-metric');
  var achou = 0;
  for (var i = 0; i < cards.length; i++) {
    var p = cards[i].querySelector('p');
    if (!p) continue;
    if (normLabel(p.textContent) === alvo) {
      var h3 = cards[i].querySelector('h3');
      if (h3) { h3.textContent = valor; achou++; }
    }
  }
  console.log('[ZEEP-API] setCardMetric("' + label + '") -> ' + achou + ' card(s) atualizado(s) para "' + valor + '"');
}

async function zeepCarregarVisaoGeral() {
  try {
    const data = await zeepApi('GET', '/overview');
    const o = data.overview || {};
    const fmtBRL = function (v) {
      return 'R$ ' + Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };
    setCardMetric('Clientes Ativos', o.clientes_ativos);
    setCardMetric('Playlists', o.playlists);
    setCardMetric('Músicas no R2', o.musicas_r2);
    setCardMetric('Faturamento', fmtBRL(o.faturamento ? o.faturamento.total : 0));
    setCardMetric('SAC', o.sac ? o.sac.total : 0);
    console.log('[ZEEP-API] Visão geral carregada:', o);
  } catch (e) {
    console.warn('[ZEEP-API] Falha ao carregar visão geral:', e.message);
  }
}

async function zeepCarregarAtividades() {
  try {
    var rCli = await zeepApi('GET', '/companies');
    var rPl = await zeepApi('GET', '/playlists');
    var itens = [];
    (rCli.companies || []).forEach(function (c) {
      if (c.created_at) itens.push({ data: c.created_at, html: '<strong>' + escapeHtml(c.name || '—') + '</strong> foi cadastrado como cliente' });
    });
    (rPl.playlists || []).forEach(function (p) {
      if (p.updated_at) itens.push({ data: p.updated_at, html: 'Playlist <strong>' + escapeHtml(p.name || '—') + '</strong> foi atualizada' });
    });
    itens.sort(function (a, b) { return String(b.data).localeCompare(String(a.data)); });
    itens = itens.slice(0, 8);
    if (!itens.length) return;

    function fmtData(d) {
      var x = new Date(d);
      return x.toLocaleDateString('pt-BR') + ' - ' + x.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    }

    // 1) Preenche a TABELA de atividades que hoje exibe o mock (Jangada/Renner)
    var tables = document.querySelectorAll('table');
    var table = null;
    for (var i = 0; i < tables.length; i++) {
      if (/Jangada|Renner|31\/07\/2026/.test(tables[i].innerHTML)) { table = tables[i]; break; }
    }
    if (table) {
      var tbody = table.querySelector('tbody');
      if (tbody) {
        tbody.innerHTML = '';
        itens.forEach(function (it) {
          tbody.innerHTML += '<tr><td>' + fmtData(it.data) + '</td><td>' + it.html + '</td><td>Italo Vieira</td><td><span class="badge badge-prod">Sucesso</span></td></tr>';
        });
      }
    }

    // 2) Também preenche o #history-list (div) se existir
    var hList = document.getElementById('history-list');
    if (hList) {
      hList.innerHTML = '';
      itens.forEach(function (it) {
        hList.innerHTML += '<div class="timeline-item"><span style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px;">' + fmtData(it.data) + '</span>' + it.html + '</div>';
      });
    }
  } catch (e) {
    console.warn('[ZEEP-API] Falha ao carregar atividades:', e.message);
  }
}
function init() {
  zeepAtualizarInterface();
  openChat(0);
  if (!localStorage.getItem('zeep_dash_token')) return;
  if (typeof zeepCarregarAtividades === 'function') zeepCarregarAtividades();
  if (typeof zeepCarregarClientes === 'function') zeepCarregarClientes();
  if (typeof zeepCarregarVisaoGeral === 'function') zeepCarregarVisaoGeral();
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function () {
    init();
    if (localStorage.getItem('zeep_dash_token')) {
      zeepCarregarVisaoGeral();
    }
  });
} else {
  init();
  if (localStorage.getItem('zeep_dash_token')) {
    zeepCarregarVisaoGeral();
  }
}
</script>
<!-- ====== BARRA DO PLAYER DE PREVIEW (ZEEP) ====== -->
<div id="player-bar" style="display:none; position:fixed; bottom:0; left:240px; right:0; background:var(--navy2); border-top:1px solid var(--border); padding:12px 24px; align-items:center; gap:16px; z-index:50;">
<div style="flex:1; min-width:0;">
<p style="font-size:10px; color:var(--text3); text-transform:uppercase; letter-spacing:1px;">Tocando preview</p>
<p id="player-track" style="font-size:12px; font-weight:600; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">—</p>
</div>
<button class="btn btn-sm btn-primary" onclick="togglePreviewPlay()" id="player-btn">⏸ Pausar</button>
</div>
<script>
/* ========== BIBLIOTECA DE MÚSICA — INTEGRAÇÃO COM O BACKEND (ZEEP) ========== */
var API_BASE = window.location.origin;

window.supabase = supabase.createClient( 
  'https://ewxnxajifnakkeijlhwn.supabase.co', 
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV3eG54YWppZm5ha2tlaWpsaHduIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5ODc2NzcsImV4cCI6MjEwMjU2MzY3N30.hQs15lw5_OiTkFEKV0NuQq56ANHaWb-2o9jFxKlB-5w'
);

var bibliotecaTracks = [];
var currentTrackKey = null;
var audioPreview = new Audio();
function escapeHtml(str) {
return String(str == null ? '' : str).replace(/[&<>"']/g, function(c) {
return { '&': '&amp;', '<': '<', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
});
}
function formatDuration(sec) {
if (!sec || sec <= 0) return '--:--';
var m = Math.floor(sec / 60);
var s = Math.round(sec % 60);
return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
}
function loadBiblioteca() {
  var tbody = document.getElementById('biblioteca-tbody');
  var count = document.getElementById('biblioteca-count');
  if (!tbody) return;
  tbody.innerHTML = '<tr><td colspan="7" style="color:var(--text3);">Carregando biblioteca…</td></tr>';
  fetch(API_BASE + '/api/r2/music')
    .then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status + ' ' + res.statusText);
      return res.json();
    })
    .then(function(data) {
      bibliotecaTracks = (data && data.tracks) || [];
      if (count) count.textContent = bibliotecaTracks.length + ' músicas';
      renderBiblioteca();
      try { bindPlaylistTracksToReal(); } catch (e) { console.error('bind falhou:', e); }
      try { renderPlaylistAccordion(); } catch (e) { console.error('accordion falhou:', e); }
      var metric = document.querySelector('.card-metric.c3 h3');
      if (metric) metric.textContent = bibliotecaTracks.length;
      var r2Count = document.querySelectorAll('.upload-area h3');
      if (r2Count[0]) r2Count[0].textContent = bibliotecaTracks.length;
    })
    .catch(function(err) {
      console.error('Erro ao carregar biblioteca:', err);
      tbody.innerHTML = '<tr><td colspan="7" style="color:var(--red);">Erro: ' + escapeHtml(err.message) + '. Verifique se o backend está rodando em ' + API_BASE + ' e abra o F12 → Console.</td></tr>';
      if (count) count.textContent = 'erro';
    });
}
function searchBiblioteca() {
renderBiblioteca();
}
function playTrack(index) {
  var track = bibliotecaTracks[index];
  if (!track || !track.previewUrl) return;

  // Se a mesma música já está tocando, pausa
  if (currentTrackKey === track.key && !audioPreview.paused) {
    audioPreview.pause();
    return;
  }

  currentTrackKey = track.key;
  audioPreview.src = track.previewUrl;

  // CORTE EXATO AOS 15 SEGUNDOS — garante que o preview pare sempre
  audioPreview.ontimeupdate = function() {
    if (audioPreview.currentTime >= 15) {
      audioPreview.pause();
      document.getElementById('player-btn').textContent = '▶ Play';
      renderBiblioteca();
    }
  };

  audioPreview.onended = function() {
    document.getElementById('player-btn').textContent = '▶ Play';
    renderBiblioteca();
  };

  audioPreview.play().catch(function() {});

  document.getElementById('player-track').textContent =
    escapeHtml(track.title || track.name) + ' — ' + escapeHtml(track.artist || '');
  document.getElementById('player-btn').textContent = '⏸ Pausar';
  document.getElementById('player-bar').style.display = 'flex';
  renderBiblioteca();
}
function togglePreviewPlay() {
if (audioPreview.paused) audioPreview.play().catch(function() {});
else audioPreview.pause();
document.getElementById('player-btn').textContent = audioPreview.paused ? '▶ Play' : '⏸ Pausar';
}
loadBiblioteca();
function bindPlaylistTracksToReal() {
db.playlists.forEach(function(p) {
var keys = [];
(p.tracks || []).forEach(function(tid) {
if (typeof tid === 'string') { keys.push(tid); return; }
var mock = db.tracks.find(function(x){ return x.id === tid; });
if (!mock) return;
var real = findRealTrackByTitle(mock.t);
if (real) keys.push(real.key);
});
p.tracks = keys;
});
}
function findRealTrackByTitle(title) {
var t = String(title || '').toLowerCase().trim();
if (!t) return null;
var exact = bibliotecaTracks.filter(function(b){ return (b.title || b.name || '').toLowerCase().trim() === t; });
if (exact.length === 1) return exact[0];
var starts = bibliotecaTracks.filter(function(b){ return (b.title || b.name || '').toLowerCase().trim().indexOf(t) === 0; });
if (starts.length === 1) return starts[0];
var contains = bibliotecaTracks.filter(function(b){ return (b.title || b.name || '').toLowerCase().trim().indexOf(t) > -1; });
if (contains.length === 1) return contains[0];
return null;
}
function playTrackByKey(key) {
for (var i = 0; i < bibliotecaTracks.length; i++) {
if (bibliotecaTracks[i].key === key) { playTrack(i); return; }
}
}
</script>
<script>
/* ============================================================
   ZEEP DASHBOARD — NÚCLEO DE FUNÇÕES (restauração)
   ============================================================ */
var API_BASE = window.location.origin;
var bibliotecaTracks = [];
var previewAudio = null;

function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}
function escapeHtml(s) { return esc(s); }

/* ---------- NAVEGAÇÃO ---------- */
function nav(id, el) {
  var mods = document.querySelectorAll('.module');
  for (var i = 0; i < mods.length; i++) mods[i].classList.remove('active');
  var target = document.getElementById(id);
  if (target) target.classList.add('active');
  var items = document.querySelectorAll('.nav-item');
  for (var j = 0; j < items.length; j++) items[j].classList.remove('active');
  if (el) { el.classList.add('active'); var t = document.getElementById('page-title'); if (t) t.textContent = el.textContent.trim(); }
}

function openModal(id) { var m = document.getElementById(id); if (m) m.style.display = 'flex'; }
function closeModal(id) { var m = document.getElementById(id); if (m) m.style.display = 'none'; }

/* ---------- BIBLIOTECA (R2) ---------- */
function loadBiblioteca() {
  var tbody = document.getElementById('biblioteca-tbody');
  var count = document.getElementById('biblioteca-count');
  if (!tbody) return;
  tbody.innerHTML = '<tr><td colspan="7" style="color:var(--text3);">Carregando biblioteca…</td></tr>';
  fetch(API_BASE + '/api/r2/music')
    .then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status + ' ' + res.statusText);
      return res.json();
    })
    .then(function(data) {
      bibliotecaTracks = (data && data.tracks) || [];
      if (count) count.textContent = bibliotecaTracks.length + ' músicas';
      try { renderBiblioteca(); } catch (e) { console.error('renderBiblioteca:', e); }
      try { bindPlaylistTracksToReal(); } catch (e) { console.error('bind:', e); }
      var metric = document.querySelector('.card-metric.c3 h3');
      if (metric) metric.textContent = bibliotecaTracks.length;
      var r2Count = document.querySelectorAll('.upload-area h3');
      if (r2Count[0]) r2Count[0].textContent = bibliotecaTracks.length;
    })
    .catch(function(err) {
      console.error('Erro ao carregar biblioteca:', err);
      tbody.innerHTML = '<tr><td colspan="7" style="color:var(--red);">Erro: ' + esc(err.message) + ' — verifique se o backend está rodando em ' + API_BASE + '</td></tr>';
      if (count) count.textContent = 'erro';
    });
}

function fmtDur(sec) {
  sec = Number(sec);
  if (!sec || sec <= 0) return '--:--';
  var m = Math.floor(sec / 60);
  var s = Math.floor(sec % 60);
  return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

function renderBiblioteca() {
  var body = document.getElementById('biblioteca-tbody');
  if (!body) return;
  var searchEl = document.getElementById('biblioteca-search');
  var q = (searchEl ? searchEl.value : '').toLowerCase();
  var list = bibliotecaTracks.filter(function(t) {
    if (!q) return true;
    return ((t.title || t.name || '') + ' ' + (t.artist || '') + ' ' + (t.album || '')).toLowerCase().indexOf(q) > -1;
  });
  if (!list.length) {
    body.innerHTML = '<tr><td colspan="7" style="color:var(--text3);">Nenhuma música encontrada.</td></tr>';
    return;
  }
  var html = '';
  for (var i = 0; i < list.length; i++) {
    var t = list[i];
    html += '<tr>' +
      '<td>' + (i + 1) + '</td>' +
      '<td><strong>' + esc(t.title || t.name) + '</strong></td>' +
      '<td>' + esc(t.artist || '—') + '</td>' +
      '<td>' + esc(t.album || '—') + '</td>' +
      '<td class="genre-cell" id="genre-' + esc(t.key) + '">' + esc(t.genre || '—') + ' <button class="btn-edit-genre" data-key="' + esc(t.key) + '" onclick="event.stopPropagation(); editGenre(this)" title="Editar gênero">✏️</button></td>' +
      '<td>' + fmtDur(t.duration) + '</td>' +
      '<td><div class="actions-cell"><button class="play-btn pl-play" data-key="' + esc(t.key) + '" title="Pré-escuta">▶</button></div></td>' +
      '</tr>';
  }
  body.innerHTML = html;
}

function searchBiblioteca() { renderBiblioteca(); }
function playTrack(idx) { if (bibliotecaTracks && bibliotecaTracks[idx]) playTrackByKey(bibliotecaTracks[idx].key); }

/* ---------- PRÉ-ESCUTA (15s) ---------- */
function playTrackByKey(key) {
  var track = null;
  for (var i = 0; i < bibliotecaTracks.length; i++) {
    if (bibliotecaTracks[i].key === key) { track = bibliotecaTracks[i]; break; }
  }
  if (!track) return;
  var url = track.previewUrl || (API_BASE + '/api/r2/preview/' + encodeURIComponent(track.key));
  if (!previewAudio) previewAudio = new Audio();
  if (previewAudio._timer) clearTimeout(previewAudio._timer);
  previewAudio.src = url;
  previewAudio.play().catch(function() {});
  previewAudio._timer = setTimeout(function() {
    try { previewAudio.pause(); previewAudio.currentTime = 0; } catch (e) {}
    var b = document.getElementById('player-btn');
    if (b) b.textContent = '▶';
  }, 15000);
  updatePlayerLabel(track);
  var btn = document.getElementById('player-btn');
  if (btn) btn.textContent = '⏸';
}

function updatePlayerLabel(track) {
  var name = (track.title || track.name || '') + ' — ' + (track.artist || '');
  var ids = ['player-title','player-track','now-playing','player-music','player-name'];
  for (var i = 0; i < ids.length; i++) {
    var el = document.getElementById(ids[i]);
    if (el) { el.textContent = name; break; }
  }
  var labels = document.querySelectorAll('.playing-label');
  for (var j = 0; j < labels.length; j++) labels[j].textContent = name;
}

function togglePreviewPlay() {
  if (!previewAudio) return;
  if (previewAudio.paused) {
    previewAudio.play().catch(function() {});
    var b = document.getElementById('player-btn'); if (b) b.textContent = '⏸';
  } else {
    previewAudio.pause();
    var b2 = document.getElementById('player-btn'); if (b2) b2.textContent = '▶';
  }
}

/* ---------- EDIÇÃO DE GÊNERO ---------- */
var generosSugeridos = ['Pop','Rock','Jazz','Lounge','Bossa Nova','Eletrônica','Acústico','R&B','Soul','Clássica','Ambiente','Outro'];

function editGenre(btn) {
  var key = btn.getAttribute('data-key');
  var track = null;
  for (var i = 0; i < bibliotecaTracks.length; i++) { if (bibliotecaTracks[i].key === key) { track = bibliotecaTracks[i]; break; } }
  if (!track) return;
  var cell = document.getElementById('genre-' + key);
  if (!cell) return;
  var atual = track.genre || '';
  var opts = generosSugeridos.map(function(g) {
    return '<option value="' + esc(g) + '"' + (g === atual ? ' selected' : '') + '>' + esc(g) + '</option>';
  }).join('');
  if (atual && generosSugeridos.indexOf(atual) === -1) {
    opts = '<option value="' + esc(atual) + '" selected>' + esc(atual) + '</option>' + opts;
  }
  opts += '<option value="__outro__">Outro (digitar)…</option>';
  cell.innerHTML = '<select id="genre-select-' + key + '" onclick="event.stopPropagation();">' + opts + '</select> ' +
    '<button class="btn-edit-genre" data-key="' + key + '" onclick="event.stopPropagation(); saveGenre(this)">Salvar</button> ' +
    '<button class="btn-edit-genre" onclick="event.stopPropagation(); renderBiblioteca()">Cancelar</button>';
}

function saveGenre(btn) {
  var key = btn.getAttribute('data-key');
  var sel = document.getElementById('genre-select-' + key);
  if (!sel) return;
  var genre = sel.value;
  var track = null;
  for (var i = 0; i < bibliotecaTracks.length; i++) { if (bibliotecaTracks[i].key === key) { track = bibliotecaTracks[i]; break; } }
  if (!track) return;
  if (genre === '__outro__') {
    var novo = prompt('Digite o novo gênero:');
    if (!novo || !novo.trim()) { renderBiblioteca(); return; }
    genre = novo.trim();
  }
  var cell = document.getElementById('genre-' + key);
  if (cell) cell.innerHTML = 'Salvando…';
  fetch(API_BASE + '/api/r2/music/genero', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ key: key, genre: genre })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    if (data && data.success) {
      track.genre = genre;
      renderBiblioteca();
      alert('Gênero atualizado com sucesso!');
    } else {
      throw new Error((data && data.error) || 'Falha ao salvar');
    }
  })
  .catch(function(err) {
    console.error('Erro ao salvar gênero:', err);
    renderBiblioteca();
    alert('Erro ao salvar gênero: ' + err.message);
  });
}

/* ---------- PLAYLISTS (vínculo com R2) ---------- */
function getPlaylists() {
  try {
    if (typeof db === 'undefined' || !db) return [];
    if (Array.isArray(db.playlists)) return db.playlists;
    if (Array.isArray(db.units)) {
      var out = [];
      for (var i = 0; i < db.units.length; i++) {
        var u = db.units[i];
        var pls = u && (u.playlists || u.musicas || []);
        if (Array.isArray(pls)) {
          for (var j = 0; j < pls.length; j++) {
            var p = (typeof pls[j] === 'string') ? { titulo: pls[j] } : pls[j];
            if (p) out.push(p);
          }
        }
      }
      return out;
    }
  } catch (e) {}
  return [];
}

function findRealTrackByTitle(title) {
  if (!title) return null;
  var t = String(title).toLowerCase().trim();
  // ★ Só aceita músicas que JÁ têm UUID real da tabela tracks (36 caracteres)
  function temUuid(b) {
    return b && b.id && String(b.id).length === 36;
  }
  for (var i = 0; i < bibliotecaTracks.length; i++) {
    var b = bibliotecaTracks[i];
    if (!temUuid(b)) continue;
    if (String(b.title || b.name || '').toLowerCase() === t) return b;
  }
  for (var j = 0; j < bibliotecaTracks.length; j++) {
    var b2 = bibliotecaTracks[j];
    if (!temUuid(b2)) continue;
    var n2 = String(b2.title || b2.name || '').toLowerCase();
    if (n2.indexOf(t) > -1 || t.indexOf(n2) > -1) return b2;
  }
  return null;
}

function renderPlaylistAccordion() {
  var acc = document.getElementById('playlist-accordion');
  if (!acc) return;
  var pls = getPlaylists();
  if (!pls.length) {
    acc.innerHTML = '<p style="color:var(--text3);font-size:13px;">Nenhuma playlist cadastrada.</p>';
    return;
  }
  var html = '';
  for (var i = 0; i < pls.length; i++) {
    var p = pls[i];
    var titulo = p.titulo || p.nome || p.name || p.title || ('Playlist ' + (i + 1));
    var inicio = p.inicio || p.start || '';
    var fim = p.fim || p.end || '';
    var desc = p.descricao || p.description || p.desc || '';
    var tracks = p.tracks || p.musicas || p.songs || [];
    html += '<div class="playlist-box"><div class="playlist-head">' +
      '<div><h4 style="color:var(--text);font-size:15px;margin-bottom:4px;">' + esc(titulo) + '</h4>' +
      (desc ? '<p style="color:var(--text2);font-size:12px;">' + esc(desc) + '</p>' : '') + '</div>' +
      (inicio || fim ? '<div style="text-align:right;font-size:11px;color:var(--text3);">INÍCIO <strong>' + esc(inicio) + '</strong> · FIM <strong>' + esc(fim) + '</strong></div>' : '') +
      '</div>' +
      '<div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-bottom:10px;flex-wrap:wrap;">' +
      '<button class="btn btn-ghost btn-sm zeep-add-musica" data-zeep-tipo="curadoria" data-zeep-key="' + esc(p.id || '') + '" data-zeep-nome="' + esc(titulo) + '" onclick="zeepAbrirModalComBotao(this)">+ Adicionar músicas</button>' +
      '<button class="btn btn-ghost btn-sm" data-key="' + esc(p.id || '') + '" data-nome="' + esc(titulo) + '" onclick="zeepCopiarDesta(this)">📋 Copiar</button>' +
      '<button class="btn btn-danger btn-sm" onclick="zkRemoverSelecionadas(' + jsStr(p.id) + ')">🗑 Remover selecionadas</button>' +
      '</div>' +
      '<table><thead><tr><th><input type="checkbox" class="zk-todas" onclick="zkMarcarTodas(this)" title="Marcar todas"></th><th>#</th><th>Título</th><th>Artista</th><th>Álbum</th><th>Gênero</th><th>Ações</th></tr></thead><tbody>';
    if (!tracks.length) {
      html += '<tr><td colspan="7" style="color:var(--text3);">Nenhuma música nesta playlist.</td></tr>';
    } else {
      for (var j = 0; j < tracks.length; j++) {
        var item = tracks[j];
        var nome = (typeof item === 'string') ? item : (item.title || item.nome || '');
        var real = findRealTrackByTitle(nome);
        var realKey = real ? (real.id || real.key) : '';
          html += '<tr>' +
          '<td><input type="checkbox" class="zk-linha" data-key="' + esc(nome) + '"></td>' +
          '<td>' + (j + 1) + '</td>' +
          '<td><strong>' + esc(nome) + '</strong></td>' +
          '<td>' + esc((real ? real.artist : (typeof item === 'object' ? (item.artist || '') : '')) || '—') + '</td>' +
          '<td>' + esc((real ? real.album : '') || '—') + '</td>' +
          '<td>' + esc((real ? real.genre : '') || '—') + '</td>' +
          '<td><div class="actions-cell">' +
          (real ? '<button class="play-btn pl-play" data-key="' + esc(real.key) + '" title="Pré-escuta">▶</button>' : '') +
          '<button class="add-btn" onclick="event.stopPropagation(); removeFromPlaylist(' + jsStr(p.id) + ', ' + jsStr(nome) + ')">−</button>' +
          '</div></td></tr>';
      }
    }
    html += '</tbody></table></div>';
  }
  acc.innerHTML = html;
}

function bindPlaylistTracksToReal() {
  try { renderPlaylistAccordion(); } catch (e) { console.error('bind:', e); }
}

function zkMarcarTodas(chk) {
  var box = chk.closest ? chk.closest('.playlist-box') : null;
  if (!box) return;
  var boxes = box.querySelectorAll ? box.querySelectorAll('.zk-linha') : [];
  for (var i = 0; i < boxes.length; i++) boxes[i].checked = chk.checked;
}
function zkRemoverSelecionadas(playlistId) {
  var chks = document.querySelectorAll('.zk-linha:checked');
  if (!chks.length) { alert('Selecione pelo menos uma música.'); return; }
  if (!confirm('Remover ' + chks.length + ' música(s) selecionada(s)?')) return;
  var keys = [];
  for (var i = 0; i < chks.length; i++) {
    var k = chks[i].getAttribute('data-key');
    if (k) keys.push(k);
  }
  if (!keys.length) { alert('Nenhuma música válida marcada.'); return; }
  var fila = keys.slice();
  function proximo() {
    if (!fila.length) { renderPlaylistAccordion(); return; }
    var k = fila.shift();
    var p = removeFromPlaylist(playlistId, k);
    if (p && typeof p.then === 'function') p.then(proximo).catch(proximo); else proximo();
  }
  proximo();
}

function filterClients() {
  var input = document.getElementById('search-playlist-client');
  var q = (input ? input.value : '').toLowerCase();
  var boxes = document.querySelectorAll('#playlist-accordion .playlist-box');
  for (var i = 0; i < boxes.length; i++) {
    var box = boxes[i];
    box.style.display = (!q || (box.textContent || '').toLowerCase().indexOf(q) > -1) ? '' : 'none';
  }
}

/* ---------- LISTENER GLOBAL DE PRÉ-ESCUTA ---------- */
document.addEventListener('click', function(e) {
  var t = e.target;
  while (t && t !== document) {
    if (t.classList && t.classList.contains('pl-play') && t.getAttribute('data-key')) {
      e.stopPropagation();
      playTrackByKey(t.getAttribute('data-key'));
      return;
    }
    t = t.parentNode;
  }
});

/* ---------- TABELAS DE APOIO (clientes/pagamentos) ---------- */
function renderClientTable() {
  var body = document.getElementById('client-table-body');
  if (!body) return;
  var list = [];
  try { if (typeof db !== 'undefined' && db) list = db.clients || db.clientes || []; } catch (e) {}
  if (!list.length) { body.innerHTML = '<tr><td colspan="6" style="color:var(--text3);">Nenhum cliente cadastrado.</td></tr>'; return; }
  var html = '';
  for (var i = 0; i < list.length; i++) {
    var c = list[i];
    html += '<tr><td><strong>' + esc(c.nome || c.name || c.cliente || '—') + '</strong></td>' +
      '<td>' + esc(c.plano || 'Business') + '</td>' +
      '<td><span style="color:var(--green);">' + esc(c.status || 'Ativo') + '</span></td>' +
      '<td>' + zeepContarPlaylists(c) + '</td>' +
      '<td>' + (c.unidades || 1) + '</td>' +
      '<td><button class="btn btn-ghost btn-sm">Ver</button></td></tr>';
  }
  body.innerHTML = html;
}

function renderPagamentos() {
  var body = document.getElementById('pagamentos-body');
  if (!body) return;
  body.innerHTML = '<tr><td colspan="5" style="color:var(--text3);">Dados financeiros serão carregados na integração com o backend.</td></tr>';
}

/* ---------- INICIALIZAÇÃO ---------- */
document.addEventListener('DOMContentLoaded', function() {
  try { loadBiblioteca(); } catch (e) { console.error(e); }
  try { renderClientTable(); } catch (e) {}
  try { renderPagamentos(); } catch (e) {}
  try { renderPlaylistAccordion(); } catch (e) {}
});
</script>

<script>
/* ============ ZEEP — PLANOS, CÁLCULO AUTOMÁTICO E CRIAÇÃO ============ */

/* Edite aqui os valores se mudarem — tudo calcula sozinho a partir deles */
var PLANOS = {
  Standard:   { label: 'Standard',   base: 279,  porFilial: 99.90 },
  Business:   { label: 'Business',   base: 599,  porFilial: 99.90 },
  Enterprise: { label: 'Enterprise', base: 799,  porFilial: 99.90 }
};

function calcularValorCliente() {
  var plano = document.getElementById('nc-plano').value;
  var unidades = parseInt(document.getElementById('nc-unidades').value || '1', 10) || 1;
  var p = PLANOS[plano] || PLANOS.Business;
  var filiaisExtras = Math.max(0, unidades - 1); // 1ª unidade = Matriz (inclusa), demais = filiais
  var total = p.base + (filiaisExtras * p.porFilial);
  var el = document.getElementById('nc-valor');
  if (el) el.value = total.toFixed(2).replace('.', ',');
  var det = document.getElementById('nc-valor-detalhe');
  if (det) det.textContent = p.label + ' R$ ' + p.base + ' (matriz) + ' + filiaisExtras + ' filial(is) × R$ ' + p.porFilial + ' = R$ ' + total.toFixed(2).replace('.', ',');
  return total;
}

function getClientes() {
  var list = [];
  try {
    if (typeof db === 'undefined' || !db) return list;
    if (Array.isArray(db.clientes)) return db.clientes;
    if (Array.isArray(db.units)) {
      for (var i = 0; i < db.units.length; i++) {
        var u = db.units[i];
        list.push({ nome: u.cliente || u.nome || ('Unidade ' + (i+1)), segmento: u.segmento || '', plano: u.plano || 'Business', status: u.status || 'Ativo', playlists: (u.playlists || []).length, unidades: u.filiais || 1 });
      }
    }
  } catch (e) {}
  return list;
}

/* ── EDITAR CLIENTE (PUT /companies/:id) ── */
function abrirEditarCliente(id) {
  var c = getClientes().find(function (x) { return String(x.id) === String(id); });
  if (!c) { alert('Cliente não encontrado.'); return; }
  var modal = document.getElementById('modal-editar-cliente');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'modal-editar-cliente';
    modal.className = 'modal';
    modal.innerHTML =
      '<div class="modal-content modal-sm">' +
        '<h3>Editar Cliente</h3>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">' +
          '<div><label>Nome da Empresa</label><input id="ec-nome"></div>' +
          '<div><label>E-mail</label><input id="ec-email" type="email"></div>' +
          '<div><label>CNPJ / Documento</label><input id="ec-document"></div>' +
          '<div><label>Telefone</label><input id="ec-phone"></div>' +
          '<div><label>Plano</label><select id="ec-plano">' +
            '<option>Standard</option><option>Business</option><option>Enterprise</option>' +
          '</select></div>' +
          '<div><label>Status</label><select id="ec-status">' +
            '<option>Ativo</option><option>Inativo</option>' +
          '</select></div>' +
          '<div><label>Forma de Pagamento</label><select id="ec-pagamento">' +
            '<option>Dinheiro</option><option>Cartão</option><option>Pix</option><option>Boleto</option>' +
          '</select></div>' +
          '<div><label>Valor Mensal (R$)</label><input id="ec-valor" type="number" step="0.01"></div>' +
          '<div style="grid-column:1/3;"><label>Endereço</label><input id="ec-address"></div>' +
          '<div style="grid-column:1/3;"><label>Segmento</label><input id="ec-segmento"></div>' +
        '</div>' +
        '<div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">' +
          '<button class="btn btn-ghost" onclick="closeModal(\'modal-editar-cliente\')">Cancelar</button>' +
          '<button class="btn btn-primary" onclick="salvarEdicaoCliente()">Salvar</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(modal);
  }
  document.getElementById('ec-nome').value = c.nome || c.name || '';
  document.getElementById('ec-email').value = c.email || '';
  document.getElementById('ec-document').value = c.document || c.cnpj || '';
  document.getElementById('ec-phone').value = c.phone || c.telefone || '';
  document.getElementById('ec-plano').value = c.plano || c.plan || 'Business';
  document.getElementById('ec-status').value = (c.status === 'INACTIVE' || c.status === 'Inativo') ? 'Inativo' : 'Ativo';
  document.getElementById('ec-pagamento').value = c.pagamento || c.forma_pagamento || 'Dinheiro';
  document.getElementById('ec-valor').value = c.valor || c.valor_mensal || '';
  document.getElementById('ec-address').value = c.address || c.endereco || '';
  document.getElementById('ec-segmento').value = c.segmento || '';
  _zeepEditandoClienteId = id;
  if (typeof openModal === 'function') openModal('modal-editar-cliente');
  else modal.style.display = 'flex';
}
var _zeepEditandoClienteId = null;

function salvarEdicaoCliente() {
  var id = _zeepEditandoClienteId;
  if (!id) return;
  var body = {
    name: document.getElementById('ec-nome').value.trim(),
    email: document.getElementById('ec-email').value.trim() || null,
    document: document.getElementById('ec-document').value.trim() || null,
    phone: document.getElementById('ec-phone').value.trim() || null,
    plan: document.getElementById('ec-plano').value,
    status: document.getElementById('ec-status').value === 'Inativo' ? 'INACTIVE' : 'ACTIVE',
    forma_pagamento: document.getElementById('ec-pagamento').value,
    valor_mensal: document.getElementById('ec-valor').value ? Number(document.getElementById('ec-valor').value) : null,
    address: document.getElementById('ec-address').value.trim() || null,
    segmento: document.getElementById('ec-segmento').value.trim() || null
  };
  if (!body.name) { alert('Informe o nome da empresa.'); return; }
  zeepApi('PUT', '/companies/' + id, body)
    .then(function () {
      alert('Cliente atualizado com sucesso!');
      if (typeof closeModal === 'function') closeModal('modal-editar-cliente');
      return zeepCarregarClientes();
    })
    .then(function () {
      if (typeof renderClientTable === 'function') renderClientTable();
    })
    .catch(function (e) { alert('Erro ao editar cliente: ' + e.message); });
}

/* ── EXCLUIR CLIENTE (DELETE /companies/:id) ── */
function excluirCliente(id) {
  if (!confirm('Tem certeza que deseja excluir este cliente?')) return;
  zeepApi('DELETE', '/companies/' + id)
    .then(function () {
      alert('Cliente excluído com sucesso!');
      return zeepCarregarClientes();
    })
    .then(function () {
      if (typeof renderClientTable === 'function') renderClientTable();
    })
    .catch(function (e) { alert('Erro ao excluir cliente: ' + e.message); });
}

function renderClientTable() {
  var body = document.getElementById('client-table-body');
  if (!body) return;
  var list = getClientes();
  if (!list.length) { body.innerHTML = '<tr><td colspan="7" style="color:var(--text3);">Nenhum cliente cadastrado.</td></tr>'; return; }
  var html = '';
  for (var i = 0; i < list.length; i++) {
    var c = list[i];
    var valor = c.valor || 0;
    html += '<tr>' +
      '<td><strong>' + esc(c.nome || '—') + '</strong>' + (c.segmento ? '<br><span style="font-size:10px;color:var(--text3);">' + esc(c.segmento) + '</span>' : '') + '</td>' +
      '<td>' + esc(c.plano || 'Business') + '</td>' +
      '<td><span style="color:var(--green);">' + esc(c.status || 'Ativo') + '</span></td>' +
      '<td>' + zeepContarPlaylists(c) + '</td>' +
      '<td>' + (c.unidades || c.filiais || 1) + '</td>' +
      '<td><span style="color:var(--cyan);font-weight:700;">R$ ' + valor.toFixed(2).replace('.', ',') + '</span></td>' +
      '<td style="white-space:nowrap;">' +
       '<button class="btn btn-ghost btn-sm" onclick="abrirDetalheCliente(\'' + c.id + '\')">Ver</button> ' +
       '<button class="btn btn-ghost btn-sm" onclick="abrirEditarCliente(\'' + c.id + '\')">Editar</button> ' +
      '<button class="btn btn-danger btn-sm" onclick="excluirCliente(\'' + c.id + '\')">Excluir</button>' +
      '</td>' +
      '</tr>';
  }
  body.innerHTML = html;
}
</script>
<script>
/* ============ PLAYLISTS BIBLIOTECA ZEEP (opção 1) ============ */
function zeepEsc(s) {
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function zeepGet() {
  try {
    if (!window.db || typeof window.db !== 'object') window.db = {};
    if (!Array.isArray(window.db.bibliotecaZeep)) {
      window.db.bibliotecaZeep = [
        { titulo: 'Lounge & Brasilidades', plano: 'business', sazonal: false, tracks: [] },
        { titulo: 'Soft Emotions', plano: 'business', sazonal: false, tracks: [] },
        { titulo: 'House & Deep', plano: 'business', sazonal: false, tracks: [] },
        { titulo: 'Happy Hour', plano: 'standard', sazonal: false, tracks: [] },
        { titulo: 'Natal', plano: 'business', sazonal: true, tracks: [] },
        { titulo: 'Festa Junina', plano: 'business', sazonal: true, tracks: [] }
      ];
    }
    return window.db.bibliotecaZeep;
  } catch (e) { return []; }
}
function zeepAchar(key) {
  var pls = zeepGet();
  for (var i = 0; i < pls.length; i++) if (pls[i]._key === key) return pls[i];
  return null;
}
function zeepRender() {
  var acc = document.getElementById('zeep-accordion');
  if (!acc) return;
  var pls = zeepGet();
  if (!pls.length) {
    acc.innerHTML = '<p style="color:var(--text3);font-size:13px;">Nenhuma playlist. Clique em + Nova Playlist.</p>';
    return;
  }
  var html = '';
  for (var i = 0; i < pls.length; i++) {
    var p = pls[i];
    if (!p._key) p._key = 'zpl-' + i + '-' + Date.now();
    var saz = p.sazonal ? ' <span style="color:var(--amber);font-size:10px;font-weight:700;">SAZONAL</span>' : '';
    var plano = p.plano || 'standard';
    var tracks = p.tracks || [];
    var sel = '<select data-zk="' + p._key + '" style="background:var(--navy);border:1px solid var(--border2);border-radius:6px;padding:3px 8px;color:var(--text);font-size:10px;text-transform:uppercase;cursor:pointer;" onchange="zeepMudarPlano(this)">' +
      '<option value="standard"' + (plano === 'standard' ? ' selected' : '') + '>Standard</option>' +
      '<option value="business"' + (plano === 'business' ? ' selected' : '') + '>Business</option>' +
      '<option value="enterprise"' + (plano === 'enterprise' ? ' selected' : '') + '>Enterprise</option></select>';
    html += '<div class="playlist-box">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px;">' +
        '<h4 style="color:var(--text);font-size:15px;margin:0;">' + zeepEsc(p.titulo) + saz + '</h4>' +
        '<div style="display:flex;align-items:center;gap:8px;"><span style="font-size:9px;color:var(--text3);text-transform:uppercase;">Plano:</span>' + sel + '</div>' +
      '</div>' +
      '<p style="font-size:12px;color:var(--text3);">' + tracks.length + ' musica(s) na playlist</p>' +
      '<div style="display:flex;gap:10px;margin-top:12px;">' +
        '<button class="btn btn-ghost btn-sm" onclick="zeepCopiarPlaylist(' + JSON.stringify(p._key) + ')">Copiar</button>' +
        '<button class="btn btn-danger btn-sm" data-zk="' + p._key + '" onclick="zeepExcluir(this)">Excluir Playlist</button>' +
      '</div></div>';
  }
  acc.innerHTML = html;
}
function zeepMudarPlano(sel) {
  var pl = zeepAchar(sel.getAttribute('data-zk'));
  if (pl) { pl.plano = sel.value; zeepRender(); }
}
function zeepNova() {
  var nome = prompt('Nome da playlist Biblioteca Zeep:');
  if (!nome || !nome.trim()) return;
  var plano = prompt('Plano de acesso (standard / business / enterprise):', 'business');
  if (!plano) return;
  zeepGet().push({ titulo: nome.trim(), plano: plano.trim().toLowerCase(), sazonal: false, tracks: [] });
  zeepRender();
}
function zeepExcluir(btn) {
  var key = btn.getAttribute('data-zk');
  if (!confirm('Excluir esta playlist?')) return;
  var pls = zeepGet();
  for (var i = 0; i < pls.length; i++) {
    if (pls[i]._key === key) { pls.splice(i, 1); break; }
  }
  zeepRender();
}
/* Boot */
(function() {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { try { zeepRender(); } catch (e) {} });
  } else {
    try { zeepRender(); } catch (e) {}
  }
})();
</script>
<script>
/* ============ UPLOAD R2 COMO SEÇÃO PRÓPRIA (opção 2) ============ */
function zeepMoveUpload() {
  var alvo = document.getElementById('zeep-upload-content');
  if (!alvo) return;
  /* Se a área de upload já está aqui, não faz nada */
  if (alvo.querySelector('.upload-area, [class*="upload"]')) return;
  /* Procura a área de upload existente (está na seção de Curadoria/Playlists) */
  var upload = document.querySelector('.upload-area, [class*="upload-area"], [class*="upload"]');
  if (!upload) {
    /* Cria uma nova área de upload se não existir nenhuma */
    var novo = document.createElement('div');
    novo.className = 'upload-area';
    novo.innerHTML = '<p style="font-size:14px;color:var(--text2);margin-bottom:10px;">Arraste arquivos MP3 para upload no Cloudflare R2</p>' +
      '<button class="btn btn-ghost" onclick="alert(\'Selecione o arquivo MP3 para enviar ao R2\')">Selecionar Arquivos</button>';
    alvo.appendChild(novo);
    return;
  }
  /* Move a área de upload para a seção Upload R2 */
  alvo.appendChild(upload);
  upload.style.margin = '0';
}
/* Boot: move o upload quando abrir a página */
(function() {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { try { zeepMoveUpload(); } catch (e) {} });
  } else {
    try { zeepMoveUpload(); } catch (e) {}
  }
})();
</script>
<script>
/* ============ CORREÇÃO BOTÃO "VER" EM CLIENTES (passo 3) ============ */
function acharClientePorNome(nome) {
  if (!nome) return null;
  var n = String(nome).trim().toLowerCase();
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  var i, c, cn;
  for (i = 0; i < fontes.length; i++) {
    c = fontes[i];
    cn = String(c.nome || c.name || '').trim().toLowerCase();
    if (cn === n) return c;
  }
  for (i = 0; i < fontes.length; i++) {
    c = fontes[i];
    cn = String(c.nome || c.name || '').trim().toLowerCase();
    if (cn && (cn.indexOf(n) > -1 || n.indexOf(cn) > -1)) return c;
  }
  return null;
}

function abrirDetalheCliente(cid) {
  /* 1) Tenta a verCliente — mas só sai se ela REALMENTE abriu o modal */
  if (typeof verCliente === 'function') {
    try {
      var ok = verCliente(cid);
      if (ok) return;   // ← só sai se o modal abriu de verdade
    } catch (e) { console.error('verCliente falhou:', e); }
  }

  /* 2) Fallback robusto: preenche o modal-ver-cliente diretamente */
  var c = null;
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  for (var i = 0; i < fontes.length; i++) {
    if (String(fontes[i].id) === String(cid)) { c = fontes[i]; break; }
  }
  if (!c) { alert('Cliente nao encontrado.'); return; }
  var modal = document.getElementById('modal-ver-cliente');
  if (modal) {
    var setTxt = function(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; };
    var nome = c.nome || c.name || '-';
    var plano = c.plano || c.plan || '-';
    var status = c.status || '-';
    var playlists = zeepContarPlaylists(c);
    var unidades = c.unidades || c.filiais || 1;
    var receita = (typeof formatMoney === 'function') ? formatMoney(receitaExibida(c)) : ('R$ ' + (c.receitaTotal || c.valor || 0));
    setTxt('vc-nome', nome);
    setTxt('vc-plano', 'Plano ' + plano);
    setTxt('vc-status', status);
    setTxt('vc-playlists', String(playlists));
    setTxt('vc-unidades', String(unidades));
    setTxt('vc-receita', receita);

    /* Lista de unidades */
    var ul = document.getElementById('vc-unidades-list');
    if (ul) {
      var us = c.units || c.unidadesArr || [];
      if (!us.length) {
        ul.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhuma unidade cadastrada.</p>';
      } else {
        var h = '';
        for (var u = 0; u < us.length; u++) {
          h += '<div style="background:var(--navy3);border:1px solid var(--border);border-radius:8px;padding:8px 12px;margin-bottom:8px;font-size:12px;color:var(--text2);">' + esc(us[u].name || us[u].nome || ('Unidade ' + (u + 1))) + ' <span style="color:var(--text3);">' + esc(us[u].cidade || '') + '</span></div>';
        }
        ul.innerHTML = h;
      }
    }

    /* Lista de playlists */
    var pl = document.getElementById('vc-playlists-list');
    if (pl) {
      var pls = c.playlistsArr || [];
      if (!pls.length) {
        pl.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhuma playlist de curadoria.</p>';
      } else {
        var h2 = '';
        for (var p = 0; p < pls.length; p++) {
          h2 += '<div style="background:var(--navy3);border:1px solid var(--border);border-radius:8px;padding:8px 12px;margin-bottom:8px;font-size:12px;color:var(--text2);">' + esc(pls[p].titulo || pls[p].name || ('Playlist ' + (p + 1))) + '</div>';
        }
        pl.innerHTML = h2;
      }
    }

    /* ★ ABRE o modal (antes faltava!) */
    openModal('modal-ver-cliente');
  }
}

function corrigirBotaoVer() {
  var botoes = document.querySelectorAll('button');
  for (var i = 0; i < botoes.length; i++) {
    var b = botoes[i];
    var txt = (b.textContent || '').trim();
    if (txt === 'Ver' && !b.getAttribute('data-zeep-ver')) {
      b.setAttribute('data-zeep-ver', '1');
      var id = b.getAttribute('data-id');
      var tr = b.closest('tr');
      if (!id && tr) id = tr.getAttribute('data-id') || tr.getAttribute('data-client-id');
      if (!id) {
        var nome = b.getAttribute('data-nome');
        if (!nome && tr) {
          var strong = tr.querySelector('td strong');
          if (strong) nome = strong.textContent.trim();
        }
        if (nome) {
          var cli = acharClientePorNome(nome);
          if (cli) id = cli.id;
        }
      }
      if (id) {
        b.onclick = (function(cid){ return function(){ abrirDetalheCliente(cid); }; })(id);
      }
    }
  }
}

/* Vigia: garante que o botão Ver funcione mesmo após re-render */
setInterval(function() {
  try { corrigirBotaoVer(); } catch (e) {}
}, 1500);
</script>
<script>
/* ============ PASSO 4 — GESTÃO DE PLAYLISTS E UNIDADES DENTRO DO CLIENTE ============ */
var _clienteAtualId = null;

/* Liga o _clienteAtualId quando o modal Ver Cliente abre — sem precisar selecionar */
(function() {
  var origAbrir = window.abrirDetalheCliente;
  window.abrirDetalheCliente = function(cid) {
    _clienteAtualId = cid;
    if (typeof origAbrir === 'function') {
      try { origAbrir(cid); } catch (e) { console.error('abrirDetalheCliente falhou:', e); }
    }
    setTimeout(function() {
      try { renderPlaylistsDoCliente(); renderUnidadesDoCliente(); renderVinhetasDoCliente(); } catch (e) {}

    }, 50);
  };
})();

/* Reaplica a correção do botão Ver ao navegar para Clientes */
(function() {
  var navOrig2 = window.nav;
  window.nav = function(id, el) {
    if (id === 'clientes') {
      if (typeof corrigirBotaoVer === 'function') setTimeout(corrigirBotaoVer, 100);
    }
    if (navOrig2) navOrig2(id, el);
  };
})();

/* ===== CLIENTE ATUAL ===== */
function getClienteAtual() {
  if (!_clienteAtualId) return null;
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  for (var i = 0; i < fontes.length; i++) {
    if (String(fontes[i].id) === String(_clienteAtualId)) return fontes[i];
  }
  return null;
}

/* ===== PLAYLISTS DO CLIENTE ===== */
function renderPlaylistsDoCliente() {
  var container = document.getElementById('cliente-playlists');
  if (!container) return;
  var cliente = getClienteAtual();
  if (!cliente) {
    container.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhum cliente selecionado.</p>';
    return;
  }

  // ★ Formato real do dashboard: cliente.playlistList (fallbacks para segurança)
  var pls = [];
  if (cliente.playlistList && Array.isArray(cliente.playlistList)) pls = cliente.playlistList;
  else if (cliente.playlists && Array.isArray(cliente.playlists)) pls = cliente.playlists;

  var html = '';
  if (!pls.length) {
    html = '<p style="color:var(--text3);font-size:12px;">Nenhuma playlist de curadoria para este cliente.</p>';
  } else {
    for (var j = 0; j < pls.length; j++) {
      var p = pls[j] || {};
      var titulo = p.titulo || p.nome || p.name || ('Playlist ' + (j + 1));
      var desc = p.descricao || p.description || '';
      var inicio = p.inicio || '';
      var fim = p.fim || '';
      var tracks = Array.isArray(p.tracks) ? p.tracks : [];
      var horario = '';
      if (inicio || fim) { horario = 'INICIO ' + inicio + ' - FIM ' + fim; }

      html += '<div style="background:var(--navy3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;">';
      html += '<div style="display:flex;justify-content:space-between;align-items:center;">';
      html += '<strong style="color:var(--text);font-size:12px;">' + esc(titulo) + '</strong>';
      if (horario) { html += '<span style="font-size:9px;color:var(--text3);">' + horario + '</span>'; }
      html += '</div>';
      if (desc) { html += '<div style="font-size:10px;color:var(--text2);margin-top:4px;">' + esc(desc) + '</div>'; }
      html += '<div style="font-size:10px;color:var(--text3);margin-top:4px;">' + tracks.length + ' musica(s)</div>';
      html += '<div style="display:flex;gap:6px;margin-top:6px;">';
      html += '<button class="btn btn-ghost btn-sm" data-idx="' + j + '" onclick="editarPlaylistCliente(this)">Editar</button>';
      html += '<button class="btn btn-danger btn-sm" data-idx="' + j + '" onclick="excluirPlaylistCliente(this)">Excluir</button>';
      html += '</div></div>';
    }
  }
  container.innerHTML = html;
}

/* ============================================================
   VINHETAS DA MARCA NO MODAL — LISTA + ÁUDIO + INTERVALO + EXCLUIR
   Versão final: usa zeepApi (injeta token + dashUrl, igual ao /companies).
   Cole no ESCOPO GLOBAL (fora de qualquer (function(){...})()).
   ============================================================ */

/* ── Endpoints (convenção do projeto: path SEM '/api', igual ao /companies) ── */
function zeepVinhetaUpdatePath(id) { return '/vinhetas/' + id; }
function zeepVinhetaUpdateMethod() { return 'PATCH'; }
function zeepVinhetaDeletePath(id) { return '/vinhetas/' + id; }
function zeepVinhetaDeleteMethod() { return 'DELETE'; }

/* ── Lista atual das vinhetas do cliente (para os controles) ── */
var _zeepVinhetasModal = [];

function renderVinhetasDoCliente() {
  var container = document.getElementById('vc-vinhetas-list');
  if (!container) return;
  var cliente = getClienteAtual();
  if (!cliente) {
    container.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhum cliente selecionado.</p>';
    return;
  }
  container.innerHTML = '<p style="color:var(--text3);font-size:12px;">Carregando vinhetas…</p>';

  /* ★ usa zeepApi (injeta token + dashUrl) — igual ao /companies que funciona */
  zeepApi('GET', '/jingles')
    .then(function (res) {
      var todas = res.jingles || res.vinhetas || res.data || [];
      _zeepVinhetasModal = todas.filter(function (v) {
        var vc = v.company_id || v.client_id || v.cliente_id || v.companyId;
        return String(vc) === String(cliente.id);
      });
      var vh = _zeepVinhetasModal;
      if (!vh.length) {
        container.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhuma vinheta da marca para este cliente.</p>';
        return;
      }
      var html = '';
      for (var i = 0; i < vh.length; i++) {
        var v = vh[i] || {};
        var nome = v.title || v.nome || v.name || ('Vinheta ' + (i + 1));
        var intervalo = parseInt(v.interval_count || v.intervalo || v.interval || 0, 10) || 0;
        var audio = v.caminho || v.url || v.file_url || v.audio_url || v.path || v.public_url || '';

        html += '<div style="background:var(--navy3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:10px;">';

        html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">';
        html += '<strong style="color:var(--text);font-size:12px;">' + esc(nome) + '</strong>';
        html += '<span style="font-size:9px;color:var(--text3);background:rgba(255,255,255,0.06);padding:2px 8px;border-radius:20px;">a cada ' + intervalo + ' músicas</span>';
        html += '</div>';

        if (audio) {
          html += '<audio controls preload="none" style="height:30px;width:100%;margin-bottom:8px;" src="' + esc(audio) + '"></audio>';
        }

        html += '<div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:6px;">';
        html += '<span style="font-size:11px;color:var(--text2);">Tocar a cada</span>';
        html += '<button type="button" onclick="zeepVinhetaIntervalo(' + i + ', -1)" style="min-width:26px;height:26px;border:1px solid var(--border);background:rgba(255,255,255,0.05);color:var(--text);border-radius:5px;cursor:pointer;">−</button>';
        html += '<input id="zeep-vh-int-' + i + '" type="number" min="0" step="1" value="' + intervalo + '" style="width:56px;height:26px;text-align:center;background:var(--navy2);border:1px solid var(--border);color:var(--text);border-radius:5px;font-size:12px;">';
        html += '<button type="button" onclick="zeepVinhetaIntervalo(' + i + ', 1)" style="min-width:26px;height:26px;border:1px solid var(--border);background:rgba(255,255,255,0.05);color:var(--text);border-radius:5px;cursor:pointer;">+</button>';
        html += '<span style="font-size:11px;color:var(--text2);">músicas</span>';
        html += '<button type="button" id="zeep-vh-sv-' + i + '" onclick="zeepVinhetaSalvar(' + i + ')" class="btn btn-ghost btn-sm" style="margin-left:auto;">Salvar</button>';
        html += '<button type="button" onclick="zeepVinhetaExcluir(' + i + ')" class="btn btn-danger btn-sm">Excluir</button>';
        html += '</div>';

        html += '</div>';
      }
      container.innerHTML = html;
    })
    .catch(function (err) {
      container.innerHTML = '<p style="color:var(--red);font-size:12px;">Erro: ' + esc(err.message) + '</p>';
    });
}

/* ── Botões − / + do intervalo ── */
function zeepVinhetaIntervalo(i, delta) {
  var inp = document.getElementById('zeep-vh-int-' + i);
  if (!inp) return;
  var atual = parseInt(inp.value, 10) || 0;
  inp.value = Math.max(0, atual + delta);
}

/* ── Salvar novo intervalo da vinheta (usa zeepApi → token + dashUrl) ── */
function zeepVinhetaSalvar(i) {
  var v = _zeepVinhetasModal[i];
  if (!v) return;
  var id = (v.id != null) ? v.id : (v.vinheta_id != null ? v.vinheta_id : v._id);
  if (id == null) { alert('Vinheta sem id — não é possível salvar.'); return; }

  var inp = document.getElementById('zeep-vh-int-' + i);
  var botao = document.getElementById('zeep-vh-sv-' + i);
  var novo = parseInt(inp ? inp.value : 0, 10) || 0;
  if (botao) botao.textContent = 'Salvando…';

  zeepApi(zeepVinhetaUpdateMethod(), zeepVinhetaUpdatePath(id), { interval_count: novo })
    .then(function () {
      renderVinhetasDoCliente();
    })
    .catch(function (e) {
      if (botao) botao.textContent = 'Salvar';
      alert('Erro ao salvar intervalo: ' + e.message);
    });
}

/* ── Excluir vinheta (usa zeepApi → token + dashUrl) ── */
function zeepVinhetaExcluir(i) {
  var v = _zeepVinhetasModal[i];
  if (!v) return;
  var nome = v.title || v.nome || v.name || 'esta vinheta';
  if (!confirm('Excluir a vinheta "' + nome + '"?')) return;
  var id = (v.id != null) ? v.id : (v.vinheta_id != null ? v.vinheta_id : v._id);
  if (id == null) { alert('Vinheta sem id — não é possível excluir.'); return; }

  zeepApi(zeepVinhetaDeleteMethod(), zeepVinhetaDeletePath(id))
    .then(function () {
      renderVinhetasDoCliente();
    })
    .catch(function (e) {
      alert('Erro ao excluir vinheta: ' + e.message);
    });
}

function criarPlaylistCliente() {
  var cliente = getClienteAtual();
  if (!cliente) { alert('Selecione um cliente primeiro.'); return; }
  var nome = prompt('Nome da playlist (ex: Jangada @ Almoco):');
  if (!nome || !nome.trim()) return;
  var desc = prompt('Descricao (ex: Lounge e Bossa Nova):', '') || '';
  var inicio = prompt('Horario inicio (HH:MM):', '') || '';
  var fim = prompt('Horario fim (HH:MM):', '') || '';
  if (!cliente.playlists) cliente.playlists = [];
  cliente.playlists.push({ titulo: nome.trim(), descricao: desc, inicio: inicio, fim: fim, tracks: [] });
  renderPlaylistsDoCliente();
}

function excluirPlaylistCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  if (!confirm('Excluir esta playlist?')) return;
  var cliente = getClienteAtual();
  if (!cliente || !cliente.playlists) return;
  cliente.playlists.splice(idx, 1);
  renderPlaylistsDoCliente();
}

function abrirNovaUnidade() {
  var cliente = getClienteAtual();
  if (!cliente) { alert('Selecione um cliente primeiro.'); return; }
  var nome = prompt('Nome da loja / unidade (ex: Jangada Campinas):');
  if (!nome || !nome.trim()) return;
  var endereco = prompt('Endereco da unidade:', '') || '';
  var login = prompt('Login (email) para o player:', '') || '';
  var senha = prompt('Senha para o player:', '') || '';
  if (!cliente.units) cliente.units = [];
  cliente.units.push({ nome: nome.trim(), endereco: endereco, login: login, senha: senha, status: 'Online' });
  renderUnidadesDoCliente();
}

function excluirUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  if (!confirm('Excluir esta unidade?')) return;
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units) return;
  cliente.units.splice(idx, 1);
  renderUnidadesDoCliente();
}
</script>
<script>
/* ============ MELHORIAS: UNIDADES + PLAYLISTS INTELIGENTES ============ */

/* ---- Recalcula valor do cliente (base + filiais extras) ---- */
function recalcularValorCliente(cliente) {
  if (!cliente) return;
  var plano = cliente.plano || cliente.plan || 'Business';
  var PLANOS = {
    Standard: { base: 279, porFilial: 99.90 },
    Business: { base: 599, porFilial: 99.90 },
    Enterprise: { base: 799, porFilial: 99.90 }
  };
  var p = PLANOS[plano] || PLANOS.Business;
  var nUnidades = (cliente.units && cliente.units.length) || 1;
  var total = p.base + (Math.max(0, nUnidades - 1) * p.porFilial);
  cliente.receitaTotal = total;
  cliente.valor = total;
  cliente.unidades = nUnidades;
  return total;
}

/* ---- Atualiza a tabela de clientes ---- */
function renderClientsAtualizado() {
  try { zeepBackfillPlaylists(); } catch (e) {}
  if (typeof renderClientTable === 'function') {
    try { renderClientTable(); } catch (e) {}
  }
}

/* ---- Sobrescreve abrirNovaUnidade para somar unidade + valor ---- */
function abrirNovaUnidade() {
  var cliente = getClienteAtual();
  if (!cliente) { alert('Selecione um cliente primeiro.'); return; }
  var nome = prompt('Nome da loja / unidade (ex: Jangada Campinas):');
  if (!nome || !nome.trim()) return;
  var endereco = prompt('Endereco da unidade:', '') || '';
  var login = prompt('Login (email) para o player:', '') || '';
  var senha = prompt('Senha para o player:', '') || '';
  if (!cliente.units) cliente.units = [];
  cliente.units.push({ nome: nome.trim(), endereco: endereco, login: login, senha: senha, status: 'Online' });
  /* Soma unidade + recalcula valor automaticamente */
  recalcularValorCliente(cliente);
  renderUnidadesDoCliente();
  renderClientsAtualizado();
  /* Atualiza o card de receita no modal */
  var rc = document.getElementById('vc-receita');
  if (rc && typeof formatMoney === 'function') rc.textContent = formatMoney(receitaExibida(cliente));
  var un = document.getElementById('vc-unidades');
  if (un) un.textContent = String(cliente.units.length);
}

/* ---- Editar unidade (endereço, senha, etc.) ---- */
function editarUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units || !cliente.units[idx]) return;
  var u = cliente.units[idx];
  var nome = prompt('Nome da loja / unidade:', u.nome || '');
  if (nome === null) return;
  var endereco = prompt('Endereco:', u.endereco || '');
  if (endereco === null) return;
  var login = prompt('Login (email) para o player:', u.login || '');
  if (login === null) return;
  var senha = prompt('Senha para o player:', u.senha || '');
  if (senha === null) return;
  u.nome = nome.trim(); u.endereco = endereco; u.login = login; u.senha = senha;
  renderUnidadesDoCliente();
}

/* ---- Excluir unidade também recalcula ---- */
function excluirUnidadeCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  if (!confirm('Excluir esta unidade?')) return;
  var cliente = getClienteAtual();
  if (!cliente || !cliente.units) return;
  cliente.units.splice(idx, 1);
  recalcularValorCliente(cliente);
  renderUnidadesDoCliente();
  renderClientsAtualizado();
  var rc = document.getElementById('vc-receita');
  if (rc && typeof formatMoney === 'function') rc.textContent = formatMoney(receitaExibida(cliente));
  var un = document.getElementById('vc-unidades');
  if (un) un.textContent = String(cliente.units.length);
}

/* ---- Conecta playlists do cliente à aba Playlists Curadoria ---- */
function sincronizarPlaylistsParaCuradoria() {
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  for (var i = 0; i < fontes.length; i++) {
    var c = fontes[i];
    if (c && c.playlists && Array.isArray(c.playlists)) {
      for (var j = 0; j < c.playlists.length; j++) {
        var p = c.playlists[j];
        if (!p._cliente) p._cliente = c.nome || c.name || '';
        if (!p._clienteId) p._clienteId = c.id;
      }
    }
  }
}

/* ---- Sobrescreve criarPlaylistCliente para sincronizar com a curadoria ---- */
function criarPlaylistCliente() {
  var cliente = getClienteAtual();
  if (!cliente) { alert('Selecione um cliente primeiro.'); return; }
  var nome = prompt('Nome da playlist (ex: Jangada @ Almoco):');
  if (!nome || !nome.trim()) return;
  var desc = prompt('Descricao (ex: Lounge e Bossa Nova):', '') || '';
  var inicio = prompt('Horario inicio (HH:MM):', '') || '';
  var fim = prompt('Horario fim (HH:MM):', '') || '';
  if (!cliente.playlists) cliente.playlists = [];
  var nova = { titulo: nome.trim(), descricao: desc, inicio: inicio, fim: fim, tracks: [], _cliente: cliente.nome || cliente.name || '', _clienteId: cliente.id };
  cliente.playlists.push(nova);
  /* Sincroniza com o db.playlists da aba Curadoria */
  try {
    if (window.db) {
      if (!Array.isArray(window.db.playlists)) window.db.playlists = [];
      window.db.playlists.push({
        id: Date.now(),
        clientId: cliente.id,
        name: nova.titulo,
        desc: nova.descricao,
        timeInicio: nova.inicio,
        timeFim: nova.fim,
        tracks: []
      });
    }
  } catch (e) {}
  renderPlaylistsDoCliente();
  if (typeof renderPlaylistAccordion === 'function') {
    try { renderPlaylistAccordion(); } catch (e) {}
  }
  alert('Playlist "' + nova.titulo + '" criada e adicionada a Playlists Curadoria!');
}
</script>
<script>
/* ============ CORREÇÃO DEFINITIVA: PLAYLISTS DO CLIENTE + SINC. COM CURADORIA ============ */

/* Busca o cliente atual (clients ou clientes) */
function getClienteAtual() {
  if (!_clienteAtualId) return null;
  var fontes = [];
  try {
    if (window.db) {
      if (Array.isArray(window.db.clients)) fontes = fontes.concat(window.db.clients);
      if (Array.isArray(window.db.clientes)) fontes = fontes.concat(window.db.clientes);
    }
  } catch (e) {}
  for (var i = 0; i < fontes.length; i++) {
    if (String(fontes[i].id) === String(_clienteAtualId)) return fontes[i];
  }
  return null;
}

/* Retorna o ARRAY de playlists do cliente (usa playlistList, nunca o número playlists) */
function getPlaylistsDoCliente(cliente) {
  if (!cliente) return [];
  // 1) Se já tem playlistList preenchido, usa ele
  if (Array.isArray(cliente.playlistList) && cliente.playlistList.length) return cliente.playlistList;

  // 2) Fallback: busca no db.playlists pelo vinculo com o cliente
  var dbp = (window.db && Array.isArray(window.db.playlists)) ? window.db.playlists : [];
  var cid = cliente.id;
  var vinculadas = dbp.filter(function(p){
    return p && (String(p.clientId) === String(cid) || String(p._clienteId) === String(cid));
  });
  if (vinculadas.length) {
    cliente.playlistList = vinculadas.map(function(p){
      return {
        titulo: p.name || p.titulo || p.nome || '',
        descricao: p.desc || p.descricao || '',
        inicio: p.timeInicio || p.inicio || '',
        fim: p.timeFim || p.fim || '',
        tracks: Array.isArray(p.tracks) ? p.tracks : [],
        id: p.id,
        _clienteId: p.clientId || p._clienteId
      };
    });
    return cliente.playlistList;
  }

  // 3) Último fallback: cliente.playlists (formato antigo)
  if (Array.isArray(cliente.playlists)) return cliente.playlists;
  if (!Array.isArray(cliente.playlistList)) cliente.playlistList = [];
  return cliente.playlistList;
}

/* Renderiza as playlists dentro do modal do cliente */
function renderPlaylistsDoCliente() {
  var container = document.getElementById('cliente-playlists');
  if (!container) return;
  var cliente = getClienteAtual();
  if (!cliente) {
    container.innerHTML = '<p style="color:var(--text3);font-size:12px;">Nenhum cliente selecionado.</p>';
    return;
  }
  var pls = getPlaylistsDoCliente(cliente);
  var html = '';
  if (!pls.length) {
    html = '<p style="color:var(--text3);font-size:12px;">Nenhuma playlist de curadoria para este cliente.</p>';
  } else {
    for (var j = 0; j < pls.length; j++) {
      var p = pls[j];
      var titulo = p.titulo || p.nome || p.name || ('Playlist ' + (j + 1));
      var desc = p.descricao || p.desc || '';
      var inicio = p.inicio || p.timeInicio || '';
      var fim = p.fim || p.timeFim || '';
      var tracks = p.tracks || [];
      var horario = '';
      if (inicio || fim) { horario = 'INICIO ' + inicio + ' - FIM ' + fim; }
      html += '<div style="background:var(--navy3);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;">';
      html += '<div style="display:flex;justify-content:space-between;align-items:center;">';
      html += '<strong style="color:var(--text);font-size:12px;">' + esc(titulo) + '</strong>';
      if (horario) { html += '<span style="font-size:9px;color:var(--text3);">' + horario + '</span>'; }
      html += '</div>';
      if (desc) { html += '<div style="font-size:10px;color:var(--text2);margin-top:4px;">' + esc(desc) + '</div>'; }
      html += '<div style="font-size:10px;color:var(--text3);margin-top:4px;">' + tracks.length + ' musica(s)</div>';
      html += '<div style="display:flex;gap:6px;margin-top:6px;">';
      html += '<button class="btn btn-ghost btn-sm" data-idx="' + j + '" onclick="editarPlaylistCliente(this)">Editar</button>';
      html += '<button class="btn btn-danger btn-sm" data-idx="' + j + '" onclick="excluirPlaylistCliente(this)">Excluir</button>';
      html += '</div></div>';
    }
  }
  container.innerHTML = html;
}

/* Cria playlist no cliente E sincroniza com a Curadoria */
function criarPlaylistCliente() {
  var cliente = getClienteAtual();
  if (!cliente) { alert('Selecione um cliente primeiro.'); return; }
  var nome = prompt('Nome da playlist (ex: Jangada @ Almoco):');
  if (!nome || !nome.trim()) return;
  var desc = prompt('Descricao (ex: Lounge e Bossa Nova):', '') || '';
  var inicio = prompt('Horario inicio (HH:MM):', '') || '';
  var fim = prompt('Horario fim (HH:MM):', '') || '';

  /* 1) Guarda no array do cliente */
  var pls = getPlaylistsDoCliente(cliente);
  var nova = { titulo: nome.trim(), descricao: desc, inicio: inicio, fim: fim, tracks: [] };
  pls.push(nova);
  /* Atualiza o contador numérico para a tabela */
  cliente.playlists = pls.length;

  /* 2) Sincroniza com db.playlists (fonte da Curadoria) */
  try {
    if (window.db) {
      if (!Array.isArray(window.db.playlists)) window.db.playlists = [];
      window.db.playlists.push({
        id: Date.now(),
        clientId: cliente.id,
        name: nova.titulo,
        desc: nova.descricao,
        timeInicio: nova.inicio,
        timeFim: nova.fim,
        tracks: []
      });
    }
  } catch (e) {}

  renderPlaylistsDoCliente();
  /* Atualiza o contador no modal e a tabela de clientes */
  var pc = document.getElementById('vc-playlists');
  if (pc) pc.textContent = String(pls.length);
  if (typeof renderClients === 'function') { try { renderClients(); } catch (e) {} }
  if (typeof renderPlaylistAccordion === 'function') { try { renderPlaylistAccordion(); } catch (e) {} }
  alert('Playlist "' + nova.titulo + '" criada e adicionada a Playlists Curadoria!');
}

/* Exclui playlist do cliente (e sincroniza com a Curadoria) */
function excluirPlaylistCliente(btn) {
  var idx = parseInt(btn.getAttribute('data-idx'), 10);
  if (!confirm('Excluir esta playlist?')) return;
  var cliente = getClienteAtual();
  if (!cliente) return;
  var pls = getPlaylistsDoCliente(cliente);
  if (!pls[idx]) return;
  var removida = pls[idx];
  pls.splice(idx, 1);
  cliente.playlists = pls.length;
  /* Remove da Curadoria */
  try {
    if (window.db && Array.isArray(window.db.playlists)) {
      for (var i = window.db.playlists.length - 1; i >= 0; i--) {
        var dp = window.db.playlists[i];
        if (String(dp.clientId) === String(cliente.id) && dp.name === removida.titulo) {
          window.db.playlists.splice(i, 1);
        }
      }
    }
  } catch (e) {}
  renderPlaylistsDoCliente();
  var pc = document.getElementById('vc-playlists');
  if (pc) pc.textContent = String(pls.length);
  if (typeof renderClients === 'function') { try { renderClients(); } catch (e) {} }
  if (typeof renderPlaylistAccordion === 'function') { try { renderPlaylistAccordion(); } catch (e) {} }
}
</script>
<script>
/* ============ CORREÇÃO DEFINITIVA: PLAYLISTS DO CLIENTE + SINC. COM CURADORIA ============ */

